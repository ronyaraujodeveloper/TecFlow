@page "/integracoes/agendador"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Agendador de Grupos — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Agendador de Grupos</h1>
        <p class="text-muted small mb-0">
            Escolha o canal para montar ofertas e agendar disparos. As telas originais continuam disponíveis.
        </p>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-2">WhatsApp</h2>
                    <p class="text-muted small">Sincronize grupos da Evolution API e agende disparos com intervalo anti-bloqueio.</p>
                    <a href="/integracoes/whatsapp/agendador" class="btn btn-success">Abrir agendador WhatsApp</a>
                </div>
            </section>
        </div>
        <div class="col-md-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-2">Telegram</h2>
                    <p class="text-muted small">Agende publicações no ChatId do canal ou grupo cadastrado no BotFather.</p>
                    <a href="/integracoes/telegram/agendador" class="btn btn-primary">Abrir agendador Telegram</a>
                </div>
            </section>
        </div>
    </div>
</div>
