@page "/dashboard"

@attribute [Authorize]

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Globalization
@using Ofertio.Business.Dto
@using Ofertio.Business.Service.Attribution
@using Ofertio.SharedUi.Components.Dashboard
@using Ofertio.SharedUi.Services.Dashboard
@inject ISessionStateService SessionState
@inject IAuthCookieService AuthCookie
@inject ILinkAnalyticsApiService AnalyticsApi
@inject IActiveStoreScopeService StoreScope
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Painel — Ofertio</PageTitle>

<div class="dashboard-page analytics-page @(_isLoading && _overview is not null ? "is-refreshing" : null)" aria-busy="@_isLoading">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Painel</h1>
            <p class="text-muted mb-0">Olá, <strong>@_displayName</strong>. Veja como seus links estão performando.</p>
            @if (_updatedAt is { } updatedAt)
            {
                <p class="small text-muted mb-0" role="status">Atualizado às @AnalyticsPeriodRules.ToLocalTime(updatedAt).ToString("HH:mm:ss")</p>
            }
        </div>
        <div class="dashboard-toolbar d-flex gap-2 flex-wrap">
            <a href="/campanhas" class="btn btn-outline-secondary">Campanhas e métricas</a>
            <button type="button" class="btn btn-outline-primary" disabled="@_isLoading" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>@(_isLoading ? "Atualizando..." : "Atualizar")
            </button>
        </div>
    </div>

    <PeriodBar Selection="_selection" Busy="_isLoading" OnChange="ChangePeriodAsync" />

    @if (StoreScope.Stores.Count > 1)
    {
        <div class="store-filter">
            <label class="small text-muted" for="panel-store">Loja</label>
            <select id="panel-store" class="form-select form-select-sm" disabled="@_isLoading" value="@(_shopId ?? string.Empty)" @onchange="ChangeStoreAsync">
                <option value="">Todas as lojas</option>
                @foreach (var store in StoreScope.Stores)
                {
                    <option value="@store.ShopId">@store.FriendlyName (@store.PlatformType)</option>
                }
            </select>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" IsOffline="@_isOffline" OnDismiss="@(EventCallback.Factory.Create(this, () => _error = null))" />
    }

    @if (_overview is null)
    {
        @if (_isLoading)
        {
            <div class="row g-3 mt-1" aria-busy="true" aria-label="Carregando indicadores">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="col-6 col-lg-3"><div class="kpi-card kpi-skeleton"></div></div>
                }
            </div>
        }
    }
    else if (!_overview.HasAnyLink)
    {
        <section class="card border-0 shadow-sm text-center p-4 p-md-5 mt-3">
            <h2 class="h5 fw-semibold mb-2">Você ainda não gerou nenhum link</h2>
            <p class="text-muted mb-3">Gere o primeiro link no Gerador de Links e divulgue. Os cliques aparecem aqui assim que alguém abrir.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a href="/gerador-links" class="btn btn-primary">Gerar meu primeiro link</a>
                <a href="/minhas-lojas" class="btn btn-outline-secondary">Conectar uma loja</a>
            </div>
        </section>
    }
    else
    {
        var summary = _overview.Summary;
        <div class="row g-3 mt-1">
            <div class="col-6 col-lg-3">
                <KpiCard Title="Cliques" Value="@summary.Clicks.ToString("N0", Pt)" Current="summary.Clicks" Previous="summary.PreviousClicks" />
            </div>
            <div class="col-6 col-lg-3">
                <KpiCard Title="Visitantes únicos" Value="@summary.UniqueClicks.ToString("N0", Pt)" Current="summary.UniqueClicks" Previous="summary.PreviousUniqueClicks" />
            </div>
            <div class="col-6 col-lg-3">
                <KpiCard Title="Links gerados" Value="@summary.LinksGenerated.ToString("N0", Pt)" Hint="no período" />
            </div>
            <div class="col-6 col-lg-3">
                <KpiCard Title="Melhor dia"
                         Value="@(summary.BestDay is { } day ? day.ToString("dd/MM", Pt) : "—")"
                         Hint="@(summary.BestDay is null ? "sem cliques" : $"{summary.BestDayClicks:N0} cliques")" />
            </div>
        </div>

        @if (summary.PreviewsFiltered > 0)
        {
            <p class="small text-muted mt-2 mb-0">
                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                @summary.PreviewsFiltered.ToString("N0", Pt) abertura(s) automática(s) (prévias de WhatsApp, Telegram e similares) não entram na contagem.
            </p>
        }

        <section class="card border-0 shadow-sm mt-3" aria-label="Cliques ao longo do tempo">
            <div class="card-body">
                <h2 class="h6 fw-semibold mb-3">Cliques ao longo do tempo, por origem</h2>
                <ClicksChart Series="_overview.Series" ChannelOrder="_overview.ChannelOrder" />
            </div>
        </section>

        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="De onde vêm os cliques">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">De onde vêm os cliques</h2>
                        <BreakdownBars Items="_overview.Channels" UseChannelColors="true" EmptyText="Nenhum clique no período." />
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="Dispositivos">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Dispositivos</h2>
                        <BreakdownBars Items="_overview.Devices" EmptyText="Nenhum clique no período." />
                    </div>
                </section>
            </div>
        </div>

        <section class="card border-0 shadow-sm mt-3" aria-label="Produtos mais clicados">
            <div class="card-body">
                <h2 class="h6 fw-semibold mb-3">Top 10 produtos mais clicados</h2>
                @if (_overview.TopProducts.Count == 0)
                {
                    <p class="text-muted small mb-0">Nenhum clique em produtos no período.</p>
                }
                else
                {
                    var top = Math.Max(1, _overview.TopProducts.Max(item => item.Clicks));
                    <ol class="top-products">
                        @foreach (var product in _overview.TopProducts)
                        {
                            <li>
                                <a class="top-product-row" href="@ProductUrl(product)" title="Ver o desempenho de @product.Name">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="" class="top-product-img" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="top-product-img top-product-img--empty" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                                    }
                                    <span class="top-product-body">
                                        <span class="top-product-name">@product.Name</span>
                                        <span class="top-product-meta">@product.Platform · @product.UniqueClicks.ToString("N0", Pt) visitante(s) único(s)</span>
                                        <span class="breakdown-track" aria-hidden="true"><span class="breakdown-fill" style="width:@((product.Clicks * 100.0 / top).ToString("0.##", CultureInfo.InvariantCulture))%"></span></span>
                                    </span>
                                    <span class="top-product-clicks">@product.Clicks.ToString("N0", Pt)<span class="text-muted small"> cliques</span></span>
                                    <i class="bi bi-chevron-right text-muted" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ol>
                    <p class="small text-muted mt-2 mb-0">Clique em um produto para ver em que dia ou semana ele mais rendeu.</p>
                }
            </div>
        </section>

        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="Funil da página pública">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Sua página pública</h2>
                        @{ var funnel = _overview.Funnel; }
                        @if (!funnel.HasData)
                        {
                            <p class="text-muted small mb-0">Quando alguém abrir a sua página pública, as visitas, os links convertidos e as entradas em grupo aparecem aqui.</p>
                        }
                        else
                        {
                            <ol class="funnel">
                                <li>
                                    <span class="funnel-label">Visitas à página</span>
                                    <strong>@funnel.Views.ToString("N0", Pt)</strong>
                                    <span class="funnel-note">@funnel.UniqueViews.ToString("N0", Pt) visitante(s) único(s)</span>
                                </li>
                                <li>
                                    <span class="funnel-label">Converteram um link</span>
                                    <strong>@funnel.Conversions.ToString("N0", Pt)</strong>
                                    <span class="funnel-note">@Rate(funnel.Conversions, funnel.Views) das visitas</span>
                                </li>
                                <li>
                                    <span class="funnel-label">Foram entrar em um grupo</span>
                                    <strong>@funnel.JoinClicks.ToString("N0", Pt)</strong>
                                    <span class="funnel-note">@Rate(funnel.JoinClicks, funnel.Conversions) de quem converteu</span>
                                </li>
                            </ol>
                            @if (funnel.JoinByChannel.Count > 0)
                            {
                                <p class="small text-muted mt-3 mb-2">Entradas em grupo por canal</p>
                                <BreakdownBars Items="funnel.JoinByChannel" UseChannelColors="true" />
                            }
                            <p class="small text-muted mt-2 mb-0">Contagens sem identificar a pessoa. Quem só olhou a página fica entre as visitas e as conversões.</p>
                        }
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="Cliques por região">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">De onde vêm os cliques (região estimada)</h2>
                        @if (!_overview.HasRegionData)
                        {
                            <p class="text-muted small mb-0">A região aparece para os cliques novos, assim que a base de localização estiver ativa no servidor.</p>
                        }
                        else
                        {
                            <p class="small text-muted mb-1">Estados</p>
                            <BreakdownBars Items="_overview.States" EmptyText="Sem dados de estado." />
                            <p class="small text-muted mt-3 mb-1">Cidades</p>
                            <BreakdownBars Items="_overview.Cities" EmptyText="Sem dados de cidade." />
                            <p class="small text-muted mt-2 mb-0">Estimada pelo endereço de rede: o estado costuma estar certo, a cidade é aproximada (VPN e redes de operadora podem aparecer em outra cidade).</p>
                        }
                    </div>
                </section>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="Grupos">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Grupos que mais trazem cliques</h2>
                        @if (_overview.Groups.Count == 0)
                        {
                            <p class="text-muted small mb-0">Os grupos aparecem aqui quando você dispara pelo Ofertio (WhatsApp ou Telegram).</p>
                        }
                        else
                        {
                            <ul class="group-list">
                                @foreach (var group in _overview.Groups)
                                {
                                    <li>
                                        <span class="clicks-dot @ChannelStyle.Css(group.Channel)" aria-hidden="true"></span>
                                        <span class="group-name" title="@group.Name">@group.Name</span>
                                        <span class="text-muted small">@LinkChannelRules.LabelFor(group.Channel)</span>
                                        <strong class="ms-auto">@group.Clicks.ToString("N0", Pt)</strong>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </section>
            </div>
            <div class="col-12 col-lg-6">
                <section class="card border-0 shadow-sm h-100" aria-label="Melhores horários">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Melhores dias e horários</h2>
                        <HeatmapGrid Matrix="_overview.Heatmap" />
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");

    private string? _displayName;
    private PeriodSelection _selection = PeriodPresets.Resolve(PeriodPresets.Last30, PeriodPresets.TodayLocal());
    private AnalyticsOverviewDto? _overview;
    private DateTime? _updatedAt;
    private string? _error;
    private bool _isOffline;
    private bool _isLoading;
    private string? _shopId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/entrar", replace: true);
            return;
        }

        AuthCookie.SyncSessionFromPrincipal(user);
        _displayName = user.Identity?.Name ?? SessionState.DisplayName ?? "Utilizador";

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        _selection = PeriodPresets.FromQuery(
            query.TryGetValue("from", out var from) ? from.ToString() : null,
            query.TryGetValue("to", out var to) ? to.ToString() : null,
            query.TryGetValue("grain", out var grain) ? grain.ToString() : null,
            PeriodPresets.TodayLocal());

        // A loja é um filtro do próprio painel (padrão: todas), não a "loja ativa" global, que não aparece nesta tela
        // e escondia os cliques das outras lojas depois da primeira carga.
        _shopId = query.TryGetValue("shop", out var shop) && !string.IsNullOrWhiteSpace(shop) ? shop.ToString() : null;
        await StoreScope.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    public void Dispose()
    {
    }

    private async Task ChangePeriodAsync(PeriodSelection selection)
    {
        _selection = selection;
        await LoadAsync();
    }

    private async Task ChangeStoreAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        _shopId = string.IsNullOrWhiteSpace(value) ? null : value;
        await LoadAsync();
    }

    /// <summary>
    /// Busca os números de novo (mesmo período e mesma loja). Nunca apaga o que já está na tela: se a busca falhar,
    /// os dados anteriores continuam visíveis e um aviso explica o que houve.
    /// </summary>
    private async Task LoadAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await AnalyticsApi.GetOverviewAsync(_selection.From, _selection.To, _selection.Grain, _shopId);
            if (result.Success && result.Data is not null)
            {
                _overview = result.Data;
                _updatedAt = DateTime.UtcNow;
            }
            else
            {
                _error = (result.ErrorMessage ?? "Não foi possível carregar o painel.")
                    + (_overview is not null ? " Os números exibidos são da última atualização." : string.Empty);
                _isOffline = result.IsOffline;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = "Não foi possível atualizar o painel agora. Tente novamente em instantes."
                + (_overview is not null ? " Os números exibidos são da última atualização." : string.Empty);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Rate(int part, int whole) =>
        whole <= 0 ? "—" : (part * 100.0 / whole).ToString("0.#", Pt) + "%";

    private string ProductUrl(AnalyticsProductDto product) =>
        $"/painel/produto/{product.LinkGroupId}?{PeriodPresets.ToQuery(_selection)}"
        + (string.IsNullOrWhiteSpace(_shopId) ? string.Empty : "&shop=" + Uri.EscapeDataString(_shopId));
}
