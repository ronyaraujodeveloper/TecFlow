@using TecFlow.Business.Dto
@using TecFlow.Business.Service.LinkStrategies
@using TecFlow.SharedUi.Helpers
@inject IJSRuntime Js

@if (Response is { HasConvertedLink: true } response)
{
    <section id="link-generator-result"
             class="link-generator-result card border-0 shadow-sm mt-4"
             role="region"
             aria-live="polite"
             aria-label="Link de comissão gerado">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <span class="link-generator-result-badge">Link pronto</span>
                    <h2 class="h5 fw-bold mb-1 mt-2">Seus links de comissão</h2>
                    @if (!string.IsNullOrWhiteSpace(response.PlatformDetected))
                    {
                        <p class="text-muted small mb-0">
                            Plataforma: <strong>@response.PlatformDetected</strong>
                        </p>
                    }
                </div>
                <span class="link-generator-result-check" aria-hidden="true">✓</span>
            </div>

            <article class="product-preview-card mb-4" aria-label="Prévia do produto">
                @if (!string.IsNullOrWhiteSpace(response.ProductImageUrl))
                {
                    <img src="@response.ProductImageUrl"
                         alt=""
                         class="product-preview-thumb"
                         loading="lazy" />
                }
                <div class="product-preview-body">
                    @if (!string.IsNullOrWhiteSpace(response.PlatformDetected))
                    {
                        <span class="marketplace-platform-badge mb-2">@response.PlatformDetected</span>
                    }
                    <h3 class="product-preview-title mb-1">
                        @(string.IsNullOrWhiteSpace(response.ProductName) ? "Produto" : response.ProductName)
                    </h3>
                    <p class="product-preview-price mb-0">@ProductMetadataHtmlParser.FormatBrl(response.ProductPrice)</p>
                </div>
            </article>

            @if (response.Accounts.Count(account => account.IsActive && account.StoreId > 0) > 1)
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="selected-commission-account">Conta selecionada:</label>
                    <select id="selected-commission-account"
                            class="form-select"
                            value="@_selectedStoreId"
                            @onchange="HandleAccountChanged">
                        @foreach (var account in response.Accounts.Where(item => item.IsActive))
                        {
                            <option value="@account.StoreId">@account.StoreName</option>
                        }
                    </select>
                </div>
            }

            <div class="row g-3">
                @if (!string.IsNullOrWhiteSpace(response.AffiliateUrl))
                {
                    <div class="col-12">
                        <article class="link-choice-card">
                            <header class="link-choice-card-header">
                                <span class="link-choice-icon" aria-hidden="true">🔗</span>
                                <div>
                                    <h3 class="link-choice-title">Link de Afiliado Direto (@(string.IsNullOrWhiteSpace(response.PlatformDetected) ? "Marketplace" : response.PlatformDetected))</h3>
                                    <p class="link-choice-hint mb-0">URL longa com tags da loja vinculada.</p>
                                </div>
                            </header>
                            <output id="generated-affiliate-url"
                                    class="link-generator-result-url font-monospace"
                                    for="product-url">
                                @response.AffiliateUrl
                            </output>
                            <button type="button"
                                    class="btn btn-touch w-100 mt-3 @(_copiedAffiliate ? "btn-success" : "btn-outline-primary")"
                                    disabled="@_isCopying"
                                    @onclick="() => CopyLinkAsync(response.AffiliateUrl, CopyTarget.Affiliate)">
                                @(_copiedAffiliate ? "Copiado!" : "Copiar link longo")
                            </button>
                        </article>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(response.ShortenedShopeeUrl))
                {
                    <div class="col-12 col-lg-6">
                        <article class="link-choice-card link-choice-card--shopee">
                            <header class="link-choice-card-header">
                                <span class="link-choice-icon" aria-hidden="true">🛒</span>
                                <div>
                                    <h3 class="link-choice-title">Link Encurtado Shopee (br.shp.ee)</h3>
                                    <p class="link-choice-hint mb-0">Encurtador oficial da Shopee.</p>
                                </div>
                            </header>
                            <output id="generated-shopee-short-url"
                                    class="link-generator-result-url font-monospace"
                                    for="product-url">
                                @response.ShortenedShopeeUrl
                            </output>
                            <button type="button"
                                    class="btn btn-touch w-100 mt-3 @(_copiedShopeeShort ? "btn-success" : "btn-outline-orange")"
                                    disabled="@_isCopying"
                                    @onclick="() => CopyLinkAsync(response.ShortenedShopeeUrl, CopyTarget.ShopeeShort)">
                                @(_copiedShopeeShort ? "Copiado!" : "Copiar br.shp.ee")
                            </button>
                        </article>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(response.ResolvedShortUrl))
                {
                    <div class="col-12 col-lg-6">
                        <article class="link-choice-card link-choice-card--tecflow">
                            <header class="link-choice-card-header">
                                <span class="link-choice-icon" aria-hidden="true">📡</span>
                                <div>
                                    <h3 class="link-choice-title">Link Encurtado com Rastreio TecFlow</h3>
                                    <p class="link-choice-hint mb-0">Contagem de cliques no painel TecFlow.</p>
                                </div>
                            </header>
                            <output id="generated-short-url"
                                    class="link-generator-result-url font-monospace"
                                    for="product-url">
                                @response.ResolvedShortUrl
                            </output>
                            <button type="button"
                                    class="btn btn-touch w-100 mt-3 @(_copiedShort ? "btn-success" : "btn-outline-primary")"
                                    disabled="@_isCopying"
                                    @onclick="() => CopyLinkAsync(response.ResolvedShortUrl, CopyTarget.Short)">
                                @(_copiedShort ? "Copiado!" : "Copiar rastreio TecFlow")
                            </button>
                        </article>
                    </div>
                }
            </div>

            <div class="link-generator-result-actions d-grid d-sm-flex gap-2 mt-4">
                <button type="button"
                        class="btn btn-primary btn-lg btn-touch flex-fill link-generator-share-btn"
                        disabled="@_isSharing"
                        @onclick="ShareLinkAsync">
                    <svg class="link-generator-share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z" />
                    </svg>
                    <span>@(_isSharing ? "Abrindo..." : "Compartilhar")</span>
                </button>
            </div>

            <div class="link-generator-fallback-share mt-3" aria-label="Compartilhar em aplicativos">
                <p class="small text-muted mb-2">Ou envie direto o link com rastreio:</p>
                <div class="d-grid d-sm-flex gap-2">
                    <a class="btn btn-success btn-touch flex-fill"
                       href="@AffiliateShareLinkBuilder.BuildWhatsAppUri(ShareUrl(response), response.PlatformDetected)"
                       target="_blank"
                       rel="noopener noreferrer">
                        WhatsApp
                    </a>
                    <a class="btn btn-info text-white btn-touch flex-fill"
                       href="@AffiliateShareLinkBuilder.BuildTelegramUri(ShareUrl(response), response.PlatformDetected)"
                       target="_blank"
                       rel="noopener noreferrer">
                        Telegram
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <p class="small mt-3 mb-0 @(_actionIsError ? "text-danger" : "text-success")" role="status">
                    @_actionMessage
                </p>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public GerarLinkAfiliadoResponseDto? Response { get; set; }

    private bool _copiedAffiliate;
    private bool _copiedShort;
    private bool _copiedShopeeShort;
    private bool _isCopying;
    private bool _isSharing;
    private string? _actionMessage;
    private bool _actionIsError;
    private string? _lastResponseKey;
    private int _selectedStoreId;

    protected override void OnParametersSet()
    {
        var key = $"{Response?.LinkGroupId}|{Response?.OriginalUrl}|{Response?.AffiliateUrl}|{Response?.ShortenedUrl}|{Response?.ShortenedShopeeUrl}|{Response?.Accounts.Count}";
        if (!string.Equals(key, _lastResponseKey, StringComparison.Ordinal))
        {
            _lastResponseKey = key;
            ResetActionState();
            _selectedStoreId = Response?.SelectedStoreId
                ?? Response?.Accounts.FirstOrDefault(account => account.IsActive)?.StoreId
                ?? 0;
            if (_selectedStoreId > 0)
            {
                Response?.ApplySelectedAccount(_selectedStoreId);
            }
        }
    }

    private void HandleAccountChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var storeId) || Response is null)
        {
            return;
        }

        _selectedStoreId = storeId;
        Response.ApplySelectedAccount(storeId);
        ResetActionState();
    }

    private static string ShareUrl(GerarLinkAfiliadoResponseDto response) =>
        FirstNonEmpty(response.ResolvedShortUrl, response.ShortenedShopeeUrl, response.AffiliateUrl);

    private async Task CopyLinkAsync(string? url, CopyTarget target)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        _isCopying = true;
        _actionMessage = null;

        try
        {
            var copied = await CopyViaClipboardInteropAsync(url);
            if (copied)
            {
                _copiedAffiliate = target == CopyTarget.Affiliate;
                _copiedShort = target == CopyTarget.Short;
                _copiedShopeeShort = target == CopyTarget.ShopeeShort;
                _actionIsError = false;
                _actionMessage = target switch
                {
                    CopyTarget.Affiliate => "Link de afiliado copiado para a área de transferência.",
                    CopyTarget.ShopeeShort => "Link encurtado da Shopee copiado para a área de transferência.",
                    _ => "Link com rastreio TecFlow copiado para a área de transferência."
                };
                StateHasChanged();
                await Task.Delay(2200);
                _copiedAffiliate = false;
                _copiedShort = false;
                _copiedShopeeShort = false;
                _actionMessage = null;
            }
            else
            {
                _actionIsError = true;
                _actionMessage = "Não foi possível copiar o link. Tente selecionar e copiar manualmente.";
            }
        }
        catch (Exception)
        {
            _actionIsError = true;
            _actionMessage = "Erro ao copiar o link.";
        }
        finally
        {
            _isCopying = false;
            StateHasChanged();
        }
    }

    private async Task<bool> CopyViaClipboardInteropAsync(string url)
    {
        try
        {
            return await Js.InvokeAsync<bool>("tecFlowClipboard.copyText", url);
        }
        catch (JSException)
        {
            return await Js.InvokeAsync<bool>("tecFlowAppInterop.copyToClipboard", url);
        }
    }

    private async Task ShareLinkAsync()
    {
        if (Response is null)
        {
            return;
        }

        var url = ShareUrl(Response);
        if (string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        _isSharing = true;
        _actionMessage = null;

        try
        {
            var shareText = AffiliateShareLinkBuilder.BuildShareIntro(Response.PlatformDetected);
            var result = await Js.InvokeAsync<ShareLinkResult>(
                "tecFlowAppInterop.shareLink",
                "TecFlow — Link de Comissão",
                shareText,
                url);

            if (result.Cancelled)
            {
                return;
            }

            if (result.Success)
            {
                _actionIsError = false;
                _actionMessage = result.Method switch
                {
                    "native" => "Compartilhamento iniciado no dispositivo.",
                    "whatsapp" => "Abrimos o WhatsApp com a mensagem pronta para envio.",
                    "telegram" => "Abrimos o Telegram com o link pronto para envio.",
                    _ => "Compartilhamento iniciado no dispositivo."
                };
                return;
            }

            if (string.Equals(result.Method, "fallback", StringComparison.OrdinalIgnoreCase))
            {
                _actionIsError = false;
                _actionMessage = "Use WhatsApp ou Telegram abaixo para enviar o link.";
                return;
            }

            _actionIsError = true;
            _actionMessage = "Não foi possível abrir o compartilhamento.";
        }
        catch (Exception)
        {
            _actionIsError = true;
            _actionMessage = "Erro ao compartilhar o link. Use WhatsApp ou Telegram abaixo.";
        }
        finally
        {
            _isSharing = false;
            StateHasChanged();
        }
    }

    private void ResetActionState()
    {
        _copiedAffiliate = false;
        _copiedShort = false;
        _copiedShopeeShort = false;
        _isCopying = false;
        _isSharing = false;
        _actionMessage = null;
        _actionIsError = false;
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private enum CopyTarget
    {
        Affiliate,
        Short,
        ShopeeShort
    }

    private sealed class ShareLinkResult
    {
        public bool Success { get; set; }
        public bool Cancelled { get; set; }
        public string? Method { get; set; }
    }
}
