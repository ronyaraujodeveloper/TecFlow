@page "/meu-plano/pagamento/{PlanCode}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject IMyAccountApiService AccountApi
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Pagamento — Meu plano — Ofertio</PageTitle>

<div class="dashboard-page my-plan-checkout-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Pagamento</h1>
            <p class="text-muted small mb-0">Escolha como quer pagar e informe o cartão.</p>
        </div>
        <div class="dashboard-toolbar">
            <a href="/meu-plano" class="btn btn-outline-secondary btn-touch">
                <i class="bi bi-arrow-left me-1"></i>Trocar de plano
            </a>
        </div>
    </div>

    <CheckoutSteps Current="@(_step == CheckoutStep.Card ? 3 : 2)" />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnDismiss="@(EventCallback.Factory.Create(this, () => _error = null))" />
    }

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3 py-4">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Carregando...</span></div>
                <p class="mb-0 text-muted">Carregando o plano...</p>
            </div>
        </div>
    }
    else if (_plan is null)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Plano não encontrado ou indisponível.</span>
            <a href="/meu-plano" class="btn btn-sm btn-outline-secondary ms-md-auto"><i class="bi bi-arrow-left me-1"></i>Ver planos</a>
        </div>
    }
    else if (_overview!.IsMaster)
    {
        <div class="alert alert-secondary d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <span>A conta Master não assina planos.</span>
        </div>
    }
    else if (_overview.MissingFields.Count > 0)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>Antes de pagar, complete: <strong>@string.Join(", ", _overview.MissingFields)</strong>.</span>
            <a href="/meus-dados?plano=@Uri.EscapeDataString(_plan.Code)" class="btn btn-sm btn-warning ms-md-auto">
                <i class="bi bi-pencil-square me-1"></i>Completar meus dados
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                @if (_overview.IsPaymentSimulated)
                {
                    <div class="alert alert-info small py-2 d-flex align-items-center gap-2" role="status">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Modo de teste: nenhuma cobrança é feita. Use um número de cartão válido, como 4111 1111 1111 1111.</span>
                    </div>
                }

                @if (_step == CheckoutStep.Cycle)
                {
                    <section class="card border-0 shadow-sm" aria-label="Ciclo de pagamento">
                        <div class="card-body p-3 p-md-4">
                            <h2 class="h5 fw-semibold mb-3">Como você quer pagar?</h2>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="cycle-option card h-100 @(_cycle == SaasMetricsRules.CycleMonthly ? "cycle-option--selected" : null) @(_plan.MonthlyPrice <= 0 ? "opacity-50" : null)">
                                        <span class="card-body d-flex gap-3">
                                            <input type="radio" class="form-check-input mt-1" name="cycle" disabled="@(_plan.MonthlyPrice <= 0)"
                                                   checked="@(_cycle == SaasMetricsRules.CycleMonthly)" @onchange="() => _cycle = SaasMetricsRules.CycleMonthly" />
                                            <span>
                                                <span class="d-block fw-semibold">Mensal</span>
                                                <span class="d-block fs-5 fw-bold">@_plan.MonthlyPrice.ToString("C", PtBr)<span class="small text-muted fw-normal">/mês</span></span>
                                                <span class="d-block small text-muted">Renova todo mês; cancele quando quiser.</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="cycle-option card h-100 @(_cycle == SaasMetricsRules.CycleAnnual ? "cycle-option--selected" : null) @(_plan.AnnualPrice <= 0 ? "opacity-50" : null)">
                                        <span class="card-body d-flex gap-3">
                                            <input type="radio" class="form-check-input mt-1" name="cycle" disabled="@(_plan.AnnualPrice <= 0)"
                                                   checked="@(_cycle == SaasMetricsRules.CycleAnnual)" @onchange="() => _cycle = SaasMetricsRules.CycleAnnual" />
                                            <span>
                                                <span class="d-block fw-semibold">
                                                    Anual
                                                    @if (Savings > 0)
                                                    {
                                                        <span class="badge text-bg-success ms-1">economize @Savings%</span>
                                                    }
                                                </span>
                                                <span class="d-block fs-5 fw-bold">@_plan.AnnualPrice.ToString("C", PtBr)<span class="small text-muted fw-normal">/ano</span></span>
                                                <span class="d-block small text-muted">Equivale a @PlanPricingRules.MonthlyEquivalent(_plan.AnnualPrice).ToString("C", PtBr)/mês.</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-primary btn-touch" disabled="@(Amount <= 0)" @onclick="() => _step = CheckoutStep.Card">
                                    <i class="bi bi-arrow-right me-1"></i>Continuar para o cartão
                                </button>
                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <section class="card border-0 shadow-sm" aria-label="Dados do cartão">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                                <h2 class="h5 fw-semibold mb-0">Cartão de crédito</h2>
                                <span class="badge text-bg-light border"><i class="bi bi-credit-card me-1"></i>@CreditCardRules.DetectBrand(_card.Number)</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold" for="card-number">Número do cartão</label>
                                    <input id="card-number" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="23"
                                           placeholder="0000 0000 0000 0000" value="@_card.Number" @oninput="e => _card.Number = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold" for="card-holder">Nome impresso no cartão</label>
                                    <input id="card-holder" class="form-control text-uppercase" autocomplete="cc-name" maxlength="60" @bind="_card.HolderName" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="card-expiry">Validade</label>
                                    <input id="card-expiry" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="7" placeholder="MM/AA" @bind="_card.Expiry" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold" for="card-cvv">Código de segurança</label>
                                    <input id="card-cvv" type="password" class="form-control" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="CVV" @bind="_card.Cvv" />
                                </div>
                            </div>
                            <p class="small text-muted mt-3 mb-0">
                                <i class="bi bi-lock me-1" aria-hidden="true"></i>O Ofertio não grava os dados do cartão: guardamos só a bandeira e os 4 últimos dígitos.
                            </p>
                            <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary btn-touch" disabled="@_isPaying" @onclick="() => _step = CheckoutStep.Cycle">
                                    <i class="bi bi-arrow-left me-1"></i>Voltar
                                </button>
                                <button type="button" class="btn btn-success btn-touch" disabled="@_isPaying" @onclick="PayAsync">
                                    @if (_isPaying)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                        <span>Processando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-lock-fill me-1"></i>
                                        <span>Assinar por @Amount.ToString("C", PtBr)</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </section>
                }
            </div>

            <aside class="col-12 col-lg-4" aria-label="Resumo do pedido">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 fw-semibold mb-3">Resumo</h2>
                        <dl class="row small mb-0">
                            <dt class="col-5 text-muted fw-normal">Plano</dt>
                            <dd class="col-7 text-end fw-semibold">@_plan.Name</dd>
                            <dt class="col-5 text-muted fw-normal">Pagamento</dt>
                            <dd class="col-7 text-end">@_cycle</dd>
                            <dt class="col-5 text-muted fw-normal">Total</dt>
                            <dd class="col-7 text-end fs-5 fw-bold">@Amount.ToString("C", PtBr)</dd>
                        </dl>
                        <hr />
                        <ul class="list-unstyled small mb-0">
                            @foreach (var line in PlanPricingRules.LimitLines(_plan))
                            {
                                <li><i class="bi bi-check2 text-success me-1" aria-hidden="true"></i>@line</li>
                            }
                        </ul>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");

    private enum CheckoutStep
    {
        Cycle,
        Card
    }

    private MyPlanResponseDto? _overview;
    private SaasPlanDto? _plan;
    private CheckoutStep _step = CheckoutStep.Cycle;
    private string _cycle = SaasMetricsRules.CycleMonthly;
    private CreditCardDto _card = new();
    private bool _isLoading = true;
    private bool _isPaying;
    private string? _error;

    [Parameter]
    public string PlanCode { get; set; } = string.Empty;

    private decimal Amount => _plan is null ? 0 : PlanPricingRules.Price(_plan, _cycle);

    private int Savings => _plan is null ? 0 : PlanPricingRules.AnnualSavingsPercent(_plan.MonthlyPrice, _plan.AnnualPrice);

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var result = await AccountApi.GetPlanAsync();
            if (!result.Success || result.Data is not { Status: true } overview)
            {
                _error = result.ErrorMessage ?? result.Data?.Descricao ?? "Não foi possível carregar o plano.";
                return;
            }

            _overview = overview;
            _plan = overview.Plans.FirstOrDefault(plan => string.Equals(plan.Code, PlanCode, StringComparison.OrdinalIgnoreCase));
            if (_plan is not null && _plan.MonthlyPrice <= 0 && _plan.AnnualPrice > 0)
            {
                _cycle = SaasMetricsRules.CycleAnnual;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PayAsync()
    {
        if (_plan is null)
        {
            return;
        }

        var errors = CreditCardRules.Validate(_card, DateTime.UtcNow);
        if (errors.Count > 0)
        {
            _error = string.Join(" ", errors);
            return;
        }

        _isPaying = true;
        _error = null;
        try
        {
            var result = await AccountApi.CheckoutAsync(new PlanCheckoutDto
            {
                PlanCode = _plan.Code,
                BillingCycle = _cycle,
                Card = _card
            });
            _card = new CreditCardDto();

            if (result.Success && result.Data is { Data: { } checkout })
            {
                Navigation.NavigateTo($"/meu-plano/pagamento/concluido/{checkout.Id}");
                return;
            }

            _error = result.ErrorMessage ?? result.Data?.Descricao ?? "Não foi possível concluir o pagamento.";
            ToastService.ShowError(_error);
            if (result.Data?.MissingFields.Count > 0 && _overview is not null)
            {
                _overview.MissingFields = result.Data.MissingFields;
            }
        }
        finally
        {
            _isPaying = false;
        }
    }
}
