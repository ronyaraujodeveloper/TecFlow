@* Seletor de visão do operador master: Painel Master x Visão Cliente (re-assina o cookie sem perder a sessão). *@
@if (_user is not null && MasterAccess.IsMaster(_user) && !MasterAccess.IsImpersonating(_user))
{
    var masterView = MasterAccess.IsMasterView(_user);
    <div class="btn-group btn-group-sm d-none d-md-inline-flex" role="group" aria-label="Alternar visão">
        <a href="/master/visao/master" data-enhance-nav="false"
           class="btn @(masterView ? "btn-dark" : "btn-outline-dark")">
            <i class="bi bi-shield-lock" aria-hidden="true"></i> Painel Master
        </a>
        <a href="/master/visao/cliente" data-enhance-nav="false"
           class="btn @(masterView ? "btn-outline-dark" : "btn-dark")">
            <i class="bi bi-person" aria-hidden="true"></i> Visão Cliente
        </a>
    </div>
    <span class="badge text-bg-warning d-none d-xl-inline">@MasterRoles.Label(MasterAccess.Role(_user))</span>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            _user = (await AuthenticationStateTask).User;
        }
    }
}
