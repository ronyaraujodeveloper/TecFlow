@using System.Globalization
@using Ofertio.Business.Dto
@using Ofertio.Core.Enums
@using Ofertio.SharedUi.Helpers
@using Ofertio.SharedUi.Services.Integrations
@inject IIntegracaoLojaApiService IntegracaoApi
@inject IJSRuntime JS
@inject ILogger<ConnectStoreModal> Logger

@if (Visible)
{
    <div class="modal fade show d-block marketplace-connect-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="connect-store-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <div>
                        <h2 class="modal-title h5 fw-bold" id="connect-store-title">@ModalTitle</h2>
                        <p class="text-muted">
                            @(IsEditMode
                                ? "Altere o apelido ou o ID de afiliado/parceiro. A plataforma da loja não pode ser trocada."
                                : "Informe o apelido e o ID de afiliado/parceiro. Sem App Key / App Secret.")
                        </p>
                    </div>
                    <button type="button" class="btn-close" aria-label="Fechar" disabled="@_linking" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_extractSuccess))
                    {
                        <div class="alert alert-success py-1 px-2 small mb-2" role="status">@_extractSuccess</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(DisplayError))
                    {
                        <div class="alert alert-danger py-1 px-2 small mb-2" role="alert">@DisplayError</div>
                    }

                    <div class="marketplace-connect-section">
                        <label class="form-label fw-semibold">Plataforma</label>
                        <div class="marketplace-platform-picker">
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.CasasBahia)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.CasasBahia)">
                                <span class="marketplace-platform-badge badge-casasbahia">Casas Bahia</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.Kabum)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.Kabum)">
                                <span class="marketplace-platform-badge badge-kabum">Kabum!</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.MagazineLuiza)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.MagazineLuiza)">
                                <span class="marketplace-platform-badge badge-magalu">Magazine Luiza</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.Amazon)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.Amazon)">
                                <span class="marketplace-platform-badge badge-amazon">Amazon</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.MercadoLivre)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.MercadoLivre)">
                                <span class="marketplace-platform-badge badge-mercadolivre">Mercado Livre</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.TikTokShop)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.TikTokShop)">
                                <span class="marketplace-platform-badge badge-tiktok">TikTok Shop</span>
                            </button>
                            <button type="button"
                                    class="btn marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.Shopee)"
                                    disabled="@PlatformPickerDisabled"
                                    @onclick="() => SelectPlatform(MarketplaceType.Shopee)">
                                <span class="marketplace-platform-badge badge-shopee">Shopee</span>
                            </button>
                        </div>
                    </div>

                    <div class="marketplace-connect-section">
                        <label class="form-label fw-semibold" for="friendly-name">Apelido / nome amigável</label>
                        <input id="friendly-name"
                               type="text"
                               class="form-control"
                               maxlength="256"
                               placeholder="Ex.: Loja principal SP"
                               @bind="_friendlyName"
                               @bind:event="oninput"
                               disabled="@_linking" />
                    </div>

                    <div class="marketplace-connect-section marketplace-connect-section--last">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label class="form-label fw-semibold mb-0" for="tracking-id">@TrackingIdLabel</label>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 marketplace-id-help-toggle"
                                    disabled="@_linking"
                                    aria-expanded="@_showIdHelp"
                                    aria-controls="tracking-id-help"
                                    @onclick="ToggleIdHelp">
                                <i class="bi bi-question-circle" aria-hidden="true"></i>
                                @(_platform == MarketplaceType.MercadoLivre ? "Como copiar o link?" : "Como pegar meu ID?")
                            </button>
                        </div>
                        <input id="tracking-id"
                               type="text"
                               class="form-control mt-1"
                               maxlength="4096"
                               placeholder="@TrackingIdPlaceholder"
                               inputmode="@TrackingIdInputMode"
                               autocomplete="off"
                               value="@_trackingId"
                               @oninput="OnTrackingIdInput"
                               @onchange="OnTrackingIdInput"
                               disabled="@_linking" />
                        <p class="affiliate-id-paste-hint small mb-0 mt-2">
                            @if (_platform == MarketplaceType.MercadoLivre)
                            {
                                <text>Cole o link completo que o Mercado Livre copia ao compartilhar um produto.</text>
                            }
                            else
                            {
                                <text>💡 Dica: Você pode colar aqui o ID direto OU qualquer link de teste do seu painel de afiliado. O Ofertio identificará e extrairá o seu código de rastreamento automaticamente!</text>
                            }
                        </p>
                        @if (_showIdHelp)
                        {
                            @if (_platform == MarketplaceType.MercadoLivre)
                            {
                                <HowToGetStoreIdModal Visible="true" OnClose="CloseIdHelp" />
                            }
                            else
                            {
                                <div id="tracking-id-help"
                                     class="affiliate-id-help mt-2"
                                     role="region"
                                     aria-label="Como obter o ID de afiliado">
                                    <p class="small mb-2">@AffiliateTrackingIdHelp.GetFormatHint(_platform)</p>
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@AffiliateTrackingIdHelp.GetOfficialPanelUrl(_platform)"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Ir para o painel oficial
                                        <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            }
                        }
                    </div>

                    @if (!IsEditMode && !_platform.IsUniversalAffiliatePlatform())
                    {
                        <details class="marketplace-manual-link small" open>
                            <summary class="text-muted mb-2">Vinculação manual (homologação / callback simulado)</summary>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label" for="auth-code">Authorization code</label>
                                    <input id="auth-code"
                                           name="authorizationCode"
                                           type="text"
                                           class="form-control form-control-sm"
                                           placeholder="code_teste"
                                           autocomplete="off"
                                           @bind="_authorizationCode"
                                           @bind:event="oninput"
                                           disabled="@_linking" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="shop-id">Shop ID</label>
                                    <input id="shop-id"
                                           name="shopId"
                                           type="text"
                                           class="form-control form-control-sm"
                                           inputmode="numeric"
                                           placeholder="123456"
                                           autocomplete="off"
                                           @bind="_shopId"
                                           @bind:event="oninput"
                                           disabled="@_linking" />
                                </div>
                            </div>
                        </details>
                    }
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_linking" @onclick="Close">
                        <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancelar
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(!CanSaveAccount)"
                            @onclick="VincularManualmenteDirect">
                        @if (IsEditMode)
                        {
                            <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>
                        }
                        @SaveButtonLabel
                    </button>
                    @if (SupportsOAuth && !IsEditMode)
                    {
                        <button type="button" class="btn btn-outline-primary" disabled="@_linking" @onclick="StartOAuthAsync">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@(_linking ? "Redirecionando..." : "Conectar via OAuth")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(MarketplaceType Platform, string FriendlyName)> OnStartOAuth { get; set; }
    [Parameter] public EventCallback OnLojaVinculada { get; set; }

    [Parameter] public MarketplaceType? PreferredPlatform { get; set; }

    /// <summary>Quando informado, o modal abre em modo edição e salva via UPDATE da loja existente.</summary>
    [Parameter] public MarketplaceAccountDto? EditingStore { get; set; }

    private MarketplaceType _platform = MarketplaceType.Shopee;
    private bool _wasVisible;

    private MarketplaceType SelectedPlatform
    {
        get => _platform;
        set => _platform = value;
    }
    private string _platformLabel => _platform.GetDisplayName();
    private string TrackingIdLabel => _platform switch
    {
        MarketplaceType.MercadoLivre => "Link de afiliado do Mercado Livre",
        MarketplaceType.Amazon => "Tag de Associado / Tracking ID",
        MarketplaceType.MagazineLuiza => "ID de Afiliado / Nome da Loja Parceira",
        MarketplaceType.Kabum => "ID de Afiliado / Tracking ID",
        MarketplaceType.CasasBahia => "ID de Afiliado / ID de Parceiro",
        _ => "ID do Afiliado (Affiliate ID / Tracking ID)"
    };
    private string TrackingIdPlaceholder => _platform switch
    {
        MarketplaceType.MercadoLivre => "Cole aqui o seu link de afiliado do Mercado Livre (ex: https://mercadolivre.com/...)",
        MarketplaceType.Amazon => "sualoja-20",
        MarketplaceType.MagazineLuiza => "magazinematos",
        MarketplaceType.Kabum => "tecflow_kabum",
        MarketplaceType.CasasBahia => "tecflow_cb",
        _ => "6512300000"
    };
    private string TrackingIdInputMode => _platform is MarketplaceType.Amazon
        or MarketplaceType.MagazineLuiza
        or MarketplaceType.Kabum
        or MarketplaceType.CasasBahia
        or MarketplaceType.MercadoLivre
        ? "text"
        : "numeric";
    private string _friendlyName = string.Empty;
    private string _trackingId = string.Empty;
    private string _authorizationCode = string.Empty;
    private string _shopId = string.Empty;
    private string? _formError;
    private string? _extractSuccess;
    private bool _linking;
    private bool _showIdHelp;
    private bool _expanding;
    private int _expandGeneration;
    private bool _trackingInvalid;

    private string? DisplayError => ErrorMessage ?? _formError;
    /// <summary>A API oficial do Mercado Livre é conectada pelo Master (Integrações Globais); lojas Universal Link só guardam o Tracking ID.</summary>
    private bool SupportsOAuth => !_platform.IsUniversalAffiliatePlatform();
    private bool CanSaveAccount => !_linking && !_expanding && !_trackingInvalid;
    private bool IsEditMode => EditingStore is not null;
    private bool PlatformPickerDisabled => _linking || IsEditMode;
    private string ModalTitle => IsEditMode ? "Editar loja" : "Conectar nova loja";
    private string SaveButtonLabel => _linking
        ? "Salvando..."
        : IsEditMode
            ? "Salvar alterações"
            : _platform.IsUniversalAffiliatePlatform() ? $"Salvar conta {_platformLabel}" : "Vincular manualmente";

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            ResetForm();
            _wasVisible = false;
            return;
        }

        if (!_wasVisible)
        {
            if (EditingStore is { } store)
            {
                LoadEditingStore(store);
            }
            else if (PreferredPlatform is { } preferred)
            {
                SelectPlatform(preferred);
            }
        }

        _wasVisible = true;
    }

    private void LoadEditingStore(MarketplaceAccountDto store)
    {
        ResetForm();
        _platform = store.PlatformType;
        _friendlyName = string.IsNullOrWhiteSpace(store.FriendlyName) ? store.ShopName : store.FriendlyName;
        var trackingId = string.IsNullOrWhiteSpace(store.AffiliateTrackingId) ? store.TrackingId : store.AffiliateTrackingId;
        if (AffiliateTrackingIdSanitizer.LooksLikeUrl(trackingId))
        {
            ApplyTrackingId(trackingId);
            return;
        }

        _trackingId = trackingId ?? string.Empty;
    }

    private void SelectPlatform(MarketplaceType platform)
    {
        SelectedPlatform = platform;
        _formError = null;
        _extractSuccess = null;
        if (!string.IsNullOrWhiteSpace(_trackingId))
        {
            ApplyTrackingId(_trackingId);
        }
    }

    private void ToggleIdHelp() => _showIdHelp = !_showIdHelp;

    private void CloseIdHelp() => _showIdHelp = false;

    private async Task OnTrackingIdInput(ChangeEventArgs e)
    {
        var raw = AffiliateTrackingIdSanitizer.IsolateHttpUrl(e.Value?.ToString());
        if (AffiliateTrackingIdSanitizer.IsBooleanLiteral(raw))
        {
            raw = string.Empty;
        }

        var generation = ++_expandGeneration;
        var fromShortener = false;

        var absolute = AffiliateTrackingIdSanitizer.EnsureAbsoluteHttpUrl(raw);
        DetectSelectedPlatform(absolute);
        if (AffiliateTrackingIdSanitizer.IsShortenerUrl(absolute)
            || AffiliateTrackingIdSanitizer.NeedsMercadoLivreUrlExpansion(absolute))
        {
            fromShortener = true;
            _expanding = true;
            _formError = null;
            _extractSuccess = null;
            try
            {
                var expanded = await IntegracaoApi.ExpandAffiliateUrlAsync(absolute, SelectedPlatform.ToString());
                if (generation != _expandGeneration)
                {
                    return;
                }

                DetectSelectedPlatform(expanded.ExpandedUrl);
                raw = AffiliateTrackingIdSanitizer.PreferExtractedCredential(
                    expanded.ExtractedId,
                    expanded.ExpandedUrl,
                    absolute);
            }
            finally
            {
                if (generation == _expandGeneration)
                {
                    _expanding = false;
                }
            }
        }

        if (generation != _expandGeneration)
        {
            return;
        }

        ApplyTrackingId(raw, fromShortener);
    }

    private void ApplyTrackingId(string input, bool fromShortener = false)
    {
        if (SelectedPlatform is MarketplaceType.MercadoLivre)
        {
            ApplyMercadoLivrePaste(input);
            return;
        }

        var extracted = ExtractAffiliateIdFromUrl(input, SelectedPlatform.ToString());
        if (AffiliateTrackingIdSanitizer.IsBooleanLiteral(extracted))
        {
            extracted = string.Empty;
        }
        _trackingId = extracted;
        _trackingInvalid = !AffiliateTrackingIdSanitizer.TryNormalize(SelectedPlatform, extracted, out _);
        if (_trackingInvalid)
        {
            _extractSuccess = null;
            _formError = TrackingFailureMessage();
            return;
        }

        if (!string.IsNullOrWhiteSpace(extracted)
            && !AffiliateTrackingIdSanitizer.LooksLikeUrl(extracted)
            && (fromShortener
                || AffiliateTrackingIdSanitizer.LooksLikeUrl(input)
                || AffiliateTrackingIdSanitizer.TryExtractPlatformAffiliateId(_platform, input, out _)))
        {
            _extractSuccess = AffiliateTrackingIdSanitizer.ExtractedCredentialMessage(extracted, _platform);
            _formError = null;
            return;
        }

        _extractSuccess = null;
        if (string.Equals(_formError, AffiliateTrackingIdSanitizer.InvalidMessage, StringComparison.Ordinal)
            || string.Equals(_formError, AffiliateTrackingIdSanitizer.MercadoLivrePasteMessage, StringComparison.Ordinal))
        {
            _formError = null;
        }
    }

    private void ApplyMercadoLivrePaste(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            _trackingId = string.Empty;
            _trackingInvalid = false;
            _extractSuccess = null;
            _formError = null;
            return;
        }

        if (ConnectStoreManualLinkForm.TryExtractMercadoLivreTrackingId(input, out var mercadoLivreId))
        {
            _trackingId = mercadoLivreId;
            _trackingInvalid = false;
            _extractSuccess = AffiliateTrackingIdSanitizer.ExtractedCredentialMessage(mercadoLivreId, _platform);
            _formError = null;
            return;
        }

        _trackingId = AffiliateTrackingIdSanitizer.PreservePastedValue(input);
        _trackingInvalid = true;
        _extractSuccess = null;
        _formError = AffiliateTrackingIdSanitizer.IsMercadoLivreProductPage(input)
            ? AffiliateTrackingIdSanitizer.MercadoLivreProductPageMessage
            : AffiliateTrackingIdSanitizer.MercadoLivrePasteMessage;
    }

    private string TrackingFailureMessage() =>
        _platform is MarketplaceType.MercadoLivre
            ? AffiliateTrackingIdSanitizer.IsMercadoLivreProductPage(_trackingId)
                ? AffiliateTrackingIdSanitizer.MercadoLivreProductPageMessage
                : AffiliateTrackingIdSanitizer.MercadoLivrePasteMessage
            : AffiliateTrackingIdSanitizer.InvalidMessage;

    private void DetectSelectedPlatform(string? input)
    {
        if (IsEditMode)
        {
            return;
        }

        if (MarketplaceUrlDetector.Detect(input)?.IntegrationType is { } fromDetector)
        {
            SelectedPlatform = fromDetector;
            return;
        }

        if (AffiliateTrackingIdSanitizer.TryDetectPlatformFromUrl(input, out var detected))
        {
            SelectedPlatform = detected;
        }
    }

    private static string ExtractAffiliateIdFromUrl(string input, string platform) =>
        AffiliateTrackingIdSanitizer.ExtractAffiliateIdFromUrl(input, platform);

    private string GetPlatformOptionClass(MarketplaceType platform)
    {
        var brand = platform switch
        {
            MarketplaceType.Shopee => "btn-shopee",
            MarketplaceType.TikTokShop => "btn-tiktok",
            MarketplaceType.MercadoLivre => "btn-mercadolivre",
            MarketplaceType.Amazon => "btn-amazon",
            MarketplaceType.MagazineLuiza => "btn-magalu",
            MarketplaceType.Kabum => "btn-kabum",
            MarketplaceType.CasasBahia => "btn-casasbahia",
            _ => string.Empty
        };

        return _platform == platform
            ? $"{brand} marketplace-platform-option--selected"
            : brand;
    }

    private async Task Close()
    {
        if (_linking)
        {
            return;
        }

        await InvokeAsync(StateHasChanged);
        await OnClose.InvokeAsync();
    }

    private async Task StartOAuthAsync()
    {
        var friendlyName = await ReadInputAsync("friendly-name", _friendlyName);
        if (string.IsNullOrWhiteSpace(friendlyName))
        {
            _formError = "Informe um apelido para identificar a loja.";
            return;
        }

        await OnStartOAuth.InvokeAsync((_platform, friendlyName.Trim()));
    }

    private async Task VincularManualmenteDirect()
    {
        try
        {
            var friendlyName = (await ReadInputAsync("friendly-name", _friendlyName)).Trim();
            var rawTracking = (await ReadInputAsync("tracking-id", _trackingId)).Trim();
            DetectSelectedPlatform(rawTracking);
            var trackingId = rawTracking;

            if (AffiliateTrackingIdSanitizer.IsShortenerUrl(AffiliateTrackingIdSanitizer.EnsureAbsoluteHttpUrl(rawTracking)))
            {
                var expanded = await IntegracaoApi.ExpandAffiliateUrlAsync(
                    AffiliateTrackingIdSanitizer.EnsureAbsoluteHttpUrl(rawTracking),
                    SelectedPlatform.ToString());
                DetectSelectedPlatform(expanded.ExpandedUrl);
                trackingId = AffiliateTrackingIdSanitizer.PreferExtractedCredential(
                    expanded.ExtractedId,
                    expanded.ExpandedUrl,
                    rawTracking);
            }

            if (SelectedPlatform is MarketplaceType.MercadoLivre)
            {
                if (!ConnectStoreManualLinkForm.TryExtractMercadoLivreTrackingId(trackingId, out var mercadoLivreId))
                {
                    _trackingId = AffiliateTrackingIdSanitizer.PreservePastedValue(rawTracking);
                    _trackingInvalid = true;
                    _formError = TrackingFailureMessage();
                    return;
                }

                trackingId = mercadoLivreId;
            }
            else
            {
                trackingId = ExtractAffiliateIdFromUrl(trackingId, SelectedPlatform.ToString());
            }

            if (!AffiliateTrackingIdSanitizer.TryNormalize(_platform, trackingId, out var normalized)
                || AffiliateTrackingIdSanitizer.LooksLikeUrl(normalized))
            {
                _trackingId = SelectedPlatform is MarketplaceType.MercadoLivre
                    ? AffiliateTrackingIdSanitizer.PreservePastedValue(rawTracking)
                    : trackingId;
                _trackingInvalid = true;
                _formError = TrackingFailureMessage();
                return;
            }

            trackingId = normalized;
            var authorizationCode = (await ReadInputAsync("auth-code", _authorizationCode)).Trim();
            var shopIdInput = (await ReadInputAsync("shop-id", _shopId)).Trim();

            if (string.IsNullOrWhiteSpace(friendlyName))
            {
                _formError = "Informe um apelido para identificar a loja.";
                return;
            }

            if (EditingStore is { } editingStore)
            {
                await SaveEditAsync(editingStore, friendlyName, trackingId);
                return;
            }

            if (_platform.IsUniversalAffiliatePlatform())
            {
                _friendlyName = friendlyName;
                _trackingId = trackingId;
                _formError = null;
                _linking = true;

                var linkedResponse = await IntegracaoApi.LinkAsync(new IntegracaoLojaDto
                {
                    PlatformType = _platform,
                    FriendlyName = _friendlyName,
                    TrackingId = string.IsNullOrWhiteSpace(_trackingId) ? null : _trackingId
                });

                if (linkedResponse.Status)
                {
                    await InvokeAsync(StateHasChanged);
                    await OnLojaVinculada.InvokeAsync();
                    return;
                }

                _formError = string.IsNullOrWhiteSpace(linkedResponse.Descricao)
                    ? "Não foi possível vincular a loja."
                    : linkedResponse.Descricao;
                return;
            }

            if (string.IsNullOrWhiteSpace(authorizationCode))
            {
                authorizationCode = ConnectStoreManualLinkForm.HomologDefaultAuthorizationCode;
            }

            if (!long.TryParse(
                    shopIdInput,
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out var shopIdParsed)
                || shopIdParsed <= 0)
            {
                shopIdParsed = ConnectStoreManualLinkForm.HomologDefaultShopId;
            }

            _friendlyName = friendlyName;
            _authorizationCode = authorizationCode;
            _shopId = shopIdParsed.ToString(CultureInfo.InvariantCulture);
            _formError = null;
            _linking = true;

            Console.WriteLine("[DEBUG BLAZOR] Clique detectado, enviando requisição...");

            var response = await IntegracaoApi.LinkAsync(new IntegracaoLojaDto
            {
                PlatformType = _platform,
                FriendlyName = _friendlyName,
                AuthorizationCode = _authorizationCode,
                ShopId = _shopId,
                TrackingId = string.IsNullOrWhiteSpace(trackingId) ? null : trackingId
            });

            if (response.Status)
            {
                await InvokeAsync(StateHasChanged);
                await OnLojaVinculada.InvokeAsync();
                return;
            }

            _formError = string.IsNullOrWhiteSpace(response.Descricao)
                ? "Não foi possível vincular a loja."
                : response.Descricao;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
            Logger.LogError(ex, "Erro ao vincular loja manualmente.");
            _formError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Erro inesperado ao vincular loja."
                : ex.Message;
        }
        finally
        {
            _linking = false;
        }
    }

    private async Task SaveEditAsync(MarketplaceAccountDto store, string friendlyName, string trackingId)
    {
        _friendlyName = friendlyName;
        _trackingId = trackingId;
        _formError = null;
        _linking = true;

        var response = await IntegracaoApi.UpdateAsync(store.Id, new IntegracaoLojaDto
        {
            PlatformType = store.PlatformType,
            ShopId = store.ShopId,
            FriendlyName = friendlyName,
            TrackingId = string.IsNullOrWhiteSpace(trackingId) ? null : trackingId
        });

        if (response.Status)
        {
            await InvokeAsync(StateHasChanged);
            await OnLojaVinculada.InvokeAsync();
            return;
        }

        _formError = string.IsNullOrWhiteSpace(response.Descricao)
            ? "Não foi possível atualizar a loja."
            : response.Descricao;
    }

    private async Task<string> ReadInputAsync(string elementId, string boundValue)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("ofertioAppInterop.getInputValueById", elementId);
            if (!string.IsNullOrWhiteSpace(raw))
            {
                return raw;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
        }

        return boundValue ?? string.Empty;
    }

    private void ResetForm()
    {
        _platform = MarketplaceType.Shopee;
        _friendlyName = string.Empty;
        _trackingId = string.Empty;
        _authorizationCode = string.Empty;
        _shopId = string.Empty;
        _formError = null;
        _extractSuccess = null;
        _linking = false;
        _showIdHelp = false;
        _expanding = false;
        _trackingInvalid = false;
    }
}
