@page "/busca"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ofertio.Business.Dto
@using Ofertio.Business.Service.LinkStrategies
@using Ofertio.Business.Service.Radar
@using Ofertio.Core.Enums
@using Ofertio.Database.Filter
@using Ofertio.SharedUi.Helpers
@using Ofertio.SharedUi.Services.Integrations
@using Ofertio.SharedUi.Services.LinkGenerator
@using Ofertio.SharedUi.Services.Radar
@inject IOfficialCatalogSearchApiService SearchApi
@inject IIntegracaoLojaApiService IntegracaoApi
@inject IAffiliateLinkApiService AffiliateLinkApi
@inject IOfferRadarApiService RadarApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<BuscaGlobal> Logger
@implements IAsyncDisposable

<PageTitle>Buscar Ofertas — Ofertio</PageTitle>

<div class="dashboard-page">
    <div class="text-center mb-4">
        <h1 class="h3 fw-bold mb-1">Buscar Ofertas</h1>
        <p class="text-muted small mb-1">Consulta paralela nas APIs oficiais do Mercado Livre, Shopee e Amazon.</p>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _showRules = true">
            ⓘ Como funciona a busca e as regras
        </button>
    </div>

    <form class="col-12 col-lg-8 mx-auto mb-4 px-0" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
        <div class="input-group input-group-lg">
            <input class="form-control" placeholder="Ex: notebook 16GB, fone bluetooth..." @bind="_keyword" />
            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Buscar
            </button>
        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
            <div class="form-check">
                <input id="busca-ml" class="form-check-input" type="checkbox" @bind="_ml" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-ml">Mercado Livre</label>
            </div>
            <div class="form-check">
                <input id="busca-shopee" class="form-check-input" type="checkbox" @bind="_shopee" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-shopee">Shopee</label>
            </div>
            <div class="form-check">
                <input id="busca-amazon" class="form-check-input" type="checkbox" @bind="_amazon" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-amazon">Amazon</label>
            </div>
            <div class="form-check">
                <input id="busca-cupom" class="form-check-input" type="checkbox" @bind="_couponOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-cupom">Apenas com cupom</label>
            </div>
            <div class="form-check">
                <input id="busca-frete" class="form-check-input" type="checkbox" @bind="_freeShippingOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-frete">Somente frete grátis</label>
            </div>
            <div class="form-check">
                <input id="busca-oficial" class="form-check-input" type="checkbox" @bind="_officialOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-oficial">Somente loja oficial</label>
            </div>
            <div class="form-check">
                <input id="busca-confiavel" class="form-check-input" type="checkbox" @bind="_trustedOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-confiavel">Somente vendedores confiáveis</label>
            </div>
            <div class="form-check">
                <input id="busca-mais-vendidos" class="form-check-input" type="checkbox" @bind="_bestSellersOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-mais-vendidos">Somente mais vendidos</label>
            </div>
            <div class="form-check">
                <input id="busca-principais" class="form-check-input" type="checkbox" @bind="_mainProductsOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-principais" title="Esconde capa, película, carregador, cabo, fonte e outros acessórios quando o termo buscado é o produto">
                    Apenas produtos principais (ocultar acessórios)
                </label>
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-min">Preço mín.</label>
                <input id="busca-min" class="form-control" type="number" step="0.01" min="0" @bind="_minPrice" @bind:after="ApplyScreenFilters" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-max">Preço máx.</label>
                <input id="busca-max" class="form-control" type="number" step="0.01" min="0" @bind="_maxPrice" @bind:after="ApplyScreenFilters" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-ordem">Ordenar por</label>
                <select id="busca-ordem" class="form-select" @bind="_sortBy" @bind:after="ApplyScreenFilters">
                    <option value="@OfficialCatalogSearchRules.SortRelevance">Relevância (Padrão Mercado Livre)</option>
                    <option value="@OfficialCatalogSearchRules.SortBestOpportunity">Melhor vantagem + segurança</option>
                    <option value="@OfficialCatalogSearchRules.SortBestSellers">Mais vendidos</option>
                    <option value="@OfficialCatalogSearchRules.SortHighestCommission">Maior comissão</option>
                    <option value="@OfficialCatalogSearchRules.SortBestRating">Melhor avaliação</option>
                    <option value="@OfficialCatalogSearchRules.SortLowestPrice">Menor preço</option>
                    <option value="@OfficialCatalogSearchRules.SortBiggestDiscount">Maior desconto</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-categoria">Categoria (Mercado Livre)</label>
                <select id="busca-categoria" class="form-select" @bind="_mlCategory" @bind:after="ApplyScreenFilters" disabled="@(_allCategories.Count == 0)">
                    <option value="">@(_allCategories.Count == 0 ? "Busque para sugerir" : "Todas")</option>
                    @foreach (var category in _allCategories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
        </div>
        @if (_allCategories.Count > 0)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-1 mt-3" aria-label="Categorias sugeridas pelo Mercado Livre">
                <span class="small text-muted me-1">Buscar só em:</span>
                <button type="button"
                        class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(_mlCategory) ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(string.IsNullOrEmpty(_mlCategory) ? "true" : "false")"
                        disabled="@_busy"
                        @onclick="() => SearchInCategoryAsync(null)">
                    <i class="bi bi-grid me-1" aria-hidden="true"></i>Todas
                </button>
                @foreach (var category in OfficialCatalogSearchRules.VisibleCategoryChips(_allCategories, _mlCategory, _showAllCategories))
                {
                    var categoryId = category.Id;
                    var selected = IsSelectedCategory(categoryId);
                    <button type="button"
                            class="btn btn-sm rounded-pill @(selected ? "btn-primary" : "btn-outline-secondary")"
                            aria-pressed="@(selected ? "true" : "false")"
                            disabled="@_busy"
                            title="Buscar de novo no Mercado Livre só em @category.Name"
                            @onclick="() => SearchInCategoryAsync(categoryId)">
                        <i class="bi @(selected ? "bi-check2-circle" : "bi-tag") me-1" aria-hidden="true"></i>@category.Name
                    </button>
                }
                @if (_allCategories.Count > OfficialCatalogSearchRules.MaxVisibleCategoryChips)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary ms-1"
                            aria-expanded="@(_showAllCategories ? "true" : "false")"
                            @onclick="() => _showAllCategories = !_showAllCategories">
                        @if (_showAllCategories)
                        {
                            <i class="bi bi-funnel-fill" aria-hidden="true"></i><span> Menos categorias</span>
                        }
                        else
                        {
                            <i class="bi bi-funnel" aria-hidden="true"></i><span> Outras categorias (@(_allCategories.Count - OfficialCatalogSearchRules.MaxVisibleCategoryChips))</span>
                        }
                    </button>
                }
            </div>
        }
    </form>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small">@_info</div>
    }
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="alert alert-info py-2 small">@_notice</div>
    }

    @if (_searched && _channels.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3" aria-label="Status da busca por loja">
            @foreach (var channel in _channels.Where(item => item.Included))
            {
                <span class="badge rounded-pill @ChannelBadgeClass(channel.State) px-3 py-2 d-inline-flex align-items-center gap-2">
                    <span>
                        @ChannelGlyph(channel.State)
                        <span class="fw-semibold">@channel.Label:</span>
                        @ChannelDisplayMessage(channel)
                    </span>
                    @if (NeedsMercadoLivreConnect(channel))
                    {
                        <button type="button"
                                class="btn btn-sm btn-dark"
                                @onclick="GoToMercadoLivreConnect">
                            Conectar
                        </button>
                    }
                </span>
            }
        </div>
    }

    @if (_searched && _relevanceOrder.Count > 0 && _items.Count != _relevanceOrder.Count)
    {
        <p class="small text-muted text-center mb-3">
            Mostrando @_items.Count de @_relevanceOrder.Count resultados carregados. Os filtros alterados valem só para o que está na tela;
            clique em <strong>Buscar</strong> para consultar as lojas de novo com eles.
        </p>
    }
    @if (_searched && !_busy && _relevanceOrder.Count > 0 && _items.Count == 0)
    {
        <div class="alert alert-light border">Nenhum resultado carregado atende aos filtros. Ajuste os filtros ou clique em Buscar para consultar as lojas de novo.</div>
    }
    else if (_searched && !_busy && _relevanceOrder.Count == 0)
    {
        <div class="alert alert-light border">Nenhum produto retornado. Confira as lojas marcadas e as chaves da Amazon/Shopee.</div>
    }
    @if (_items is { Count: > 0 })
    {
        var metrics = OfficialCatalogSearchRules.BuildMetrics(_items);
        <section class="card border-0 shadow-sm mb-4" aria-label="Métricas da busca">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">Métricas das @metrics.Count ofertas na tela</h2>
                <div class="row g-3 small">
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Faixa de preço</div>
                        <div class="fw-semibold">@ProductMetadataHtmlParser.FormatBrl(metrics.MinPrice) – @ProductMetadataHtmlParser.FormatBrl(metrics.MaxPrice)</div>
                        <div class="text-muted">Mediana @ProductMetadataHtmlParser.FormatBrl(metrics.MedianPrice)</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Segurança</div>
                        <div class="fw-semibold">@metrics.TrustedSellerPercent% vendedores confiáveis</div>
                        <div class="text-muted">@metrics.OfficialStorePercent% loja oficial · @metrics.FreeShippingPercent% frete grátis</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Avaliação média</div>
                        <div class="fw-semibold">@(metrics.AverageRating is { } averageRating ? $"⭐ {averageRating:0.0}" : "não informada")</div>
                        <div class="text-muted">@(metrics.TotalSoldKnown is { } totalSold ? $"{totalSold:N0} vendidos (informados)" : "vendas não informadas pela API")</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Maior comissão estimada</div>
                        <div class="fw-semibold">@(metrics.TopCommission is { } top ? ProductMetadataHtmlParser.FormatBrl(top.EstimatedCommission) : "—")</div>
                        <div class="text-muted">
                            @if (metrics.TopCommission is null)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => _showRules = true">Ver tabela de comissão</button>
                            }
                            else
                            {
                                @Shorten(metrics.TopCommission.ProductName)
                                <span>· @($"{metrics.TopCommission.CommissionPercent:0.##}")% (@CommissionLabel(metrics.TopCommission))</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="row g-2 mt-2 small">
                    @if (metrics.BestOpportunity is { } best)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-success me-1">🏅 Melhor oportunidade</span>@Shorten(best.ProductName) · @ProductMetadataHtmlParser.FormatBrl(best.Price)</div>
                    }
                    @if (metrics.BestSeller is { } seller)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-warning me-1">🏆 Mais vendido</span>@Shorten(seller.ProductName) · @ProductMetadataHtmlParser.FormatBrl(seller.Price)</div>
                    }
                    @if (metrics.Cheapest is { } cheapest)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-info me-1">💲 Menor preço</span>@Shorten(cheapest.ProductName) · @ProductMetadataHtmlParser.FormatBrl(cheapest.Price)</div>
                    }
                </div>
            </div>
        </section>
        <div class="row g-3">
            @foreach (var item in _items)
            {
                var platform = item.PlatformType ?? MarketplaceType.Shopee;
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex gap-3 mb-3">
                                <div class="product-image-preview-box product-image-preview-box--sm">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        var photoCount = GalleryOf(item).Count;
                                        <button type="button"
                                                class="offer-gallery-trigger"
                                                title="Ampliar imagem"
                                                aria-label="Ampliar imagem de @(item.ProductName ?? "produto")"
                                                @onclick="() => OpenGallery(item)">
                                            <img src="@item.ImageUrl" alt="" class="product-image-preview-img" loading="lazy" />
                                            @if (photoCount > 1)
                                            {
                                                <span class="offer-gallery-count" aria-hidden="true">@photoCount</span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="product-image-preview-placeholder">Sem imagem</span>
                                    }
                                </div>
                                <div>
                                    <span class="badge rounded-pill @PlatformBadgeHelper.GetPlatformBadgeClass(item.Platform)"
                                          style="background-color: @PlatformBadgeHelper.GetPlatformColor(item.Platform); color: @(platform == MarketplaceType.MercadoLivre ? "#000000" : "#FFFFFF");">
                                        @PlatformBadgeHelper.GetPlatformLabel(item.Platform, item.PlatformType)
                                    </span>
                                    <span class="badge text-bg-light">@item.Source</span>
                                    @if (!string.IsNullOrWhiteSpace(item.CouponCode))
                                    {
                                        <span class="badge text-bg-warning">@item.CouponCode</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button type="button"
                                        class="badge score-badge cursor-pointer @OpportunityBadgeClass(item.OpportunityScore)"
                                        aria-label="Oportunidade @item.OpportunityScore: ver como é calculada"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-trigger="hover focus"
                                        title="@OpportunityHelp"
                                        @onclick="() => OpenScoreHelpAsync(ScoreHelpKind.Opportunity, item)">
                                    Oportunidade @item.OpportunityScore<i class="bi bi-question-circle ms-1" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="badge score-badge cursor-pointer text-bg-light border"
                                        aria-label="Vantagem @item.AdvantageScore: ver como é calculada"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-trigger="hover focus"
                                        title="@AdvantageHelp"
                                        @onclick="() => OpenScoreHelpAsync(ScoreHelpKind.Advantage, item)">
                                    Vantagem @item.AdvantageScore<i class="bi bi-question-circle ms-1 text-muted" aria-hidden="true"></i>
                                </button>
                                <button type="button"
                                        class="badge score-badge cursor-pointer text-bg-light border"
                                        aria-label="Segurança @OfficialCatalogSearchRules.SafetyLabel(item.SafetyScore): ver como é calculada"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-trigger="hover focus"
                                        title="@SafetyHelp"
                                        @onclick="() => OpenScoreHelpAsync(ScoreHelpKind.Safety, item)">
                                    Segurança @OfficialCatalogSearchRules.SafetyLabel(item.SafetyScore)<i class="bi bi-question-circle ms-1 text-muted" aria-hidden="true"></i>
                                </button>
                            </div>
                            <h2 class="h6">@(item.ProductName ?? "Produto")</h2>
                            <p class="fw-semibold mb-1">
                                @ProductMetadataHtmlParser.FormatBrl(item.Price)
                                @if (item.OriginalPrice > item.Price)
                                {
                                    <small class="text-muted text-decoration-line-through ms-1">@ProductMetadataHtmlParser.FormatBrl(item.OriginalPrice)</small>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Shipping))
                            {
                                <p class="small text-muted mb-1">@item.Shipping</p>
                            }
                            <ul class="list-unstyled small mb-2">
                                <li title="@item.CommissionSource">
                                    💰
                                    @if (item.CommissionPercent is { } commissionPercent)
                                    {
                                        <span>
                                            Comissão estimada: <strong>@($"{commissionPercent:0.##}")%</strong> (@CommissionLabel(item))
                                            @if (item.EstimatedCommission is > 0)
                                            {
                                                <span>· @ProductMetadataHtmlParser.FormatBrl(item.EstimatedCommission)</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@MissingCommissionMessage(item)</span>
                                    }
                                </li>
                                <li>
                                    ⭐
                                    @if (item.RatingAverage is { } rating)
                                    {
                                        <span>@($"{rating:0.0}") @(item.RatingCount is > 0 ? $"({item.RatingCount:N0} avaliações)" : string.Empty)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sem avaliações informadas</span>
                                    }
                                </li>
                                <li>
                                    🛒
                                    @if (item.SoldQuantity is { } sold)
                                    {
                                        <span>@($"{sold:N0}") vendidos</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Vendas não informadas pela API</span>
                                    }
                                    @if (item.BestSellerPosition is { } position)
                                    {
                                        <span class="badge text-bg-warning ms-1">🏆 @(position)º mais vendido da categoria</span>
                                    }
                                </li>
                                @if (!string.IsNullOrWhiteSpace(item.SellerName) || item.SellerReputationLevel is not null || item.IsOfficialStore)
                                {
                                    <li>
                                        🏪 @(item.SellerName ?? "Vendedor")
                                        @if (OfficialCatalogSearchRules.ReputationLabel(item.SellerReputationLevel) is { } reputation)
                                        {
                                            <span class="text-muted">· @reputation</span>
                                        }
                                        @if (item.SellerCompletedSales is > 0)
                                        {
                                            <span class="text-muted">· @($"{item.SellerCompletedSales:N0}") vendas concluídas</span>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (item.Highlights.Count > 0 || item.Warnings.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var highlight in item.Highlights)
                                    {
                                        <span class="badge rounded-pill text-bg-success">@highlight</span>
                                    }
                                    @foreach (var warning in item.Warnings)
                                    {
                                        <span class="badge rounded-pill text-bg-danger">⚠ @warning</span>
                                    }
                                </div>
                            }
                            <div class="monitored-offer-actions mt-auto">
                                <button type="button"
                                        class="btn btn-primary"
                                        title="Converter e gerar link de afiliado"
                                        disabled="@(_busy || _convertingUrl == item.SourceUrl)"
                                        @onclick="() => ConvertAsync(item)">
                                    @if (_convertingUrl == item.SourceUrl)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                    }
                                    <span>Converter &amp; Gerar Link</span>
                                </button>
                                <a class="btn btn-outline-secondary"
                                   href="@item.SourceUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Abrir a oferta na loja">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    <span>Abrir</span>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    @if (_searched && _mlNextOffset is not null)
    {
        <div class="text-center mt-4">
            <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="LoadMoreMercadoLivreAsync">
                Carregar mais (Mercado Livre)
            </button>
        </div>
    }
</div>

@if (_searching)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-loading-title" aria-busy="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center py-4">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status" aria-hidden="true"></div>
                    <h2 id="busca-loading-title" class="h6 fw-bold mb-1">Buscando ofertas...</h2>
                    <p class="small text-muted mb-0">
                        Consultando @_searchingStores nas APIs oficiais. Isso pode levar alguns segundos.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_showRules)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-regras-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h2 id="busca-regras-title" class="modal-title h5">Como funciona a Buscar Ofertas</h2>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => _showRules = false"></button>
                </div>
                <div class="modal-body small">
                    <h3 class="h6 fw-bold">Suas configurações</h3>
                    <ul class="mb-3">
                        @if (_storeSummaries.Count == 0)
                        {
                            <li>Nenhuma loja conectada em <strong>Minhas Lojas</strong>: o Mercado Livre exige a conta conectada (OAuth) para buscar.</li>
                        }
                        @foreach (var store in _storeSummaries)
                        {
                            <li><strong>@store.Platform</strong> — @store.Detail</li>
                        }
                        <li>ID de afiliado do Mercado Livre (<code>matt_tool</code>) nos links: <strong>@(string.IsNullOrWhiteSpace(_mlTrackingId) ? "não configurado (usa o padrão do sistema)" : _mlTrackingId)</strong></li>
                    </ul>

                    <h3 class="h6 fw-bold">Sua comissão</h3>
                    <ul class="mb-2">
                        <li><strong>Shopee:</strong> a comissão de cada oferta vem da API de afiliados.</li>
                        <li>
                            <strong>Mercado Livre:</strong> estimada automaticamente pela categoria do anúncio (<code>category_id</code> ➔ categoria raiz),
                            pela tabela do afiliado generalista em venda direta. Na venda indireta (o cliente compra outro produto) o ML paga a metade.
                            O ML pode mudar as taxas: confira no seu painel de afiliado.
                        </li>
                        <li><strong>Amazon:</strong> a API não informa a comissão; usamos a sua taxa abaixo.</li>
                    </ul>
                    <div class="table-responsive mb-2">
                        <table class="table table-sm small mb-0">
                            <thead>
                                <tr><th scope="col">Taxa ML</th><th scope="col">Categorias</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var group in AffiliateCommissionRules.MercadoLivreCategoryRates.GroupBy(rate => rate.Percent).OrderByDescending(group => group.Key))
                                {
                                    <tr>
                                        <td class="fw-semibold">@($"{group.Key:0.##}")%</td>
                                        <td>@string.Join("; ", group.Select(rate => rate.Name))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-semibold" for="taxa-ml">Mercado Livre (%) — fora da tabela</label>
                            <input id="taxa-ml" class="form-control form-control-sm" type="number" step="0.1" min="0" max="90" @bind="_mlCommissionPercent" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold" for="taxa-amazon">Amazon (%)</label>
                            <input id="taxa-amazon" class="form-control form-control-sm" type="number" step="0.1" min="0" max="90" @bind="_amazonCommissionPercent" />
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-sm btn-primary w-100" disabled="@_savingRates" @onclick="SaveCommissionRatesAsync">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Salvar
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_ratesMessage))
                    {
                        <p class="small text-muted mb-3">@_ratesMessage</p>
                    }

                    <h3 class="h6 fw-bold">Métricas e notas de cada oferta</h3>
                    <ul class="mb-3">
                        <li><strong>Vendidos, avaliações e mais vendidos:</strong> vêm das APIs oficiais (ML: anúncio, avaliações e ranking de mais vendidos da categoria; Shopee: vendas e nota). Quando a loja não informa, o card mostra "não informado".</li>
                        <li><strong>Vantagem (0–100):</strong> desconto (até 35), frete grátis (10), comissão (até 20), avaliação (até 15), ranking de mais vendidos (até 20) e unidades vendidas (até 10).</li>
                        <li><strong>Segurança:</strong> parte de 30 e soma loja oficial (+30), reputação verde do vendedor (+25), MercadoLíder (até +15), envio Full (+10), garantia (+5) e alta aprovação (+5); reputação ruim, produto usado e muitas avaliações negativas descontam. Alta a partir de @OfficialCatalogSearchRules.TrustedSafetyScore.</li>
                        <li><strong>Oportunidade:</strong> média de vantagem e segurança (0–39 baixa, 40–69 boa, 70–100 super oferta); só reordena a lista quando você escolhe "Melhor vantagem + segurança".</li>
                        <li>Passe o mouse sobre os selos Oportunidade, Vantagem e Segurança (<i class="bi bi-question-circle" aria-hidden="true"></i>) para um resumo; clique ou toque no selo inteiro para abrir a explicação completa com os números daquela oferta.</li>
                        <li>O painel "Métricas" resume as ofertas na tela: faixa e mediana de preço, % de vendedores confiáveis, nota média, maior comissão, melhor oportunidade e mais vendido.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Onde buscamos</h3>
                    <ul class="mb-3">
                        <li>Somente as APIs oficiais das lojas; páginas públicas não são lidas.</li>
                        <li><strong>Mercado Livre:</strong> catálogo oficial com a sua conta conectada. Só aparecem produtos de catálogo com anúncio ativo e preço.</li>
                        <li><strong>Shopee:</strong> exige a chave de API de afiliado. <strong>Amazon:</strong> exige a PA-API configurada.</li>
                        <li><strong>Base Local (Grupos):</strong> ofertas já capturadas nos seus grupos que contêm o termo (até @OfficialCatalogSearchRules.MaxLimit).</li>
                    </ul>

                    <h3 class="h6 fw-bold">Regras do Mercado Livre</h3>
                    <ul class="mb-3">
                        <li>A busca analisa o catálogo em páginas de @OfficialCatalogSearchRules.MercadoLivreScanPageSize produtos até juntar cerca de @OfficialCatalogSearchRules.MaxLimit ofertas ou analisar @OfficialCatalogSearchRules.MercadoLivreMaxScannedProducts produtos.</li>
                        <li>Muitos produtos de catálogo não têm anúncio ativo; o selo mostra quantos foram analisados e quantos tinham oferta.</li>
                        <li>Produtos "família" (ex.: um modelo com várias configurações) trazem até @OfficialCatalogSearchRules.MercadoLivreMaxChildrenPerProduct variações com oferta.</li>
                        <li>Sem nenhuma oferta, a busca tenta sozinha um termo mais curto (remove as últimas palavras) e avisa o termo usado.</li>
                        <li><strong>Carregar mais</strong> continua a análise de onde parou, só no Mercado Livre.</li>
                        <li><strong>Categoria</strong> é sugerida pelo Mercado Livre a partir do termo (domínios de catálogo, ex.: Notebooks, Tablets, Chinelos) depois da primeira busca e volta a "Todas" quando o termo muda. Os atalhos "Buscar só em" consultam o Mercado Livre de novo só naquela categoria, com 1 clique; todas as categorias encontradas para o termo continuam visíveis (a selecionada em azul) para trocar direto. Com mais de @OfficialCatalogSearchRules.MaxVisibleCategoryChips categorias, "Outras categorias" mostra o restante sem nova consulta.</li>
                        <li>A busca de catálogo do Mercado Livre já devolve os produtos na relevância do próprio Mercado Livre; essa ordem é mantida em "Relevância (Padrão Mercado Livre)".</li>
                        <li>A API do Mercado Livre não informa cupons: "Apenas com cupom" esconde os resultados do Mercado Livre.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Filtros</h3>
                    <ul class="mb-3">
                        <li><strong>Buscar</strong> consulta as lojas com o termo e todos os filtros marcados (preço, frete grátis, categoria).</li>
                        <li>Mudar um filtro depois da busca (lojas, preço, frete grátis, cupom, loja oficial, vendedores confiáveis, mais vendidos, produtos principais, categoria ou ordenação) filtra <strong>só o que já está na tela</strong>, sem nova consulta.</li>
                        <li><strong>Apenas produtos principais</strong> esconde ofertas cujo título começa por um acessório antes do termo buscado (capa, película, carregador, cabo, fonte, suporte...). Se o termo já for um acessório (ex.: "capa iphone"), nada é escondido.</li>
                        <li>Para trazer produtos que ainda não foram carregados com o novo filtro, clique em <strong>Buscar</strong> de novo.</li>
                        <li>Ordenação: relevância (padrão, ordem exata devolvida pelas lojas), melhor vantagem + segurança (score Ofertio), mais vendidos, maior comissão, melhor avaliação, menor preço ou maior desconto.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Links de afiliado</h3>
                    <ul class="mb-0">
                        <li><strong>Converter &amp; Gerar Link</strong> usa a loja da plataforma cadastrada em Minhas Lojas; sem ela, o link não é convertido.</li>
                        <li><strong>Abrir</strong> mostra a oferta na loja em outra aba. Clique na foto para ampliar e ver as outras fotos do produto.</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="() => _showRules = false">Entendi</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_scoreHelp is { } scoreHelp && _scoreHelpItem is { } helpItem)
{
    <div id="modalBadges" class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-nota-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h2 id="busca-nota-title" class="modal-title h5">
                        <i class="bi bi-question-circle me-1" aria-hidden="true"></i>@ScoreHelpTitle(scoreHelp)
                    </h2>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseScoreHelp"></button>
                </div>
                <div class="modal-body small">
                    @switch (scoreHelp)
                    {
                        case ScoreHelpKind.Opportunity:
                            <p>Mede a atratividade da oferta de 0 a 100: é a média entre <strong>Vantagem</strong> e <strong>Segurança</strong>. Uma oferta só fica alta quando é vantajosa <em>e</em> vem de um vendedor confiável.</p>
                            <ul class="list-unstyled mb-3">
                                <li class="mb-1"><span class="badge text-bg-secondary me-2">0 a 39</span>Baixa: pouca vantagem ou vendedor pouco confiável.</li>
                                <li class="mb-1"><span class="badge text-bg-warning me-2">40 a 69</span>Boa Oportunidade (Recomendado).</li>
                                <li class="mb-1"><span class="badge text-bg-success me-2">70 a 100</span>Super Oferta!</li>
                            </ul>
                            <p class="mb-0">A Oportunidade só reordena a lista quando a ordenação é "Melhor vantagem + segurança"; em "Relevância" vale a ordem do Mercado Livre.</p>
                            break;
                        case ScoreHelpKind.Advantage:
                            <p>Mede o quanto a oferta compensa, de 0 a 100. O principal componente é o <strong>desconto real sobre o preço de tabela</strong> (o preço original riscado): cada 1% de desconto vale 1 ponto, até 35.</p>
                            <ul class="mb-3">
                                <li>Desconto sobre o preço de tabela: até 35</li>
                                <li>Frete grátis: 10</li>
                                <li>Comissão de afiliado: até 20</li>
                                <li>Avaliação dos compradores: até 15</li>
                                <li>Ranking de mais vendidos: até 20</li>
                                <li>Unidades vendidas: até 10</li>
                            </ul>
                            <p class="mb-0">Vantagem 0 indica preço normal de tabela, sem outros diferenciais.</p>
                            break;
                        default:
                            <p>Mede a confiabilidade do vendedor. Parte de 30 pontos e soma ou desconta conforme os dados oficiais da loja.</p>
                            <ul class="list-unstyled mb-2">
                                <li class="mb-1"><span class="badge text-bg-success me-2">Alta</span>@OfficialCatalogSearchRules.TrustedSafetyScore pontos ou mais: Lojas Oficiais e MercadoLíder com reputação verde.</li>
                                <li class="mb-1"><span class="badge text-bg-warning me-2">Média</span>45 a @(OfficialCatalogSearchRules.TrustedSafetyScore - 1) pontos: vendedor sem reputação consolidada.</li>
                                <li class="mb-1"><span class="badge text-bg-secondary me-2">Baixa</span>Abaixo de 45: reputação ruim ou sem dados do vendedor.</li>
                            </ul>
                            <ul class="mb-0">
                                <li>Soma: Loja Oficial (+30), reputação verde (+25) ou verde-clara (+15), MercadoLíder Platinum (+15), Gold (+10) ou Silver (+5), envio Full (+10), garantia (+5), aprovação de 97% ou mais (+5).</li>
                                <li>Desconta: reputação laranja (−15) ou vermelha (−30), aprovação abaixo de 90% (−10), produto usado (−10), avaliação baixa (−5).</li>
                            </ul>
                            break;
                    }
                    <div class="alert alert-light border small mt-3 mb-0">
                        <strong>Nesta oferta:</strong> @ScoreHelpSummary(scoreHelp, helpItem)
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseScoreHelp">
                        <i class="bi bi-check2 me-1" aria-hidden="true"></i>Entendi
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_galleryItem is not null && _galleryImages.Count > 0)
{
    var current = _galleryImages[Math.Clamp(_galleryIndex, 0, _galleryImages.Count - 1)];
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-galeria-title">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h2 id="busca-galeria-title" class="modal-title h6 text-truncate">@(_galleryItem.ProductName ?? "Produto")</h2>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseGallery"></button>
                </div>
                <div class="modal-body">
                    <div class="offer-gallery-stage">
                        <img src="@current" alt="Foto @(_galleryIndex + 1) de @_galleryImages.Count" class="offer-gallery-main" />
                        @if (_galleryImages.Count > 1)
                        {
                            <button type="button" class="btn btn-light border offer-gallery-nav offer-gallery-nav--prev" title="Foto anterior" aria-label="Foto anterior" @onclick="() => MoveGallery(-1)">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-light border offer-gallery-nav offer-gallery-nav--next" title="Próxima foto" aria-label="Próxima foto" @onclick="() => MoveGallery(1)">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                    @if (_galleryImages.Count > 1)
                    {
                        <p class="small text-muted text-center my-2">Foto @(_galleryIndex + 1) de @_galleryImages.Count</p>
                        <div class="d-flex flex-wrap justify-content-center gap-1">
                            @for (var index = 0; index < _galleryImages.Count; index++)
                            {
                                var thumbIndex = index;
                                <button type="button"
                                        class="offer-gallery-thumb @(thumbIndex == _galleryIndex ? "active" : null)"
                                        aria-label="Ver foto @(thumbIndex + 1)"
                                        @onclick="() => _galleryIndex = thumbIndex">
                                    <img src="@_galleryImages[thumbIndex]" alt="" loading="lazy" />
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-secondary" href="@_galleryItem.SourceUrl" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Abrir
                    </a>
                    <button type="button" class="btn btn-primary" @onclick="CloseGallery">Fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private string _keyword = string.Empty;
    private bool _ml = true;
    private bool _shopee = true;
    private bool _amazon = true;
    private bool _couponOnly;
    private bool _freeShippingOnly;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private string _sortBy = OfficialCatalogSearchRules.SortRelevance;
    private bool _mainProductsOnly;
    private bool _officialOnly;
    private bool _trustedOnly;
    private bool _bestSellersOnly;
    private decimal? _mlCommissionPercent;
    private decimal? _amazonCommissionPercent;
    private bool _savingRates;
    private string? _ratesMessage;
    private string? _mlCategory;
    private List<OfficialCatalogCategoryDto> _allCategories = [];
    private string? _categoriesKeyword;
    private bool _showAllCategories;
    private bool _busy;
    private bool _searching;
    private string _searchingStores = "as lojas";
    private bool _searched;
    private string? _error;
    private string? _info;
    private string? _notice;
    private string? _convertingUrl;
    private List<OfficialCatalogProductDto> _items = [];
    private List<OfficialCatalogProductDto> _relevanceOrder = [];
    private List<OfficialCatalogChannelStatusDto> _channels = [];
    private OfficialCatalogSearchFilter? _lastFilter;
    private int? _mlNextOffset;
    private string? _mlEffectiveQuery;
    private string? _mlTrackingId;
    private bool _showRules;
    private List<(string Platform, string Detail)> _storeSummaries = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadMercadoLivreTrackingIdAsync(), LoadCommissionRatesAsync());
    }

    private async Task LoadCommissionRatesAsync()
    {
        try
        {
            var result = await RadarApi.GetProfileAsync();
            if (result.Success && result.Data?.Profile is { } profile)
            {
                _mlCommissionPercent = profile.MercadoLivreCommissionPercent;
                _amazonCommissionPercent = profile.AmazonCommissionPercent;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível carregar as taxas de comissão do perfil.");
        }
    }

    private async Task SaveCommissionRatesAsync()
    {
        _savingRates = true;
        _ratesMessage = null;
        try
        {
            var current = await RadarApi.GetProfileAsync();
            if (!current.Success || current.Data?.Profile is not { } profile)
            {
                _ratesMessage = current.ErrorMessage ?? "Não foi possível carregar o seu perfil para salvar as taxas.";
                return;
            }

            profile.MercadoLivreCommissionPercent = OfficialCatalogSearchRules.NormalizeCommissionPercent(_mlCommissionPercent);
            profile.AmazonCommissionPercent = OfficialCatalogSearchRules.NormalizeCommissionPercent(_amazonCommissionPercent);
            var saved = await RadarApi.SaveProfileAsync(profile);
            if (!saved.Success || saved.Data?.Profile is not { } updated)
            {
                _ratesMessage = saved.ErrorMessage ?? "Não foi possível salvar as taxas.";
                return;
            }

            _mlCommissionPercent = updated.MercadoLivreCommissionPercent;
            _amazonCommissionPercent = updated.AmazonCommissionPercent;
            foreach (var item in _relevanceOrder)
            {
                OfficialCatalogSearchRules.ResetEstimatedCommission(item);
                OfficialCatalogSearchRules.ApplyCommission(item, _mlCommissionPercent, _amazonCommissionPercent);
                OfficialCatalogSearchRules.ScoreOffer(item);
            }

            ApplyScreenFilters();
            _ratesMessage = "Taxas salvas no seu perfil; as comissões da tela foram recalculadas.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao salvar as taxas de comissão.");
            _ratesMessage = "Falha ao salvar as taxas.";
        }
        finally
        {
            _savingRates = false;
        }
    }

    private OfficialCatalogProductDto? _galleryItem;
    private List<string> _galleryImages = [];
    private int _galleryIndex;

    private static List<string> GalleryOf(OfficialCatalogProductDto item)
    {
        var images = item.ImageUrls
            .Where(url => !string.IsNullOrWhiteSpace(url))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrWhiteSpace(item.ImageUrl)
            && !images.Contains(item.ImageUrl, StringComparer.OrdinalIgnoreCase))
        {
            images.Insert(0, item.ImageUrl);
        }

        return images;
    }

    private void OpenGallery(OfficialCatalogProductDto item)
    {
        _galleryImages = GalleryOf(item);
        _galleryIndex = 0;
        _galleryItem = _galleryImages.Count > 0 ? item : null;
    }

    private void MoveGallery(int step) =>
        _galleryIndex = (_galleryIndex + step + _galleryImages.Count) % _galleryImages.Count;

    private void CloseGallery()
    {
        _galleryItem = null;
        _galleryImages = [];
        _galleryIndex = 0;
    }

    private static string CommissionLabel(OfficialCatalogProductDto item) => item.CommissionSource switch
    {
        AffiliateCommissionRules.SourceMercadoLivreTable => item.CommissionCategory ?? "tabela ML",
        AffiliateCommissionRules.SourceUserRate => string.IsNullOrWhiteSpace(item.CommissionCategory)
            ? "sua taxa"
            : $"{item.CommissionCategory} · sua taxa",
        _ => item.CommissionSource ?? "estimativa"
    };

    private static string MissingCommissionMessage(OfficialCatalogProductDto item) => item.PlatformType switch
    {
        MarketplaceType.MercadoLivre when !string.IsNullOrWhiteSpace(item.RootCategoryName) =>
            $"Comissão: {item.RootCategoryName} fora da tabela de afiliados (defina a sua taxa nas regras)",
        MarketplaceType.MercadoLivre => "Comissão: categoria não identificada pela API do Mercado Livre",
        MarketplaceType.Amazon => "Comissão: defina a sua taxa da Amazon nas regras",
        MarketplaceType.Shopee => "Comissão não informada pela API da Shopee",
        _ => "Comissão não informada"
    };

    private static string Shorten(string? text, int max = 60) =>
        string.IsNullOrWhiteSpace(text) ? "Produto" : text.Length <= max ? text : text[..max].TrimEnd() + "…";

    private static string OpportunityBadgeClass(int score) =>
        score >= 70 ? "text-bg-success" : score >= 40 ? "text-bg-warning" : "text-bg-secondary";

    private const string OpportunityHelp =
        "Score de atratividade da oferta (0 a 100): média entre Vantagem e Segurança.\n• 0-39: Baixa\n• 40-69: Boa Oportunidade (Recomendado)\n• 70-100: Super Oferta!\nClique no selo para ver a explicação completa.";

    private const string AdvantageHelp =
        "Score de vantagem da oferta (0 a 100).\n• Desconto real sobre o preço original: até 35\n• Frete grátis: 10 · Comissão: até 20\n• Avaliação: até 15 · Mais vendidos: até 20 · Unidades vendidas: até 10\nVantagem 0 indica preço normal de tabela, sem outros diferenciais.\nClique no selo para ver a explicação completa.";

    private const string SafetyHelp =
        "Nível de confiabilidade do vendedor.\n• Alta: Lojas Oficiais e MercadoLíder com reputação verde\n• Média/Baixa: Vendedores sem reputação consolidada.\nEnvio Full, garantia e produto novo também contam.\nClique no selo para ver a explicação completa.";

    private enum ScoreHelpKind
    {
        Opportunity,
        Advantage,
        Safety
    }

    private ScoreHelpKind? _scoreHelp;
    private OfficialCatalogProductDto? _scoreHelpItem;

    private async Task OpenScoreHelpAsync(ScoreHelpKind kind, OfficialCatalogProductDto item)
    {
        _scoreHelp = kind;
        _scoreHelpItem = item;
        try
        {
            await JS.InvokeVoidAsync("hideTooltips");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Não foi possível fechar os tooltips antes do modal de notas.");
        }
    }

    private void CloseScoreHelp()
    {
        _scoreHelp = null;
        _scoreHelpItem = null;
    }

    private static string ScoreHelpTitle(ScoreHelpKind kind) => kind switch
    {
        ScoreHelpKind.Opportunity => "Oportunidade (0 a 100)",
        ScoreHelpKind.Advantage => "Vantagem (0 a 100)",
        _ => "Segurança (Alta, Média, Baixa)"
    };

    private static string ScoreHelpSummary(ScoreHelpKind kind, OfficialCatalogProductDto item)
    {
        switch (kind)
        {
            case ScoreHelpKind.Opportunity:
                var band = item.OpportunityScore >= 70 ? "Super Oferta!"
                    : item.OpportunityScore >= 40 ? "Boa Oportunidade" : "Baixa";
                return $"Oportunidade {item.OpportunityScore} ({band}) = média de Vantagem {item.AdvantageScore} e Segurança {item.SafetyScore}.";
            case ScoreHelpKind.Advantage:
                var discount = OfficialCatalogSearchRules.DiscountPercent(item);
                var discountText = discount > 0
                    ? $"{discount:0}% de desconto (de {ProductMetadataHtmlParser.FormatBrl(item.OriginalPrice)} por {ProductMetadataHtmlParser.FormatBrl(item.Price)})"
                    : "sem desconto sobre o preço de tabela";
                return $"Vantagem {item.AdvantageScore}, {discountText}.";
            default:
                var traits = new List<string>();
                if (item.IsOfficialStore)
                {
                    traits.Add("Loja Oficial");
                }

                if (OfficialCatalogSearchRules.ReputationLabel(item.SellerReputationLevel) is { } reputation)
                {
                    traits.Add(reputation);
                }

                if (item.IsFulfillment)
                {
                    traits.Add("envio Full");
                }

                var detail = traits.Count == 0 ? "sem dados de reputação do vendedor" : string.Join(", ", traits);
                return $"Segurança {OfficialCatalogSearchRules.SafetyLabel(item.SafetyScore)} ({item.SafetyScore} pontos): {detail}.";
        }
    }

    private bool _refreshTooltips;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && !_refreshTooltips)
        {
            return;
        }

        _refreshTooltips = false;
        try
        {
            await JS.InvokeVoidAsync("initTooltips");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Tooltips do Bootstrap indisponíveis na Buscar Ofertas.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeTooltips");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException)
        {
        }
    }

    private async Task LoadMercadoLivreTrackingIdAsync()
    {
        try
        {
            var response = await IntegracaoApi.ListAsync();
            _storeSummaries = (response.DataList ?? [])
                .Where(item => item.Status != MarketplaceIntegrationStatus.Inactive)
                .Select(item => (PlatformDisplayName(item.PlatformType), DescribeStore(item)))
                .ToList();
            var store = response.DataList?
                .Where(item => item.Status != MarketplaceIntegrationStatus.Inactive
                    && OfficialCatalogSearchRules.MatchesMercadoLivreAccount(
                        item.PlatformType,
                        item.FriendlyName,
                        item.ShopName))
                .Select(item => OfficialCatalogSearchRules.ResolveMercadoLivreAffiliateId(
                    item.TrackingId,
                    item.AffiliateTrackingId))
                .FirstOrDefault(id => !string.IsNullOrWhiteSpace(id));
            _mlTrackingId = store;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível carregar o TrackingId do Mercado Livre para a busca.");
        }
    }

    private static string PlatformDisplayName(MarketplaceType platform) => platform switch
    {
        MarketplaceType.MercadoLivre => "Mercado Livre",
        _ => platform.ToString()
    };

    private static string DescribeStore(MarketplaceAccountDto store)
    {
        var name = string.IsNullOrWhiteSpace(store.FriendlyName) ? store.ShopName : store.FriendlyName;
        var status = store.Status == MarketplaceIntegrationStatus.Expired ? "expirada" : "ativa";
        var detail = string.IsNullOrWhiteSpace(name) ? $"loja {status}" : $"{name} ({status})";
        if (store.PlatformType == MarketplaceType.MercadoLivre)
        {
            detail += store.HasOAuthToken
                ? " · busca autorizada (OAuth)"
                : " · sem OAuth: conecte a conta para buscar no Mercado Livre";
        }

        return detail;
    }

    private OfficialCatalogSearchFilter CurrentFilter() => new()
    {
        Keyword = _keyword?.Trim() ?? string.Empty,
        MinPrice = _minPrice,
        MaxPrice = _maxPrice,
        HasCoupon = _couponOnly ? true : null,
        FreeShippingOnly = _freeShippingOnly ? true : null,
        SortBy = _sortBy,
        MercadoLivre = _ml,
        MercadoLivreTrackingId = _mlTrackingId,
        MercadoLivreCategory = string.IsNullOrWhiteSpace(_mlCategory) ? null : _mlCategory,
        OfficialStoreOnly = _officialOnly ? true : null,
        TrustedSellersOnly = _trustedOnly ? true : null,
        BestSellersOnly = _bestSellersOnly ? true : null,
        MainProductsOnly = _mainProductsOnly ? true : null,
        Shopee = _shopee,
        Amazon = _amazon
    };

    private void ApplyScreenFilters()
    {
        _items = [.. OfficialCatalogSearchRules.ApplySort(
            OfficialCatalogSearchRules.FilterLoadedResults(_relevanceOrder, CurrentFilter()),
            _sortBy)];
        _refreshTooltips = true;
    }

    private bool IsSelectedCategory(string? categoryId) =>
        !string.IsNullOrEmpty(_mlCategory)
        && string.Equals(_mlCategory, categoryId, StringComparison.OrdinalIgnoreCase);

    private async Task SearchInCategoryAsync(string? categoryId)
    {
        var alreadyLoaded = _searched
            && _error is null
            && string.Equals(_lastFilter?.MercadoLivreCategory, categoryId, StringComparison.OrdinalIgnoreCase)
            && string.Equals(_lastFilter?.Keyword, _keyword?.Trim(), StringComparison.OrdinalIgnoreCase);
        _mlCategory = categoryId;
        if (alreadyLoaded)
        {
            ApplyScreenFilters();
            return;
        }

        await SearchAsync();
    }

