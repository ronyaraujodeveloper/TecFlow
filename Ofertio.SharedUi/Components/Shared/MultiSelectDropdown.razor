@implements IAsyncDisposable

<div @ref="_rootRef" class="multiselect @(_open ? "multiselect--open" : null)">
    <button @ref="_toggleRef"
            type="button"
            class="btn btn-sm multiselect-toggle @(SelectedValues.Count > 0 ? "btn-primary" : "btn-outline-secondary")"
            aria-haspopup="listbox"
            aria-expanded="@(_open ? "true" : "false")"
            disabled="@Disabled"
            title="@(Disabled ? DisabledHint : Title)"
            @onclick="ToggleOpenAsync">
        <i class="bi @Icon me-1" aria-hidden="true"></i><span>@MultiSelectRules.Summary(Title, SelectedValues.Count)</span><i class="bi bi-chevron-down ms-1 multiselect-caret" aria-hidden="true"></i>
    </button>
    @if (_open)
    {
        var visible = Visible;
        <div class="multiselect-menu shadow">
            @if (ShowSearch)
            {
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input @ref="_searchRef"
                           class="form-control"
                           type="search"
                           placeholder="@($"Filtrar (mín. {MultiSelectRules.MinSearchLength} letras)")"
                           aria-label="@($"Filtrar {Title}")"
                           aria-controls="@ListId"
                           @bind="_term"
                           @bind:event="oninput"
                           @bind:after="ResetActive"
                           @onkeydown="e => OnKeyDownAsync(e, fromList: false)" />
                </div>
                @if (MultiSelectRules.IsSearchTooShort(_term))
                {
                    <div class="multiselect-hint">Digite pelo menos @MultiSelectRules.MinSearchLength letras para filtrar.</div>
                }
            }
            <div @ref="_listRef"
                 id="@ListId"
                 class="multiselect-options"
                 role="listbox"
                 tabindex="0"
                 aria-multiselectable="true"
                 aria-label="@Title"
                 aria-activedescendant="@(_activeIndex >= 0 && _activeIndex < visible.Count ? OptionId(_activeIndex) : null)"
                 @onfocus="OnListFocus"
                 @onkeydown="e => OnKeyDownAsync(e, fromList: true)">
                @if (Options.Count == 0)
                {
                    <div class="multiselect-hint">@EmptyText</div>
                }
                else if (visible.Count == 0)
                {
                    <div class="multiselect-hint">Nenhuma opção contém "@_term".</div>
                }
                @for (var index = 0; index < visible.Count; index++)
                {
                    var option = visible[index];
                    var value = option.Value;
                    var optionIndex = index;
                    var selected = IsSelected(value);
                    <label id="@OptionId(optionIndex)"
                           role="option"
                           aria-selected="@(selected ? "true" : "false")"
                           class="multiselect-option @(selected ? "is-selected" : null) @(optionIndex == _activeIndex ? "is-active" : null)"
                           title="@option.Hint"
                           @onmouseenter="() => _activeIndex = optionIndex">
                        <input class="form-check-input mt-0" type="checkbox" tabindex="-1" checked="@selected" @onchange="e => ToggleAsync(value, e.Value is true)" />
                        <span class="multiselect-option-label">@option.Label</span>
                        @if (option.Count is { } count)
                        {
                            <span class="badge rounded-pill text-bg-light border">@count</span>
                        }
                    </label>
                }
            </div>
            @if (visible.Count > 0)
            {
                <div class="multiselect-actions" @onkeydown="OnActionsKeyDownAsync">
                    <button type="button" class="btn btn-link btn-sm" @onclick="SelectAllAsync">
                        <i class="bi bi-check2-all me-1" aria-hidden="true"></i>Marcar todos
                    </button>
                    <button type="button" class="btn btn-link btn-sm text-secondary" @onclick="ClearAsync">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Limpar
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Classe do Bootstrap Icons sem o prefixo <c>bi</c>, ex.: <c>bi-shop</c>.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter] public IReadOnlyList<MultiSelectOption> Options { get; set; } = [];

    [Parameter] public IReadOnlyCollection<string> SelectedValues { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyCollection<string>> SelectedValuesChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string DisabledHint { get; set; } = "Indisponível";

    [Parameter] public string EmptyText { get; set; } = "Nenhuma opção disponível.";

    private readonly string _id = "ms-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<MultiSelectDropdown>? _selfRef;
    private ElementReference _rootRef;
    private ElementReference _toggleRef;
    private ElementReference _searchRef;
    private ElementReference _listRef;
    private bool _open;
    private bool _openedNow;
    private bool _revealActive;
    private int _activeIndex = -1;
    private string? _term;

    private bool ShowSearch => MultiSelectRules.ShowSearch(Options.Count);

    private IReadOnlyList<MultiSelectOption> Visible =>
        ShowSearch ? MultiSelectRules.Filter(Options, _term) : Options;

    private string ListId => _id + "-list";

    private string OptionId(int index) => $"{_id}-opt-{index}";

    private bool IsSelected(string value) =>
        SelectedValues.Contains(value, StringComparer.OrdinalIgnoreCase);

    private async Task ToggleOpenAsync()
    {
        if (_open)
        {
            await CloseAsync(returnFocus: false);
            return;
        }

        _open = true;
        _term = null;
        _activeIndex = -1;
        _openedNow = true;
    }

    /// <summary>Clique ou foco fora do combo (listener do <c>app-interop.js</c>).</summary>
    [JSInvokable]
    public async Task CloseFromOutside()
    {
        if (_open)
        {
            await CloseAsync(returnFocus: false);
            StateHasChanged();
        }
    }

    private async Task CloseAsync(bool returnFocus)
    {
        _open = false;
        _term = null;
        _activeIndex = -1;
        await InvokeJsAsync("ofertioMultiSelect.unwatch", _rootRef);
        if (returnFocus)
        {
            await FocusAsync(_toggleRef);
        }
    }

    private void ResetActive() => _activeIndex = -1;

    private void OnListFocus()
    {
        if (_activeIndex < 0 && Visible.Count > 0)
        {
            _activeIndex = 0;
        }
    }

    private async Task OnActionsKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync(returnFocus: true);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e, bool fromList)
    {
        var visible = Visible;
        var hasActive = _activeIndex >= 0 && _activeIndex < visible.Count;
        switch (e.Key)
        {
            case "ArrowDown":
                _activeIndex = MultiSelectRules.MoveActive(_activeIndex, visible.Count, 1);
                if (!fromList && visible.Count > 0)
                {
                    await FocusAsync(_listRef);
                }

                _revealActive = true;
                break;
            case "ArrowUp":
                if (_activeIndex <= 0 && ShowSearch)
                {
                    _activeIndex = -1;
                    await FocusAsync(_searchRef);
                }
                else
                {
                    _activeIndex = MultiSelectRules.MoveActive(_activeIndex, visible.Count, -1);
                    _revealActive = true;
                }

                break;
            case " " or "Spacebar" when fromList && hasActive:
                await ToggleActiveAsync(visible);
                break;
            case "Enter" when hasActive:
                await ToggleActiveAsync(visible);
                break;
            case "Enter":
            case "Escape":
                await CloseAsync(returnFocus: true);
                break;
        }
    }

    private Task ToggleActiveAsync(IReadOnlyList<MultiSelectOption> visible)
    {
        var value = visible[_activeIndex].Value;
        return ToggleAsync(value, !IsSelected(value));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openedNow && _open)
        {
            _openedNow = false;
            _selfRef ??= DotNetObjectReference.Create(this);
            await InvokeJsAsync("ofertioMultiSelect.watch", _rootRef, _selfRef);
            await FocusAsync(ShowSearch ? _searchRef : _listRef);
        }

        if (_revealActive && _open)
        {
            _revealActive = false;
            await InvokeJsAsync("ofertioMultiSelect.reveal", _listRef);
        }
    }

    private async Task InvokeJsAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
        }
    }

    private static async Task FocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
        }
    }

    private Task ToggleAsync(string value, bool isChecked) =>
        NotifyAsync(MultiSelectRules.Toggle(SelectedValues, value, isChecked));

    private Task SelectAllAsync() =>
        NotifyAsync(MultiSelectRules.SelectAll(SelectedValues, Visible));

    private Task ClearAsync() =>
        NotifyAsync(MultiSelectRules.ClearVisible(SelectedValues, Visible));

    private async Task NotifyAsync(IReadOnlyList<string> selected)
    {
        SelectedValues = selected;
        await SelectedValuesChanged.InvokeAsync(selected);
    }

    public async ValueTask DisposeAsync()
    {
        if (_open)
        {
            await InvokeJsAsync("ofertioMultiSelect.unwatch", _rootRef);
        }

        _selfRef?.Dispose();
    }
}
