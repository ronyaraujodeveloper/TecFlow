@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@using Ofertio.SharedUi.Services.Navigation

<PageTitle>Ofertio - Inteligência em Ofertas</PageTitle>

<div class="login-page unified-login-page">
    <div class="unified-login-shell mx-auto">
        <header class="text-center mb-4 mb-md-5">
            <img src="images/logo-ofertio.png" alt="Ofertio — Inteligência em Ofertas" class="brand-logo brand-logo-login" />
            <h1 class="display-6 fw-bold mt-3 mb-2">Bem-vindo de volta</h1>
            <p class="lead text-muted mx-auto unified-login-lead">
                Automação de afiliados com login unificado. Conecte-se e gerencie suas campanhas em um só lugar.
            </p>
        </header>

        <UnifiedLoginCard />
        <CookieConsentBanner />

        <nav class="legal-links text-center small mt-4" aria-label="Documentos legais">
            <a href="@LegalRoutes.Terms">Termos de Uso</a>
            <span class="text-muted mx-1">·</span>
            <a href="@LegalRoutes.Privacy">Política de Privacidade</a>
            <span class="text-muted mx-1">·</span>
            <a href="@LegalRoutes.Security">Segurança da Informação</a>
        </nav>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/dashboard", replace: true);
        }
    }
}
