@page "/master/auditoria"
@attribute [Authorize(Roles = MasterRoles.AnyMaster)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits MasterPageBase
@inject IMasterApiService Api

<PageTitle>Trilha de auditoria — Painel Master</PageTitle>

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Trilha de auditoria imutável</h1>
        <p class="text-muted small mb-0">Registros somente-leitura de todas as ações sensíveis do backoffice (o banco rejeita edição e exclusão).</p>
    </div>

    <MasterAlerts Error="@Error" Info="@Info" />

    <div class="card shadow-sm mb-3">
        <div class="card-body row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Ação</label>
                <input class="form-control" placeholder="ex.: tenant.suspender" @bind="_query.Action" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Operador</label>
                <input class="form-control" placeholder="e-mail" @bind="_query.Actor" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">De</label>
                <input type="date" class="form-control" @bind="_query.From" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Até</label>
                <input type="date" class="form-control" @bind="_query.To" />
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="LoadAsync">Filtrar</button>
            </div>
        </div>
    </div>

    <div class="table-responsive card shadow-sm">
        <table class="table table-sm align-middle mb-0 small">
            <thead class="table-light">
                <tr><th>Quando</th><th>Operador</th><th>Ação</th><th>Alvo</th><th>Detalhes</th><th>IP</th></tr>
            </thead>
            <tbody>
                @if (_logs.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@(Busy ? "Carregando..." : "Nenhum registro.")</td></tr>
                }
                @foreach (var log in _logs)
                {
                    <tr>
                        <td class="text-nowrap">@DateTimeText(log.CreatedAt)</td>
                        <td>@log.ActorEmail <span class="text-muted">(@MasterRoles.Label(log.ActorRole))</span></td>
                        <td><code>@log.Action</code></td>
                        <td>@log.TargetType @log.TargetId</td>
                        <td class="text-break">@log.Details</td>
                        <td>@log.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private readonly MasterAuditQueryDto _query = new();
    private List<MasterAuditLogDto> _logs = [];

    protected override async Task LoadAsync()
    {
        Busy = true;
        var result = await Api.AuditAsync(_query);
        if (Accept(result))
        {
            _logs = result.Data ?? [];
        }

        Busy = false;
    }
}
