# Copie para ".env" (fora do git) e preencha. O Docker Compose lê o .env automaticamente.
# Mesmas variáveis do .env da VPS, mais as do override local (Evolution e portas da homologação).

# --- Banco (SQL Server) --- senha forte: 8+ caracteres com maiúscula, minúscula, número e símbolo
MSSQL_SA_PASSWORD=
# Mesmo formato da produção: host "sqlserver" (nome do serviço), banco "Ofertio"
SQL_CONNECTION=Server=sqlserver,1433;Database=Ofertio;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True;

# --- RabbitMQ ---
RABBITMQ_USER=ofertio
RABBITMQ_PASSWORD=

# --- Segurança --- use os MESMOS valores do ambiente cujo banco foi restaurado,
# senão os dados criptografados (Encryption:Key) ficam ilegíveis.
ENCRYPTION_KEY=
# JWT_KEY: 64+ bytes aleatórios, diferente em cada ambiente (openssl rand -base64 64).
JWT_KEY=
# Segredo dos webhooks Telegram/WhatsApp (cabeçalho X-Webhook-Secret). Obrigatório: sem ele o compose não sobe.
# Ao trocar, registre de novo o webhook do Telegram e o da Evolution (roteiro de segredos, C4).
WEBHOOK_SECRET=

# --- Google OAuth --- (no IIS antigo ficavam em variáveis de ambiente do pool OfertioWebUiPool, applicationHost.config)
# Vazio aqui DESLIGA o login Google: variável de ambiente vazia sobrescreve o appsettings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail (SMTP do Gmail) ---
# SMTP_HOST vazio = a API só registra o e-mail no log (não envia).
# SMTP_PASSWORD é a SENHA DE APP de 16 caracteres (myaccount.google.com/apppasswords), não a senha da conta.
# contato@ofertio.com.br precisa estar verificado em Gmail > Configurações > Contas > "Enviar e-mail como".
# Para enviar de verdade: SMTP_HOST=smtp.gmail.com
SMTP_HOST=
SMTP_USER=ofertiotecso@gmail.com
SMTP_PASSWORD=

# --- Só local: WhatsApp (Evolution API) ---
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7

# --- Só homologação: portas do Caddy no Windows. O túnel cloudflared leva dev.ofertio.com.br -> https://127.0.0.1:7002 ---
HML_HTTP_PORT=80
HML_HTTPS_PORT=7002
