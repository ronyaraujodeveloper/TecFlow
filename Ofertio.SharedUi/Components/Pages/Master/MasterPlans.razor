@page "/master/planos"
@attribute [Authorize(Roles = MasterRoles.AnyMaster)]
@layout Ofertio.SharedUi.Components.Layout.MasterMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits MasterPageBase
@inject IMasterApiService Api

<PageTitle>Planos — Painel Master</PageTitle>

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Planos e matriz de funcionalidades</h1>
        <p class="text-muted small mb-0">Preços, ciclos e limites aplicados automaticamente aos inquilinos. Limite 0 = ilimitado.</p>
    </div>

    <MasterAlerts Error="@Error" Info="@Info" />

    <div class="table-responsive card shadow-sm">
        <table class="table align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Plano</th>
                    <th>Mensal (R$)</th>
                    <th>Anual (R$)</th>
                    <th>Lojas</th>
                    <th>Achadinhos/dia</th>
                    <th>Agendamentos/dia</th>
                    <th>Radar</th>
                    <th>Ativo</th>
                    <th class="text-end">Inquilinos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in _plans)
                {
                    <tr>
                        <td><input class="form-control form-control-sm" style="min-width: 110px;" @bind="plan.Name" /><div class="text-muted">@plan.Code</div></td>
                        <td><input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="plan.MonthlyPrice" /></td>
                        <td><input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="plan.AnnualPrice" /></td>
                        <td><input type="number" min="0" class="form-control form-control-sm" @bind="plan.MaxStores" /></td>
                        <td><input type="number" min="0" class="form-control form-control-sm" @bind="plan.DailyVipQuota" /></td>
                        <td><input type="number" min="0" class="form-control form-control-sm" @bind="plan.MaxDailySchedules" /></td>
                        <td><input type="checkbox" class="form-check-input" @bind="plan.RadarEnabled" /></td>
                        <td><input type="checkbox" class="form-check-input" @bind="plan.IsActive" /></td>
                        <td class="text-end">@plan.TenantCount</td>
                        <td class="text-end">
                            @if (Can(MasterPermissions.ManagePlans))
                            {
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => SaveAsync(plan)">Salvar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<SaasPlanDto> _plans = [];

    protected override async Task LoadAsync()
    {
        var result = await Api.PlansAsync();
        if (Accept(result))
        {
            _plans = result.Data ?? [];
        }
    }

    private async Task SaveAsync(SaasPlanDto plan)
    {
        if (Accept(await Api.SavePlanAsync(plan)))
        {
            SetResult(true, $"Plano {plan.Name} salvo.");
        }
    }
}
