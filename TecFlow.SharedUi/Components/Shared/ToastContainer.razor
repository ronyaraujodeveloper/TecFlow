@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject IToastService ToastService

<div class="tecflow-toast-container" aria-live="polite" aria-atomic="false">
    @foreach (var toast in ToastService.Toasts)
    {
        <div @key="toast.Id"
             class="tecflow-toast tecflow-toast--@toast.Type.ToString().ToLowerInvariant()"
             role="@(toast.Type == ToastType.Error ? "alert" : "status")"
             style="--tecflow-toast-duration: @((int)toast.Duration.TotalMilliseconds)ms;">
            <i class="bi @IconName(toast.Type) tecflow-toast-icon" aria-hidden="true"></i>
            <div class="tecflow-toast-message">@toast.Message</div>
            <button type="button"
                    class="tecflow-toast-close"
                    aria-label="Fechar notificação"
                    @onclick="() => ToastService.Dismiss(toast.Id)">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <span class="tecflow-toast-progress" aria-hidden="true"></span>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastService.OnChange += HandleChanged;

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private static string IconName(ToastType type) =>
        type switch
        {
            ToastType.Success => "bi-check-circle-fill",
            ToastType.Error => "bi-x-octagon-fill",
            ToastType.Warning => "bi-exclamation-triangle-fill",
            _ => "bi-info-circle-fill"
        };

    public void Dispose() => ToastService.OnChange -= HandleChanged;
}
