@page "/integracoes/whatsapp"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Services.Integrations
@implements IAsyncDisposable
@inject IWhatsAppIntegrationApiService WhatsAppApi
@inject ILogger<WhatsAppConexao> Logger

<PageTitle>WhatsApp — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">WhatsApp</h1>
        <p class="text-muted small mb-0">
            Conecte seu número lendo o QR Code. A sessão fica isolada por usuário na Evolution API.
        </p>
        <a href="/integracoes/whatsapp/agendador" class="btn btn-outline-success btn-sm mt-2">Agendador de grupos</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }

    <section class="card border-0 shadow-sm whatsapp-session-card mx-auto" style="max-width: 32rem;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h5 fw-bold mb-0">Sessão Evolution</h2>
                <span class="badge @StatusBadgeClass">@_statusLabel</span>
            </div>

            @if (_session?.IsConnected == true)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge text-bg-success">Conectado</span>
                    @if (!string.IsNullOrWhiteSpace(_session.PhoneNumber))
                    {
                        <span class="badge text-bg-success-subtle text-success border border-success-subtle">@_session.PhoneNumber</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_session.ProfileName))
                    {
                        <span class="fw-semibold">@_session.ProfileName</span>
                    }
                </div>
            }

            <button type="button"
                    class="btn btn-success w-100 mb-3"
                    disabled="@_isBusy"
                    @onclick="ConnectAsync">
                @(_isBusy ? "Gerando conexão..." : "Conectar WhatsApp")
            </button>

            @if (!string.IsNullOrWhiteSpace(_qrCode))
            {
                <div class="text-center">
                    <p class="small text-muted mb-2">Aguardando Leitura — abra o WhatsApp e leia o QR Code.</p>
                    <img src="@_qrCode"
                         alt="QR Code WhatsApp"
                         class="whatsapp-qr img-fluid rounded border"
                         width="240"
                         height="240" />
                </div>
            }

            <hr class="my-3 border-secondary-subtle" />
            <h3 class="h6 fw-semibold mb-3">Bot de conversão automática</h3>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="wa-bot-enable"
                       checked="@(_session?.EnableAutoConvertBot ?? true)"
                       disabled="@_isBusy"
                       @onchange="e => SaveBotAsync(enable: IsChecked(e))" />
                <label class="form-check-label" for="wa-bot-enable">Ativar Bot de Conversão Automática</label>
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       id="wa-bot-private"
                       checked="@(_session?.ReplyToPrivateMessages ?? true)"
                       disabled="@_isBusy"
                       @onchange="e => SaveBotAsync(privateMessages: IsChecked(e))" />
                <label class="form-check-label" for="wa-bot-private">Atender Mensagens Privadas</label>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       id="wa-bot-groups"
                       checked="@(_session?.ReplyToGroupMessages ?? false)"
                       disabled="@_isBusy"
                       @onchange="e => SaveBotAsync(groups: IsChecked(e))" />
                <label class="form-check-label" for="wa-bot-groups">Atender Grupos de WhatsApp</label>
            </div>

            <hr class="my-3 border-secondary-subtle" />
            <h3 class="h6 fw-semibold mb-2">Credenciais (mascaradas)</h3>
            <dl class="row small mb-0">
                <dt class="col-4 text-muted">Token</dt>
                <dd class="col-8 font-monospace mb-1">@(string.IsNullOrEmpty(_session?.TokenMasked) ? "—" : _session.TokenMasked)</dd>
                <dt class="col-4 text-muted">ApiKey</dt>
                <dd class="col-8 font-monospace mb-1">@(string.IsNullOrEmpty(_session?.ApiKeyMasked) ? "—" : _session.ApiKeyMasked)</dd>
                <dt class="col-4 text-muted">Sessão</dt>
                <dd class="col-8 font-monospace mb-0">@(string.IsNullOrEmpty(_session?.SessionDataMasked) ? "—" : _session.SessionDataMasked)</dd>
            </dl>
        </div>
    </section>
</div>

@code {
    private WhatsAppIntegrationDto? _session;
    private string _statusLabel = "Desconectado";
    private string? _qrCode;
    private string? _error;
    private bool _isBusy;
    private CancellationTokenSource? _pollCts;

    private string StatusBadgeClass =>
        _session?.ConnectionStatus == WhatsAppConnectionStatuses.Connected
            ? "text-bg-success"
            : _session?.ConnectionStatus == WhatsAppConnectionStatuses.AwaitingQr
                ? "text-bg-warning"
                : "text-bg-secondary";

    protected override async Task OnInitializedAsync()
    {
        await LoadMineAsync();
        if (_session?.ConnectionStatus == WhatsAppConnectionStatuses.AwaitingQr)
        {
            StartPolling();
        }
    }

    private async Task LoadMineAsync()
    {
        var response = await WhatsAppApi.GetMineAsync();
        Apply(response.Data?.Data, response.Data?.Descricao ?? response.ErrorMessage, response.Success);
    }

    private async Task ConnectAsync()
    {
        _error = null;
        _isBusy = true;
        try
        {
            var response = await WhatsAppApi.ConnectAsync();
            Apply(response.Data?.Data, response.Data?.Descricao ?? response.ErrorMessage, response.Success);
            if (!string.IsNullOrWhiteSpace(_qrCode) && _session?.IsConnected != true)
            {
                StartPolling();
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static bool IsChecked(ChangeEventArgs e) =>
        (e.Value is bool flag && flag)
        || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private async Task SaveBotAsync(bool? enable = null, bool? privateMessages = null, bool? groups = null)
    {
        if (_session is null)
        {
            return;
        }

        _error = null;
        _isBusy = true;
        try
        {
            var response = await WhatsAppApi.UpdateBotPreferencesAsync(new WhatsAppBotPreferencesDto
            {
                EnableAutoConvertBot = enable ?? _session.EnableAutoConvertBot,
                ReplyToPrivateMessages = privateMessages ?? _session.ReplyToPrivateMessages,
                ReplyToGroupMessages = groups ?? _session.ReplyToGroupMessages
            });
            Apply(response.Data?.Data, response.Data?.Descricao ?? response.ErrorMessage, response.Success, keepQr: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2.5));
            var ticks = 0;
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                ticks++;
                var response = await WhatsAppApi.RefreshStatusAsync(cancellationToken);
                Apply(response.Data?.Data, keepQr: true);
                await InvokeAsync(StateHasChanged);
                if (_session?.IsConnected == true || ticks >= 48)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Polling WhatsApp interrompido.");
        }
    }

    private void Apply(WhatsAppIntegrationDto? data, string? message = null, bool success = true, bool keepQr = false)
    {
        if (!success && !string.IsNullOrWhiteSpace(message))
        {
            _error = message;
        }

        if (data is null)
        {
            return;
        }

        _session = data;
        _statusLabel = string.IsNullOrWhiteSpace(data.UiStatusLabel) ? "Desconectado" : data.UiStatusLabel;
        if (!string.IsNullOrWhiteSpace(data.QrCodeDataUrl))
        {
            _qrCode = data.QrCodeDataUrl;
        }
        else if (!keepQr || data.IsConnected)
        {
            _qrCode = data.IsConnected ? null : _qrCode;
        }

        if (data.IsConnected)
        {
            _qrCode = null;
            _pollCts?.Cancel();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }
    }
}
