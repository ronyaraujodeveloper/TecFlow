@* Passo a passo para trocar a senha da conta Gmail do envio e gerar uma senha de app nova (seção E-mail do Cofre). *@

@if (Visible)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="gmail-tutorial-title"
         @ref="_dialog"
         @onkeydown="OnKeyDownAsync">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <div class="d-flex align-items-start gap-3">
                        <span class="confirm-dialog-icon confirm-dialog-icon--info" aria-hidden="true">
                            <i class="bi bi-key"></i>
                        </span>
                        <div>
                            <h2 class="modal-title h5 fw-bold mb-1" id="gmail-tutorial-title">Trocar a senha do Gmail e gerar a senha de app</h2>
                            <p class="small text-muted mb-0">Conta do envio: <strong>@Account</strong> · leva uns 5 minutos</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="alert alert-warning small" role="alert">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        Ao trocar a senha da conta, o Google <strong>apaga todas as senhas de app</strong>. O envio de e-mails para até você colar a nova aqui no Cofre. Faça os passos em sequência.
                        Entre sempre com <strong>@Account</strong>: se o navegador estiver em outra conta, troque pelo avatar no canto superior direito.
                    </div>

                    <ol class="gmail-tutorial-steps ps-3 mb-0">
                        <li class="mb-3">
                            <h3 class="h6 fw-semibold mb-1">Trocar a senha da conta</h3>
                            <p class="small mb-1">
                                Abra <a href="https://myaccount.google.com/signinoptions/password" target="_blank" rel="noopener noreferrer">myaccount.google.com/signinoptions/password</a>,
                                confirme a senha atual, digite a nova duas vezes e clique em <strong>Alterar senha</strong>.
                            </p>
                            <p class="small text-muted mb-0">Use uma senha que nunca foi escrita em chat, e-mail ou anotação.</p>
                        </li>
                        <li class="mb-3">
                            <h3 class="h6 fw-semibold mb-1">Gerar a senha de app nova</h3>
                            <p class="small mb-1">
                                Abra <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer">myaccount.google.com/apppasswords</a>,
                                digite <strong>Ofertio</strong> em "Nome do app" e clique em <strong>Criar</strong>.
                            </p>
                            <p class="small mb-1">
                                Aparece uma caixa amarela com 16 letras (ex.: <code>abcd efgh ijkl mnop</code>). <strong>Copie na hora</strong>: ela não é mostrada de novo.
                                Pode copiar com os espaços, porque o sistema remove.
                            </p>
                            <p class="small text-muted mb-0">
                                Se aparecer "a configuração não está disponível", ative a verificação em duas etapas em
                                <a href="https://myaccount.google.com/signinoptions/twosv" target="_blank" rel="noopener noreferrer">myaccount.google.com/signinoptions/twosv</a> e volte ao link acima.
                            </p>
                        </li>
                        <li class="mb-3">
                            <h3 class="h6 fw-semibold mb-1">Colar aqui no Cofre</h3>
                            <p class="small mb-0">
                                Feche esta janela e, na seção <strong>E-mail</strong>, clique no campo <strong>Senha de app do Gmail</strong> (a máscara <code>••••</code> fica selecionada).
                                Cole a senha nova, clique em <strong>Salvar e-mail</strong> e depois em <strong>Enviar e-mail de teste</strong>.
                            </p>
                        </li>
                        <li>
                            <h3 class="h6 fw-semibold mb-1">Conferir que a antiga sumiu</h3>
                            <p class="small mb-0">
                                Volte em <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer">myaccount.google.com/apppasswords</a>.
                                Só deve aparecer a <strong>Ofertio</strong> de hoje. Se houver outra, clique na lixeira ao lado dela.
                            </p>
                        </li>
                    </ol>

                    <hr />
                    <p class="small text-muted mb-0">
                        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                        Se o teste disser "O Gmail recusou o login", a senha de app foi colada errada ou gerada em outra conta: gere outra e cole de novo.
                        Os e-mails saem de <strong>@Account</strong> com "Responder para" <strong>@Ofertio.Business.Service.Mail.OfertioMailAddresses.Contact</strong>.
                        Não verifique o contato@@ em "Enviar e-mail como" no Gmail, porque o domínio recusaria (DMARC).
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-primary" @onclick="CloseAsync">
                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Entendi
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" @onclick="CloseAsync"></div>
}

@code {
    private ElementReference _dialog;
    private bool _focused;

    [Parameter]
    public bool Visible { get; set; }

    /// <summary>Conta Gmail usada no envio (o usuário SMTP salvo no Cofre).</summary>
    [Parameter]
    public string Account { get; set; } = "ofertiotecso@gmail.com";

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_focused)
        {
            _focused = true;
            await _dialog.FocusAsync();
        }
        else if (!Visible)
        {
            _focused = false;
        }
    }

    private Task OnKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private Task CloseAsync() => OnClose.InvokeAsync();
}
