@page "/p/{Slug}"
@layout Layout.PublicLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Core.Enums
@using TecFlow.SharedUi.Helpers
@using TecFlow.SharedUi.Services.LinkGenerator
@inject IPublicConverterApiService PublicPages
@inject IJSRuntime Js
@inject ILogger<PublicConverter> Logger

<PageTitle>Converter link — TecFlow</PageTitle>

@if (_notFound)
{
    <div class="alert alert-warning" role="alert">
        Página pública não encontrada.
    </div>
}
else if (_page is null)
{
    <p class="text-muted">Carregando página do afiliado...</p>
}
else
{
    <section class="card border-0 shadow-sm mx-auto public-converter-card" style="max-width: 640px;">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-2">@(_page.DisplayName ?? "Converter link de produto")</h1>
            <p class="text-muted small mb-3">
                Cole o link do produto. A comissão vai para o afiliado desta página.
            </p>

            <div class="d-flex flex-wrap gap-2 mb-3 public-converter-platforms" aria-label="Lojas conectadas">
                @foreach (var platform in DistinctPlatforms)
                {
                    var definition = MarketplaceUrlDetector.All.FirstOrDefault(item => item.IntegrationType == platform);
                    if (definition is not null)
                    {
                        <MarketplacePlatformChip Definition="definition" IsConnected="true" />
                    }
                    else
                    {
                        <span class="marketplace-platform-badge">@platform.GetDisplayName()</span>
                    }
                }
            </div>

            <label class="form-label fw-semibold" for="public-product-url">Link do produto</label>
            <input id="public-product-url"
                   class="form-control mb-3"
                   placeholder="Cole aqui o link da Shopee, Amazon, Magalu..."
                   value="@_productUrl"
                   disabled="@_isConverting"
                   @oninput="e => _productUrl = e.Value?.ToString() ?? string.Empty" />

            <div class="row g-2">
                <div class="col-6">
                    <button type="button"
                            class="btn btn-primary w-100"
                            disabled="@(_isConverting || string.IsNullOrWhiteSpace(_productUrl))"
                            @onclick="ConvertAsync">
                        @(_isConverting ? "Convertendo..." : "Converter link")
                    </button>
                </div>
                <div class="col-6">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            disabled="@_isConverting"
                            @onclick="ClearForm">
                        Limpar
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger py-2 small mt-3 mb-0" role="alert">@_error</div>
            }

            @if (_result is { HasConvertedLink: true })
            {
                <hr class="my-3 border-secondary-subtle" />

                <div class="public-converter-results" role="region" aria-label="Links gerados">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="public-direct-url">
                            Link de comissão gerado (Direto)
                        </label>
                        <div class="input-group">
                            <input id="public-direct-url"
                                   class="form-control font-monospace small"
                                   readonly
                                   value="@DirectCommissionUrl" />
                            <button type="button"
                                    class="btn @(_copiedDirect ? "btn-success" : "btn-outline-primary")"
                                    disabled="@(_isCopying || string.IsNullOrWhiteSpace(DirectCommissionUrl))"
                                    @onclick="() => CopyAsync(DirectCommissionUrl, isDirect: true)">
                                Copiar
                            </button>
                            <a class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(DirectCommissionUrl) ? "disabled" : null)"
                               href="@DirectCommissionUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Ir para o produto">
                                Abrir
                            </a>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold" for="public-tecflow-url">
                            Link de rastreio TecFlow
                        </label>
                        <div class="input-group">
                            <input id="public-tecflow-url"
                                   class="form-control font-monospace small"
                                   readonly
                                   value="@TecFlowTrackingUrl" />
                            <button type="button"
                                    class="btn @(_copiedTrack ? "btn-success" : "btn-outline-primary")"
                                    disabled="@(_isCopying || string.IsNullOrWhiteSpace(TecFlowTrackingUrl))"
                                    @onclick="() => CopyAsync(TecFlowTrackingUrl, isDirect: false)">
                                Copiar
                            </button>
                            <a class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(TecFlowTrackingUrl) ? "disabled" : null)"
                               href="@TecFlowTrackingUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Abrir rastreio TecFlow">
                                Abrir
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private PublicConverterPageDto? _page;
    private bool _notFound;
    private bool _isConverting;
    private bool _isCopying;
    private bool _copiedDirect;
    private bool _copiedTrack;
    private string _productUrl = string.Empty;
    private string? _error;
    private GerarLinkAfiliadoResponseDto? _result;

    private IReadOnlyList<MarketplaceType> DistinctPlatforms =>
        (_page?.ConnectedPlatforms ?? [])
            .Distinct()
            .ToList();

    private string DirectCommissionUrl => _result?.AffiliateUrl?.Trim() ?? string.Empty;

    private string TecFlowTrackingUrl => _result?.ResolvedShortUrl?.Trim() ?? string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        ClearResults();
        var response = await PublicPages.GetBySlugAsync(Slug);
        if (!response.Success || response.Data?.Data is null)
        {
            _notFound = true;
            _page = null;
            return;
        }

        _page = response.Data.Data;
    }

    private void ClearForm()
    {
        _productUrl = string.Empty;
        ClearResults();
    }

    private void ClearResults()
    {
        _error = null;
        _result = null;
        _copiedDirect = false;
        _copiedTrack = false;
    }

    private async Task ConvertAsync()
    {
        _error = null;
        _result = null;
        _copiedDirect = false;
        _copiedTrack = false;
        _isConverting = true;
        try
        {
            var response = await PublicPages.ConvertAsync(Slug, _productUrl);
            if (!response.Success || response.Data is null || !response.Data.Success)
            {
                _error = response.Data?.Message
                    ?? response.ErrorMessage
                    ?? "Não foi possível converter o link.";
                return;
            }

            _result = response.Data;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha na conversão pública. Slug={Slug}", Slug);
            _error = "Não foi possível converter o link.";
        }
        finally
        {
            _isConverting = false;
        }
    }

    private async Task CopyAsync(string url, bool isDirect)
    {
        if (string.IsNullOrWhiteSpace(url) || _isCopying)
        {
            return;
        }

        _isCopying = true;
        try
        {
            var copied = await Js.InvokeAsync<bool>("tecFlowAppInterop.copyToClipboard", url);
            if (!copied)
            {
                return;
            }

            if (isDirect)
            {
                _copiedDirect = true;
                _copiedTrack = false;
            }
            else
            {
                _copiedTrack = true;
                _copiedDirect = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao copiar URL pública.");
        }
        finally
        {
            _isCopying = false;
        }
    }
}
