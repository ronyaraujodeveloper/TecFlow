@page "/integracoes/whatsapp/grupos/monitorados"
@page "/integracoes/telegram/grupos/monitorados"
@page "/integracoes/grupos/monitorados"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Business.Service.Groups
@using TecFlow.Business.Service.LinkStrategies
@using TecFlow.Core.Entities
@using TecFlow.Core.Enums
@using TecFlow.SharedUi.Helpers
@using TecFlow.SharedUi.Models
@using TecFlow.SharedUi.Services.Integrations
@using TecFlow.SharedUi.Services.UI
@inject IMonitoredGroupsApiService Api
@inject IModalService ModalService
@inject NavigationManager Navigation
@inject ILogger<GruposMonitorados> Logger
@inject IJSRuntime Js
@inject IToastService ToastService
@implements IAsyncDisposable

<PageTitle>Grupos monitorados @ChannelLabel — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="h5 fw-bold mb-0">Grupos monitorados</h1>
            <span class="badge badge-sm rounded-pill d-inline-flex align-items-center gap-1 text-white" style="background-color: @(IsTelegram ? "#0088cc" : "#25D366");">
                <i class="bi @(IsTelegram ? "bi-telegram" : "bi-whatsapp")" aria-hidden="true"></i>
                <span>@ChannelLabel</span>
            </span>
            @if (_isSyncing)
            {
                <span class="badge badge-sm rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle d-inline-flex align-items-center gap-1">
                    <span class="spinner-border spinner-border-sm monitored-sync-spinner" role="status" aria-hidden="true"></span>
                    <span>Sincronizando em background...</span>
                </span>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_isBusy" @onclick="RefreshFeedAsync">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                Atualizar
            </button>
            @if (IsTelegram)
            {
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_isProcessing || _isBusy || _isSyncing)" @onclick="HandleResetAllAsync">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    Limpar
                </button>
            }
            <button type="button" class="btn btn-sm btn-primary" disabled="@_isSyncing" title="Sincronizar grupos do @ChannelLabel" @onclick="SyncAsync">
                <i class="bi bi-cloud-arrow-down" aria-hidden="true"></i>
                @(_isSyncing ? "Sincronizando..." : "Sincronizar grupos")
            </button>
        </div>
    </div>

    <form class="d-flex flex-wrap align-items-center gap-2 mb-2" role="search" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault="true">
        <div class="input-group input-group-sm monitored-search">
            <span class="input-group-text bg-white"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input id="live-search-q" class="form-control" placeholder="Buscar palavra-chave, cupom ou loja" aria-label="Busca rápida" @bind="_searchKeyword" />
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
        <select id="monitored-group" class="form-select form-select-sm monitored-group-select" aria-label="Grupo selecionado" value="@_groupKey" @onchange="OnGroupChanged">
            <option value="">Todos os grupos</option>
            @foreach (var group in _groups)
            {
                <option value="@group.GroupKey">@group.Name</option>
            }
        </select>
        <button type="button" class="btn btn-sm @(AdvancedFilterCount > 0 ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => _showAdvancedFilters = true">
            Filtros Avançados ⚙️
            @if (AdvancedFilterCount > 0)
            {
                <span class="badge rounded-pill text-bg-light ms-1">@AdvancedFilterCount</span>
            }
        </button>
    </form>

    <AdvancedOfferFiltersModal IsOpen="_showAdvancedFilters"
                               Value="CurrentFilters"
                               PageSizeOptions="PageSizeOptions"
                               DefaultPageSize="GroupOfferCaptureRules.OffersPageSize"
                               OnApply="ApplyAdvancedFiltersAsync"
                               OnClose="() => _showAdvancedFilters = false" />

    <div class="mb-2">
        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Filtro do feed">
            <button type="button" class="btn @FeedChipClass(FeedTab.Offers)" @onclick="() => SetFeedTabAsync(FeedTab.Offers)">Feed de Ofertas</button>
            <button type="button" class="btn @FeedChipClass(FeedTab.Coupons)" @onclick="() => SetFeedTabAsync(FeedTab.Coupons)">
                <i class="bi bi-ticket-perforated" aria-hidden="true"></i>
                Cupons &amp; Promoções
            </button>
            <button type="button" class="btn @FeedChipClass(FeedTab.Ignored)" @onclick="() => SetFeedTabAsync(FeedTab.Ignored)">Ocultos / Descartados</button>
        </div>
        @if (_feedTab == FeedTab.Coupons)
        {
            <ul class="nav nav-pills monitored-subpills flex-wrap gap-1 mt-2" role="tablist" aria-label="Cupons por marketplace">
                @foreach (var (value, label) in CouponPlatformTabs)
                {
                    <li class="nav-item" role="presentation">
                        <button type="button"
                                role="tab"
                                aria-selected="@(_couponPlatform == value)"
                                class="nav-link py-1 px-3 @(_couponPlatform == value ? "active" : string.Empty)"
                                disabled="@_isBusy"
                                @onclick="() => SetCouponPlatformAsync(value)">
                            @label
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <div id="ofertas-container" class="monitored-offers-container">
        @if (_offers.Count == 0)
        {
            <div class="alert alert-light border py-2 small">
                @if (_groups.Count > 0)
                {
                    <span>@_groups.Count grupo(s) do @ChannelLabel. @EmptyFeedMessage</span>
                }
                else
                {
                    <span>Nenhum grupo do @ChannelLabel listado. Sincronize e aguarde mensagens com links.</span>
                }
            </div>
        }
        else
        {
            @Pager
            <div class="row g-2">
                @foreach (var item in _offers)
                {
                    <div class="col-12 col-md-6 col-xl-4" @key="item.Id">
                        @if (item.Type == OfferType.Coupon)
                        {
                            <CouponCard Item="item"
                                        IsBusy="_isBusy"
                                        ShowRestore="ShowIgnored"
                                        OnIgnore="MarkAsUninterested"
                                        OnRestore="RestoreAsync" />
                        }
                        else
                        {
                            <OfferCard Item="item"
                                       IsBusy="_isBusy"
                                       ShowIgnored="ShowIgnored"
                                       IsTelegram="IsTelegram"
                                       ScheduleUrl="@(IsTelegram && !ShowIgnored && _clonedOfferId == item.Id ? _scheduleUrl : null)"
                                       OnValidate="ValidateAsync"
                                       OnClone="CloneAsync"
                                       OnIgnore="MarkAsUninterested"
                                       OnRestore="RestoreAsync" />
                        }
                    </div>
                }
            </div>
            @Pager
        }
    </div>
</div>

@code {
    private const string WhatsAppPath = "/integracoes/whatsapp/grupos/monitorados";
    private const string TelegramPath = "/integracoes/telegram/grupos/monitorados";
    private const string LegacyPath = "/integracoes/grupos/monitorados";
    private const string OffersContainerId = "ofertas-container";
    private readonly List<MonitoredGroupDto> _groups = [];
    private readonly List<GroupCapturedOfferDto> _offers = [];
    private int _hours = 24;
    private int _totalOffers;
    private int _page = 1;
    private int _pageSize = GroupOfferCaptureRules.OffersPageSize;
    private string? _searchKeyword;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private string? _store;
    private string _groupKey = string.Empty;
    private bool _isBusy;
    private bool _isSyncing;
    private bool _isProcessing;
    private bool _showAdvancedFilters;
    private string? _scheduleUrl;
    private int? _clonedOfferId;
    private FeedTab _feedTab = FeedTab.Offers;
    private string _couponPlatform = CouponMessageRules.AllPlatformsFilter;
    private CancellationTokenSource? _refreshCts;

    private enum FeedTab
    {
        Offers,
        Coupons,
        Ignored
    }

    private static readonly (string Value, string Label)[] CouponPlatformTabs =
    [
        (CouponMessageRules.AllPlatformsFilter, "Todos"),
        (nameof(MarketplaceType.MercadoLivre), "Mercado Livre"),
        (nameof(MarketplaceType.Shopee), "Shopee"),
        (nameof(MarketplaceType.Amazon), "Amazon"),
        (CouponMessageRules.OtherPlatformsFilter, "Outros")
    ];

    private bool ShowIgnored => _feedTab == FeedTab.Ignored;

    private OfferType FeedOfferType => _feedTab == FeedTab.Coupons ? OfferType.Coupon : OfferType.Product;

    private string EmptyFeedMessage => _feedTab switch
    {
        FeedTab.Ignored => "Nenhuma oferta ocultada neste período.",
        FeedTab.Coupons => "Nenhum cupom capturado para este filtro neste período.",
        _ => "Nenhuma oferta das suas lojas ativas neste período."
    };

    private bool IsTelegram => CurrentPath().Equals(TelegramPath, StringComparison.OrdinalIgnoreCase);

    private string Channel => IsTelegram
        ? GroupOfferCaptureRules.TelegramChannel
        : GroupOfferCaptureRules.WhatsAppChannel;

    private string ChannelLabel => IsTelegram ? "Telegram" : "WhatsApp";

    private int TotalPages => GroupOfferCaptureRules.ResolveTotalPages(_totalOffers, _pageSize);

    private int DisplayStart => _totalOffers == 0 ? 0 : ((_page - 1) * _pageSize) + 1;

    private int DisplayEnd => Math.Min(_page * _pageSize, _totalOffers);

    private RenderFragment Pager => @<nav class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 my-3" aria-label="Paginação de ofertas">
        <p class="text-muted small mb-0">Exibindo @DisplayStart a @DisplayEnd de @_totalOffers ofertas</p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_isBusy || _page <= 1)" @onclick="() => SetPageAsync(_page - 1)">Anterior</button>
            @foreach (var pageNumber in VisiblePages())
            {
                <button type="button" class="btn btn-sm @(_page == pageNumber ? "btn-primary" : "btn-outline-secondary")" disabled="@_isBusy" @onclick="() => SetPageAsync(pageNumber)">@pageNumber</button>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_isBusy || _page >= TotalPages)" @onclick="() => SetPageAsync(_page + 1)">Próximo</button>
        </div>
    </nav>;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentPath().Equals(LegacyPath, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(WhatsAppPath, replace: true);
            return;
        }

        await LoadAsync();
        if (IsTelegram)
        {
            StartOfferRefresh();
        }
    }

    private string CurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrEmpty(relative) ? "/" : "/" + relative.Split('?', '#')[0];
    }

    private string FeedChipClass(FeedTab tab) =>
        _feedTab == tab ? "btn-primary" : "btn-outline-secondary";

    private Task SetFeedTabAsync(FeedTab tab)
    {
        _feedTab = tab;
        _page = 1;
        return LoadAsync();
    }

    private Task SetCouponPlatformAsync(string platform)
    {
        _couponPlatform = platform;
        _page = 1;
        return LoadAsync();
    }

    private MonitoredOfferFilters CurrentFilters => new(_hours, _minPrice, _maxPrice, _store, _pageSize);

    private int AdvancedFilterCount => CurrentFilters.ActiveCount(GroupOfferCaptureRules.OffersPageSize);

    private static IReadOnlyList<int> PageSizeOptions =>
        GroupOfferCaptureRules.TemporaryLimitTenOffers ? [] : GroupOfferCaptureRules.AllowedPageSizes;

    private Task ApplySearchAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task ApplyAdvancedFiltersAsync(MonitoredOfferFilters filters)
    {
        _showAdvancedFilters = false;
        _hours = GroupOfferCaptureRules.ResolveLookbackHours(filters.Hours);
        _minPrice = filters.MinPrice;
        _maxPrice = filters.MaxPrice;
        _store = filters.Store;
        _pageSize = GroupOfferCaptureRules.ResolveOffersTake(filters.PageSize);
        _page = 1;
        return LoadAsync();
    }

    private LiveSearchFilterDto? BuildSearch()
    {
        var filter = new LiveSearchFilterDto
        {
            Keyword = _searchKeyword,
            MinPrice = _minPrice,
            MaxPrice = _maxPrice,
            Store = _store
        };
        return filter.HasAny ? filter : null;
    }

    private Task OnGroupChanged(ChangeEventArgs e)
    {
        _groupKey = e.Value?.ToString() ?? string.Empty;
        _page = 1;
        return LoadAsync();
    }

    private async Task SetPageAsync(int page)
    {
        _page = GroupOfferCaptureRules.ResolveOffersPage(page);
        await LoadAsync();
        StateHasChanged();
        await ScrollToOffersAsync();
    }

    private async Task ScrollToOffersAsync()
    {
        try
        {
            await Js.InvokeAsync<bool>("tecFlowAppInterop.scrollIntoViewById", OffersContainerId, "start");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Scroll até a lista de ofertas indisponível.");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private IEnumerable<int> VisiblePages()
    {
        var total = TotalPages;
        var start = Math.Max(1, _page - 2);
        var end = Math.Min(total, start + 4);
        start = Math.Max(1, end - 4);
        for (var i = start; i <= end; i++)
        {
            yield return i;
        }
    }

    private async Task RefreshFeedAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task HandleResetAllAsync()
    {
        if (!IsTelegram || _isProcessing)
        {
            return;
        }

        var confirmed = await ModalService.ConfirmAsync(new ConfirmDialogRequest
        {
            Title = "Limpar ofertas capturadas",
            Message = "Isso apaga as ofertas capturadas e as imagens em uploads/products deste usuário. Depois use Sincronizar grupos para recarregar. Continuar?",
            ConfirmText = "Limpar",
            CancelText = "Cancelar",
            Kind = ConfirmDialogKind.Danger
        });
        if (!confirmed)
        {
            return;
        }

        try
        {
            _isProcessing = true;
            StateHasChanged();

            var result = await Api.ResetAndResyncAsync(Channel);

            _offers.Clear();
            _totalOffers = 0;
            _page = 1;
            StateHasChanged();

            if (result.Success || result.Data is { Status: true })
            {
                var message = string.IsNullOrWhiteSpace(result.Data?.Descricao)
                    ? "Banco de dados e imagens zerados. Use Sincronizar grupos para recarregar."
                    : result.Data.Descricao;
                ToastService.ShowSuccess(message);
                return;
            }

            var fail = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível limpar o feed.";
            ToastService.ShowError($"Falha ao limpar: {fail}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao limpar dados");
            ToastService.ShowError($"Falha ao limpar: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SyncAsync()
    {
        try
        {
            var result = await Api.SyncAsync(Channel);
            if (result.Success || result.Data is { Status: true })
            {
                _isSyncing = true;
                ToastService.ShowInfo(string.IsNullOrWhiteSpace(result.Data?.Descricao)
                    ? MonitoredGroupSyncRules.BackgroundStartedMessage
                    : result.Data.Descricao);
                if (result.Data is not null)
                {
                    Apply(result.Data, null, append: false, silent: true);
                }

                StartOfferRefresh();
                _ = StopSyncingBadgeAsync();
                return;
            }

            ToastService.ShowError(result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível sincronizar os grupos.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao sincronizar grupos monitorados.");
            ToastService.ShowError("Não foi possível sincronizar os grupos.");
        }
    }

    private async Task StopSyncingBadgeAsync()
    {
        try
        {
            await Task.Delay(MonitoredGroupSyncRules.ClientTimeout);
            _isSyncing = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAsync(bool silent = false, bool append = false)
    {
        if (!silent)
        {
            _isBusy = true;
        }
        try
        {
            var skip = GroupOfferCaptureRules.ResolveOffersSkipFromPage(_page, _pageSize);
            var result = await Api.ListAsync(
                _hours,
                string.IsNullOrWhiteSpace(_groupKey) ? null : _groupKey,
                Channel,
                skip,
                _pageSize,
                ShowIgnored,
                BuildSearch(),
                FeedOfferType,
                _feedTab == FeedTab.Coupons ? _couponPlatform : null);
            if (result.Data is not null)
            {
                Apply(result.Data, silent ? null : result.ErrorMessage, append, silent);
            }
            else if (!silent)
            {
                Apply(null, result.ErrorMessage, append: false, silent: false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao listar ofertas monitoradas.");
            if (!silent)
            {
                ToastService.ShowError("Não foi possível carregar as ofertas.");
            }
        }
        finally
        {
            if (!silent)
            {
                _isBusy = false;
            }
        }
    }

    private void StartOfferRefresh()
    {
        _refreshCts?.Cancel();
        _refreshCts = new CancellationTokenSource();
        _ = RefreshOffersLoopAsync(_refreshCts.Token);
    }

    private async Task RefreshOffersLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(_isSyncing ? TimeSpan.FromSeconds(8) : TimeSpan.FromSeconds(20));
        try
        {
            await PollSyncStatusAsync();
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await PollSyncStatusAsync();
                await LoadAsync(silent: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollSyncStatusAsync()
    {
        if (!IsTelegram)
        {
            return;
        }

        try
        {
            var result = await Api.GetSyncStatusAsync();
            var status = result.Data;
            if (status is null)
            {
                return;
            }

            if (status.IsFailed)
            {
                _isSyncing = false;
                ToastService.ShowError(status.Message);
                return;
            }

            if (status.IsCompleted && _isSyncing)
            {
                _isSyncing = false;
                ToastService.ShowSuccess(status.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao consultar status da sincronização UserBot.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCts is not null)
        {
            await _refreshCts.CancelAsync();
            _refreshCts.Dispose();
        }
    }

    private async Task ValidateAsync(int offerId)
    {
        _isBusy = true;
        try
        {
            var result = await Api.ValidateAsync(offerId, Channel);
            Apply(result.Data, result.ErrorMessage, append: false, silent: false);
            if (result.Data is { Status: true })
            {
                ToastService.ShowSuccess(result.Data.Descricao);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao validar oferta {OfferId}.", offerId);
            ToastService.ShowError("Não foi possível validar o anúncio.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task MarkAsUninterested(int offerId)
    {
        _isBusy = true;
        try
        {
            var result = await Api.IgnoreAsync(offerId, Channel);
            if (result.Data is { Status: true })
            {
                ToastService.ShowSuccess(result.Data.Descricao);
                await LoadAsync();
                return;
            }

            ToastService.ShowError(result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível ocultar a oferta.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao ocultar oferta {OfferId}.", offerId);
            ToastService.ShowError("Não foi possível marcar a oferta como sem interesse.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RestoreAsync(int offerId)
    {
        _isBusy = true;
        try
        {
            var result = await Api.RestoreAsync(offerId, Channel);
            if (result.Data is { Status: true })
            {
                ToastService.ShowSuccess(result.Data.Descricao);
                await LoadAsync();
                return;
            }

            ToastService.ShowError(result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível restaurar a oferta.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao restaurar oferta {OfferId}.", offerId);
            ToastService.ShowError("Não foi possível restaurar a oferta.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CloneAsync(int offerId)
    {
        _isBusy = true;
        try
        {
            var result = await Api.CloneAsync(offerId, Channel);
            if (result.Data is { Status: true, Clone.AffiliateUrl: { Length: > 0 } })
            {
                Apply(result.Data, null, append: false, silent: false);
                _clonedOfferId = offerId;
                _scheduleUrl = result.Data.Clone.RedirectUrl;
                ToastService.ShowSuccess(CloneOfferRules.SuccessToast);
                if (!IsTelegram && !string.IsNullOrWhiteSpace(result.Data.Clone.RedirectUrl))
                {
                    Navigation.NavigateTo(result.Data.Clone.RedirectUrl);
                }

                return;
            }

            Apply(result.Data, result.ErrorMessage, append: false, silent: true);
            ToastService.ShowError(result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível clonar a oferta.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao clonar oferta {OfferId}.", offerId);
            ToastService.ShowError("Não foi possível converter o link de comissão.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private void Apply(MonitoredGroupsResponseDto? data, string? error, bool append, bool silent)
    {
        if (data is null)
        {
            if (!silent)
            {
                ToastService.ShowError(error ?? "Resposta vazia da API.");
            }

            return;
        }

        _groups.Clear();
        _groups.AddRange(data.Groups);
        _totalOffers = data.TotalOffers;
        var maxPage = GroupOfferCaptureRules.ResolveTotalPages(_totalOffers, _pageSize);
        if (_page > maxPage)
        {
            _page = maxPage;
        }

        var incoming = GroupOfferCaptureRules.DeduplicateOffers(data.Offers);
        if (append)
        {
            foreach (var offer in incoming)
            {
                if (_offers.Exists(existing => GroupOfferCaptureRules.IsSameCapturedOffer(existing, offer)))
                {
                    continue;
                }

                _offers.Add(offer);
            }
        }
        else
        {
            _offers.Clear();
            _offers.AddRange(incoming);
        }

        if (!data.Status && !silent)
        {
            ToastService.ShowError(FirstNonEmpty(data.Descricao, error, "Não foi possível carregar os grupos monitorados."));
        }
    }
}
