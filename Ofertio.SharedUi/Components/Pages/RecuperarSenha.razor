@page "/recuperar-senha"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IPasswordResetApiService PasswordResetApi

<PageTitle>Ofertio — Recuperar ou alterar senha</PageTitle>

<div class="login-page d-flex justify-content-center">
    <div class="w-100 unified-login-shell">
        <div class="text-center mb-4">
            <a href="/entrar" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
                &larr; Voltar ao login
            </a>
            <h1 class="h3 fw-bold mt-3 mb-2">Recuperar ou alterar senha</h1>
            <p class="text-muted small mb-0 mx-auto" style="max-width: 28rem;">
                Gerencie o acesso à sua conta Ofertio de forma segura.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_resetToken))
        {
            <div class="card shadow-sm border-0 login-card unified-login-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-2">Nova senha</h2>
                    <p class="text-muted small mb-4">
                        Escolha uma senha nova. Este link só pode ser usado uma vez.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="recovery-password">Nova senha</label>
                        <input id="recovery-password"
                               type="password"
                               class="form-control form-control-lg"
                               @bind="_newPassword"
                               autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="recovery-confirm-password">Confirmar nova senha</label>
                        <input id="recovery-confirm-password"
                               type="password"
                               class="form-control form-control-lg"
                               @bind="_confirmPassword"
                               autocomplete="new-password" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
                    {
                        <div class="alert @(_feedbackIsError ? "alert-danger" : "alert-info") small py-2" role="status">
                            @_feedbackMessage
                        </div>
                    }

                    <button type="button"
                            class="btn btn-primary btn-lg w-100 btn-touch"
                            disabled="@_isSubmitting"
                            @onclick="SubmitNewPasswordAsync">
                        @(_isSubmitting ? "Salvando..." : "Salvar nova senha")
                    </button>
                </div>
            </div>
        }
        else if (_passwordSaved)
        {
            <div class="card shadow-sm border-0 login-card unified-login-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-2">Senha atualizada</h2>
                    <p class="text-muted small mb-4">@_feedbackMessage</p>
                    <a href="/entrar" class="btn btn-primary btn-lg w-100 btn-touch">Entrar</a>
                </div>
            </div>
        }
        else if (_isAuthenticated)
        {
            <div class="card shadow-sm border-0 login-card unified-login-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-2">Alterar senha</h2>
                    <p class="text-muted small mb-4">
                        Você já está autenticado. Em breve, a central de segurança permitirá alterar a senha diretamente aqui.
                    </p>
                    <a href="/dashboard" class="btn btn-primary btn-lg w-100 btn-touch">
                        Ir para o painel
                    </a>
                </div>
            </div>
        }
        else if (_authReady)
        {
            <div class="card shadow-sm border-0 login-card unified-login-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-2">Esqueci minha senha</h2>
                    <p class="text-muted small mb-4">
                        Informe o e-mail cadastrado. Se ele existir, enviaremos um link para escolher uma nova senha.
                        Não lembra qual e-mail usou? Escreva para
                        <a href="mailto:@LegalRoutes.ContactEmail">@LegalRoutes.ContactEmail</a>.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="recovery-email">E-mail</label>
                        <input id="recovery-email"
                               class="form-control form-control-lg"
                               @bind="_recoveryModel.Email"
                               placeholder="seu@email.com"
                               autocomplete="email"
                               inputmode="email" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
                    {
                        <div class="alert @(_feedbackIsError ? "alert-danger" : "alert-info") small py-2" role="status">
                            @_feedbackMessage
                        </div>
                    }

                    <button type="button"
                            class="btn btn-outline-primary btn-lg w-100 btn-touch"
                            disabled="@_isSubmitting"
                            @onclick="SubmitRecoveryRequestAsync">
                        @(_isSubmitting ? "Enviando..." : "Enviar instruções")
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly RecoveryModel _recoveryModel = new();
    private string? _feedbackMessage;
    private bool _feedbackIsError;
    private bool _authReady;
    private bool _isAuthenticated;
    private bool _isSubmitting;
    private bool _passwordSaved;
    private string? _resetToken;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("token", out var token) && !string.IsNullOrWhiteSpace(token))
        {
            _resetToken = token.ToString();
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        _authReady = true;
    }

    private async Task SubmitRecoveryRequestAsync()
    {
        var results = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        var context = new System.ComponentModel.DataAnnotations.ValidationContext(_recoveryModel);
        if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(
                _recoveryModel,
                context,
                results,
                validateAllProperties: true))
        {
            _feedbackIsError = true;
            _feedbackMessage = results[0].ErrorMessage;
            return;
        }

        _isSubmitting = true;
        _feedbackMessage = null;
        try
        {
            var response = await PasswordResetApi.RequestAsync(_recoveryModel.Email.Trim());
            _feedbackIsError = !response.Status;
            _feedbackMessage = response.Descricao;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitNewPasswordAsync()
    {
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _feedbackIsError = true;
            _feedbackMessage = "A confirmação da nova senha não coincide.";
            return;
        }

        _isSubmitting = true;
        _feedbackMessage = null;
        try
        {
            var response = await PasswordResetApi.ConfirmAsync(_resetToken ?? string.Empty, _newPassword);
            _feedbackIsError = !response.Status;
            _feedbackMessage = response.Descricao;
            if (response.Status)
            {
                _passwordSaved = true;
                _resetToken = null;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class RecoveryModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-mail é obrigatório.")]
        [ValidEmail(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = string.Empty;
    }
}

<CookieConsentBanner />
