@using Ofertio.Business.Dto
@using Ofertio.Core.Enums
@inject IUserClock Clock

<div class="marketplace-store-card card border-0 shadow-sm h-100">
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex align-items-start justify-content-between gap-2">
            <div class="min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="marketplace-platform-badge @GetPlatformBadgeClass()">@GetPlatformLabel()</span>
                    <span class="badge @GetStatusBadgeClass()">@GetStatusLabel()</span>
                </div>
                <h3 class="h6 fw-semibold mb-1 text-truncate" title="@Store.FriendlyName">@Store.FriendlyName</h3>
                <p class="text-muted small mb-0">Shop ID: <span class="font-monospace">@Store.ShopId</span></p>
                <p class="text-muted small mb-0">Affiliate ID: <span class="font-monospace">@AffiliateIdDisplay</span></p>
                @if (Store.RequiresTrackingIdCorrection)
                {
                    <p class="text-danger small mb-0 mt-2">
                        ID inválido (URL detectada). Edite o cadastro e informe o ID numérico/tag.
                    </p>
                }
            </div>
        </div>

        <dl class="marketplace-store-meta mb-0">
            <div>
                <dt>Vinculada em</dt>
                <dd>@Clock.ToLocal(Store.CreatedAt).ToString("dd/MM/yyyy HH:mm")</dd>
            </div>
            @if (!Store.PlatformType.IsUniversalAffiliatePlatform())
            {
                <div>
                    <dt>Token expira em</dt>
                    <dd>@Clock.ToLocal(Store.ExpiresAt).ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
            }
        </dl>

        <div class="marketplace-store-actions mt-auto d-grid">
            @if (_confirmDelete)
            {
                <p class="text-danger small mb-2">Confirmar desconexão desta loja?</p>
                <div class="d-grid gap-2">
                    <button type="button"
                            class="btn btn-danger btn-touch"
                            disabled="@IsBusy"
                            @onclick="() => ConfirmarDesconexaoAsync(Store)">
                        <i class="bi bi-plug me-1" aria-hidden="true"></i>Sim, desconectar
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-touch" disabled="@IsBusy" @onclick="CancelDelete">
                        <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancelar
                    </button>
                </div>
            }
            else
            {
                @if (OnEdit.HasDelegate)
                {
                    <button type="button"
                            class="btn btn-outline-primary btn-touch w-100 mb-2"
                            disabled="@IsBusy"
                            @onclick="() => OnEdit.InvokeAsync(Store)">
                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>
                        Editar loja
                    </button>
                }
                <button type="button"
                        class="btn btn-outline-danger btn-touch"
                        disabled="@IsBusy"
                        @onclick="RequestDelete">
                    <i class="bi bi-plug me-1" aria-hidden="true"></i>Desconectar loja
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MarketplaceAccountDto Store { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback<MarketplaceAccountDto> OnUnlink { get; set; }
    [Parameter] public EventCallback<MarketplaceAccountDto> OnEdit { get; set; }

    private bool _confirmDelete;

    protected override Task OnInitializedAsync() => Clock.EnsureLoadedAsync();

    private string AffiliateIdDisplay
    {
        get
        {
            if (Store.RequiresTrackingIdCorrection)
            {
                return "inválido — informe o ID";
            }

            return string.IsNullOrWhiteSpace(Store.AffiliateTrackingId) ? "—" : Store.AffiliateTrackingId;
        }
    }

    private string GetPlatformLabel() => Store.PlatformType switch
    {
        MarketplaceType.TikTokShop => "TikTok Shop",
        MarketplaceType.Shopee => "Shopee",
        MarketplaceType.MercadoLivre => "Mercado Livre",
        MarketplaceType.Amazon => "Amazon",
        MarketplaceType.MagazineLuiza => "Magazine Luiza",
        MarketplaceType.Kabum => "Kabum!",
        MarketplaceType.CasasBahia => "Casas Bahia",
        _ => Store.PlatformType.ToString()
    };

    private string GetPlatformBadgeClass() =>
        PlatformBadgeHelper.GetPlatformBadgeClass(Store.PlatformType);

    /// <summary>Lojas Universal Link não dependem de token: validade de um OAuth antigo não as torna expiradas.</summary>
    private MarketplaceIntegrationStatus EffectiveStatus =>
        Store.Status == MarketplaceIntegrationStatus.Expired && Store.PlatformType.IsUniversalAffiliatePlatform()
            ? MarketplaceIntegrationStatus.Active
            : Store.Status;

    private string GetStatusLabel() => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "Ativo",
        MarketplaceIntegrationStatus.Expired => "Expirado",
        MarketplaceIntegrationStatus.Inactive => "Inativo",
        _ => Store.Status.ToString()
    };

    private string GetStatusBadgeClass() => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "text-bg-success",
        MarketplaceIntegrationStatus.Expired => "text-bg-warning",
        MarketplaceIntegrationStatus.Inactive => "text-bg-secondary",
        _ => "text-bg-secondary"
    };

    private void RequestDelete() => _confirmDelete = true;

    private void CancelDelete() => _confirmDelete = false;

    private async Task ConfirmarDesconexaoAsync(MarketplaceAccountDto account)
    {
        try
        {
            Console.WriteLine($"[MarketplaceStoreCard] Sim, desconectar accountId={account.Id} shop={account.ShopId}");
            await OnUnlink.InvokeAsync(account);
            _confirmDelete = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR] ConfirmarDesconexaoAsync accountId={account.Id}: {ex.Message} - {ex.StackTrace}");
            throw;
        }
    }
}
