{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet list *)",
      "Bash(dotnet --info)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git grep *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(dotnet add *)",
      "Bash(dotnet remove *)",
      "Bash(dotnet ef database update *)",
      "Bash(dotnet ef migrations remove *)",
      "Bash(npm install *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker compose *)",
      "Bash(docker rm *)",
      "Edit(./**/Migrations/**)",
      "Edit(./Directory.Build.props)",
      "Edit(./.editorconfig)",
      "Edit(./.github/**)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker volume rm *)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose * down -v*)",
      "Bash(docker system prune *)",
      "Bash(dotnet ef database drop *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/secrets.json)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.bak)",
      "Read(~/.microsoft/usersecrets/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
