@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ISystemCommunicationApiService MenuApi
@implements IDisposable

<nav class="portal-sidebar-nav" aria-label="Menu principal">
    <AuthorizeView>
        <Authorized>
            @if (MasterAccess.IsMasterView(context.User))
            {
                <a href="@MasterRoutes.Dashboard" class="portal-nav-link portal-nav-parent" @onclick="NotifyNavigate">
                    <i class="bi bi-shield-shaded portal-nav-icon" aria-hidden="true"></i>
                    <span class="portal-nav-link-label">Painel Master</span>
                </a>
            }

            @{ var afterCategory = false; }
            @foreach (var node in _menu)
            {
                if (IsCategory(node))
                {
                    <div class="portal-nav-category" role="heading" aria-level="2">@node.Title</div>
                    @foreach (var parent in node.Children)
                    {
                        @ParentItem(parent)
                    }
                    afterCategory = true;
                    continue;
                }

                if (afterCategory)
                {
                    <hr class="portal-nav-divider" />
                    afterCategory = false;
                }

                @ParentItem(node)
            }

            @if (MasterAccess.IsMasterView(context.User))
            {
                <div class="portal-nav-category" role="heading" aria-level="2">Roadmap (visão master)</div>
                <div class="portal-nav-group">
                    <button type="button"
                            class="portal-nav-link portal-nav-parent portal-nav-group-toggle @ProximosActiveClass"
                            aria-expanded="@isProximosOpen"
                            @onclick="ToggleProximosSubmenu"
                            @onclick:preventDefault="true"
                            @onclick:stopPropagation="true">
                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-rocket-takeoff portal-nav-icon" aria-hidden="true"></i>
                            <span class="portal-nav-link-label">Próximos Desenvolvimentos</span>
                        </span>
                        <i class="bi bi-chevron-down portal-nav-caret transform transition-transform duration-200 @(isProximosOpen ? "rotate-180" : "")"
                           aria-hidden="true"></i>
                    </button>
                    @if (isProximosOpen)
                    {
                        <div class="portal-nav-collapse portal-nav-submenu block transition-all">
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/dashboard#campanhas" @onclick="NotifyNavigate">
                                <i class="bi bi-megaphone portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Campanhas</span>
                            </NavLink>
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/dashboard#metricas" @onclick="NotifyNavigate">
                                <i class="bi bi-graph-up portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Métricas / Comissões</span>
                            </NavLink>
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/engajamento/fila" @onclick="NotifyNavigate">
                                <i class="bi bi-inbox portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Fila de engajamento</span>
                                <span class="portal-nav-soon">Em breve</span>
                            </NavLink>
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/conciliacao/financeira" @onclick="NotifyNavigate">
                                <i class="bi bi-cash-stack portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Conciliação financeira</span>
                            </NavLink>
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/propaganda/produtos" @onclick="NotifyNavigate">
                                <i class="bi bi-tag portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Produtos propaganda</span>
                            </NavLink>
                            <NavLink class="portal-nav-link portal-nav-sublink" href="/saude/painel" @onclick="NotifyNavigate">
                                <i class="bi bi-heart-pulse portal-nav-icon" aria-hidden="true"></i>
                                <span class="portal-nav-link-label">Saúde do sistema</span>
                            </NavLink>
                        </div>
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <a href="/" class="portal-nav-link @GetActiveClass("/")" @onclick="NotifyNavigate">
                <i class="bi bi-box-arrow-in-right portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">Entrar</span>
            </a>
            <a href="/recuperar-senha" class="portal-nav-link @GetActiveClass("/recuperar-senha")" @onclick="NotifyNavigate">
                <i class="bi bi-key portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">Recuperar senha</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
    <a href="/" class="portal-nav-link @GetActiveClass("/")" @onclick="NotifyNavigate">
        <i class="bi bi-house portal-nav-icon" aria-hidden="true"></i>
        <span class="portal-nav-link-label">Início</span>
    </a>
</nav>

@code {
    private const string DefaultOpenGroup = "integracoes.links";

    private static readonly Dictionary<string, string[]> RouteAliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["/marketplace-accounts"] = ["/minhas-lojas", "/account/integrations", "/integracoes/lojas"],
        ["/gerador-links"] = ["/comissao/gerar"],
        ["/minha-conta"] = ["/account/security"],
        ["/integracoes/conexoes"] = ["/integracoes/whatsapp", "/integracoes/telegram"],
        ["/integracoes/whatsapp/grupos/monitorados"] = ["/integracoes/grupos/monitorados"]
    };

    private static readonly string[] ProximosExactPaths =
    [
        "/engajamento/fila",
        "/conciliacao/financeira",
        "/propaganda/produtos",
        "/saude/painel"
    ];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ClientMenuNodeDto> _menu = [];
    private readonly HashSet<string> _openGroups = new(StringComparer.OrdinalIgnoreCase) { DefaultOpenGroup };
    private bool isProximosOpen;
    private string? _proximosRouteWhenOpened;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        SyncProximosDesenvolvimentosFromRoute();

        var user = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            var result = await MenuApi.ClientMenuAsync();
            _menu = result.Success && result.Data is { Count: > 0 } ? result.Data : DefaultMenuCatalog.BuildDefaultTree();
        }

        OpenGroupsForCurrentPath();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        OpenGroupsForCurrentPath();
        if (IsProximosPath() && !string.Equals(_proximosRouteWhenOpened, CurrentPath(), StringComparison.OrdinalIgnoreCase))
        {
            isProximosOpen = true;
            _proximosRouteWhenOpened = CurrentPath();
        }
        else if (!IsProximosPath())
        {
            _proximosRouteWhenOpened = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenGroupsForCurrentPath()
    {
        foreach (var group in AllNodes(_menu).Where(node => !IsCategory(node) && IsGroupActive(node)))
        {
            _openGroups.Add(group.Key);
        }
    }

    private static IEnumerable<ClientMenuNodeDto> AllNodes(IEnumerable<ClientMenuNodeDto> nodes) =>
        nodes.SelectMany(node => AllNodes(node.Children).Prepend(node));

    /// <summary>Raiz sem rota = categoria (cabeçalho); os filhos dela são os menus pai.</summary>
    private bool IsCategory(ClientMenuNodeDto node) =>
        string.IsNullOrWhiteSpace(node.Route) && node.Children.Count > 0 && _menu.Contains(node);

    private RenderFragment ParentItem(ClientMenuNodeDto node) => __builder =>
    {
        if (node.Children.Count == 0)
        {
            <a href="@node.Route" class="portal-nav-link portal-nav-parent @GetActiveClass(node.Route)" @onclick="NotifyNavigate">
                <i class="bi @node.Icon portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">@node.Title</span>
            </a>
            return;
        }

        var open = _openGroups.Contains(node.Key);
        <div class="portal-nav-group">
            <button type="button"
                    class="portal-nav-link portal-nav-parent portal-nav-group-toggle @(IsGroupActive(node) ? "active" : string.Empty)"
                    aria-expanded="@open"
                    @onclick="() => ToggleGroup(node.Key)">
                <i class="bi @node.Icon portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">@node.Title</span>
                <i class="bi bi-chevron-down portal-nav-caret transform transition-transform @(open ? "rotate-180" : string.Empty)" aria-hidden="true"></i>
            </button>
            @if (open)
            {
                <div class="portal-nav-submenu">
                    @foreach (var child in node.Children)
                    {
                        <a href="@child.Route" class="portal-nav-link portal-nav-sublink @GetActiveClass(child.Route)" @onclick="NotifyNavigate">
                            <i class="bi @child.Icon portal-nav-icon" aria-hidden="true"></i>
                            <span class="portal-nav-link-label">@child.Title</span>
                        </a>
                    }
                </div>
            }
        </div>
    };

    private void SyncProximosDesenvolvimentosFromRoute()
    {
        if (!IsProximosPath())
        {
            return;
        }

        isProximosOpen = true;
        _proximosRouteWhenOpened = CurrentPath();
    }

    private void ToggleGroup(string key)
    {
        if (!_openGroups.Remove(key))
        {
            _openGroups.Add(key);
        }
    }

    private void ToggleProximosSubmenu()
    {
        isProximosOpen = !isProximosOpen;
        if (isProximosOpen && IsProximosPath())
        {
            _proximosRouteWhenOpened = CurrentPath();
        }
    }

    private async Task NotifyNavigate()
    {
        try
        {
            await Js.InvokeVoidAsync("tecFlowAppInterop.closeSidebar");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private bool IsGroupActive(ClientMenuNodeDto group) =>
        group.Children.Any(child => IsRouteActive(child.Route) || IsGroupActive(child));

    private bool IsProximosPath()
    {
        var current = CurrentPath();
        return ProximosExactPaths.Any(path => current.Equals(path, StringComparison.OrdinalIgnoreCase))
            || current.StartsWith("/conciliacao/", StringComparison.OrdinalIgnoreCase);
    }

    private string ProximosActiveClass => IsProximosPath() ? "active" : string.Empty;

    private string CurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrEmpty(relative) ? "/" : "/" + relative.Split('?', '#')[0];
    }

    private bool IsRouteActive(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return false;
        }

        var current = CurrentPath();
        return current.Equals(route, StringComparison.OrdinalIgnoreCase)
            || (RouteAliases.TryGetValue(route, out var aliases)
                && aliases.Any(alias => current.Equals(alias, StringComparison.OrdinalIgnoreCase)));
    }

    private string GetActiveClass(string? route) => IsRouteActive(route) ? "active" : string.Empty;
}
