@page "/integracoes/telegram/agendador"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Services.Integrations
@inject ITelegramIntegrationApiService TelegramApi

<PageTitle>Agendador Telegram — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Disparo para canal/grupo</h1>
            <p class="text-muted small mb-0">
                Monte a oferta e agende a publicação no ChatId cadastrado. Use [LINK_COMISSAO] para o último link gerado.
            </p>
        </div>
        <a href="/integracoes/telegram" class="btn btn-outline-secondary btn-touch">Conexão</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small" role="status">@_info</div>
    }

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">Nova campanha</h2>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="tg-title">Título</label>
                <input id="tg-title" class="form-control" value="@_title" @oninput="e => _title = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="tg-message">Mensagem</label>
                <textarea id="tg-message"
                          class="form-control"
                          rows="4"
                          @oninput="e => _message = e.Value?.ToString() ?? string.Empty">@_message</textarea>
                <div class="form-text">Tag suportada: <code>@("[LINK_COMISSAO]")</code></div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="tg-image">URL da imagem (opcional)</label>
                <input id="tg-image" class="form-control" value="@_imageUrl" @oninput="e => _imageUrl = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="tg-when">Data e hora</label>
                    <input id="tg-when" type="datetime-local" class="form-control" value="@_scheduledLocal" @oninput="e => _scheduledLocal = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="tg-chat">ChatId do canal/grupo</label>
                    <input id="tg-chat" class="form-control" value="@_chatId" @oninput="e => _chatId = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>
            <button type="button" class="btn btn-success" disabled="@_isBusy" @onclick="ScheduleAsync">
                Agendar publicação
            </button>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Agendado</th>
                            <th>ChatId</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_campaigns.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted small px-3 py-3">Nenhuma campanha ainda.</td>
                            </tr>
                        }
                        @foreach (var item in _campaigns)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td><span class="badge @StatusClass(item.Status)">@item.UiStatusLabel</span></td>
                                <td class="small">@item.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small font-monospace">@item.TargetChatId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly List<TelegramBroadcastCampaignDto> _campaigns = [];
    private string _title = string.Empty;
    private string _message = "Oferta TecFlow [LINK_COMISSAO]";
    private string _imageUrl = string.Empty;
    private string _chatId = string.Empty;
    private string _scheduledLocal = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
    private bool _isBusy;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await TelegramApi.ListCampaignsAsync();
        _campaigns.Clear();
        _campaigns.AddRange(response.Data?.Campaigns ?? []);
        if (string.IsNullOrWhiteSpace(_chatId))
        {
            _chatId = response.Data?.DefaultChatId ?? string.Empty;
        }
    }

    private async Task ScheduleAsync()
    {
        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            DateTime? when = null;
            if (DateTime.TryParse(_scheduledLocal, out var parsed))
            {
                when = DateTime.SpecifyKind(parsed, DateTimeKind.Local);
            }

            var response = await TelegramApi.ScheduleCampaignAsync(new TelegramScheduleCampaignDto
            {
                Title = _title,
                MessageText = _message,
                ImageUrl = _imageUrl,
                TargetChatId = _chatId,
                ScheduledAt = when
            });
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível agendar.";
                return;
            }

            _info = response.Data.Descricao;
            _campaigns.Clear();
            _campaigns.AddRange(response.Data.Campaigns);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string StatusClass(string status) =>
        status switch
        {
            TelegramBroadcastStatuses.Completed => "text-bg-success",
            TelegramBroadcastStatuses.Failed => "text-bg-danger",
            TelegramBroadcastStatuses.Processing => "text-bg-warning",
            _ => "text-bg-secondary"
        };
}
