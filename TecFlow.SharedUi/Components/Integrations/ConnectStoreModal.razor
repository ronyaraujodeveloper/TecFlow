@using System.Globalization
@using TecFlow.Business.Dto
@using TecFlow.Core.Enums
@using TecFlow.SharedUi.Services.Integrations
@inject IIntegracaoLojaApiService IntegracaoApi
@inject IJSRuntime JS
@inject ILogger<ConnectStoreModal> Logger

@if (Visible)
{
    <div class="modal fade show d-block marketplace-connect-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="connect-store-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h2 class="modal-title h5 fw-bold mb-1" id="connect-store-title">Conectar nova loja</h2>
                        <p class="text-muted small mb-0">
                            Shopee usa Universal Link (sem App Key / App Secret). Informe o apelido e, se quiser, o Tracking ID.
                        </p>
                    </div>
                    <button type="button" class="btn-close btn-touch" aria-label="Fechar" disabled="@_linking" @onclick="Close"></button>
                </div>

                <div class="modal-body pt-3">
                    @if (!string.IsNullOrWhiteSpace(DisplayError))
                    {
                        <div class="alert alert-danger py-2 small" role="alert">@DisplayError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Plataforma</label>
                        <div class="marketplace-platform-picker d-grid gap-2">
                            <button type="button"
                                    class="btn btn-touch marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.TikTokShop)"
                                    disabled="@_linking"
                                    @onclick="() => SelectPlatform(MarketplaceType.TikTokShop)">
                                <span class="marketplace-platform-badge marketplace-platform-badge--tiktok">TikTok Shop</span>
                            </button>
                            <button type="button"
                                    class="btn btn-touch marketplace-platform-option @GetPlatformOptionClass(MarketplaceType.Shopee)"
                                    disabled="@_linking"
                                    @onclick="() => SelectPlatform(MarketplaceType.Shopee)">
                                <span class="marketplace-platform-badge marketplace-platform-badge--shopee">Shopee</span>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="friendly-name">Apelido / nome amigável</label>
                        <input id="friendly-name"
                               type="text"
                               class="form-control"
                               maxlength="256"
                               placeholder="Ex.: Loja principal SP"
                               @bind="_friendlyName"
                               @bind:event="oninput"
                               disabled="@_linking" />
                    </div>

                    @if (_platform == MarketplaceType.Shopee)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="tracking-id">ID de afiliado / Tracking ID (opcional)</label>
                            <input id="tracking-id"
                                   type="text"
                                   class="form-control"
                                   maxlength="128"
                                   placeholder="Usado no sub_id do Universal Link"
                                   autocomplete="off"
                                   @bind="_trackingId"
                                   @bind:event="oninput"
                                   disabled="@_linking" />
                        </div>
                    }
                    else
                    {
                        <details class="marketplace-manual-link small" open>
                            <summary class="text-muted mb-2">Vinculação manual (homologação / callback simulado)</summary>
                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label" for="auth-code">Authorization code</label>
                                    <input id="auth-code"
                                           name="authorizationCode"
                                           type="text"
                                           class="form-control form-control-sm"
                                           placeholder="code_teste"
                                           autocomplete="off"
                                           @bind="_authorizationCode"
                                           @bind:event="oninput"
                                           disabled="@_linking" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="shop-id">Shop ID</label>
                                    <input id="shop-id"
                                           name="shopId"
                                           type="text"
                                           class="form-control form-control-sm"
                                           inputmode="numeric"
                                           placeholder="123456"
                                           autocomplete="off"
                                           @bind="_shopId"
                                           @bind:event="oninput"
                                           disabled="@_linking" />
                                </div>
                            </div>
                        </details>
                    }
                </div>

                <div class="modal-footer border-0 flex-column flex-sm-row gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-touch w-100 w-sm-auto" disabled="@_linking" @onclick="Close">
                        Cancelar
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-touch w-100 w-sm-auto"
                            @onclick="VincularManualmenteDirect">
                        @(_linking ? "Salvando..." : (_platform == MarketplaceType.Shopee ? "Salvar conta Shopee" : "Vincular manualmente"))
                    </button>
                    @if (_platform != MarketplaceType.Shopee)
                    {
                        <button type="button" class="btn btn-outline-primary btn-touch w-100 w-sm-auto" disabled="@_linking" @onclick="StartOAuthAsync">
                            @(_linking ? "Redirecionando..." : "Conectar via OAuth")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(MarketplaceType Platform, string FriendlyName)> OnStartOAuth { get; set; }
    [Parameter] public EventCallback OnLojaVinculada { get; set; }

    private MarketplaceType _platform = MarketplaceType.Shopee;
    private string _friendlyName = string.Empty;
    private string _trackingId = string.Empty;
    private string _authorizationCode = string.Empty;
    private string _shopId = string.Empty;
    private string? _formError;
    private bool _linking;

    private string? DisplayError => ErrorMessage ?? _formError;

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            ResetForm();
        }
    }

    private void SelectPlatform(MarketplaceType platform)
    {
        _platform = platform;
        _formError = null;
    }

    private string GetPlatformOptionClass(MarketplaceType platform) =>
        _platform == platform ? "marketplace-platform-option--selected" : string.Empty;

    private async Task Close()
    {
        if (_linking)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task StartOAuthAsync()
    {
        var friendlyName = await ReadInputAsync("friendly-name", _friendlyName);
        if (string.IsNullOrWhiteSpace(friendlyName))
        {
            _formError = "Informe um apelido para identificar a loja.";
            return;
        }

        await OnStartOAuth.InvokeAsync((_platform, friendlyName.Trim()));
    }

    private async Task VincularManualmenteDirect()
    {
        try
        {
            var friendlyName = (await ReadInputAsync("friendly-name", _friendlyName)).Trim();
            var trackingId = (await ReadInputAsync("tracking-id", _trackingId)).Trim();
            var authorizationCode = (await ReadInputAsync("auth-code", _authorizationCode)).Trim();
            var shopIdInput = (await ReadInputAsync("shop-id", _shopId)).Trim();

            if (string.IsNullOrWhiteSpace(friendlyName))
            {
                _formError = "Informe um apelido para identificar a loja.";
                return;
            }

            if (_platform == MarketplaceType.Shopee)
            {
                _friendlyName = friendlyName;
                _trackingId = trackingId;
                _formError = null;
                _linking = true;

                var shopeeResponse = await IntegracaoApi.LinkAsync(new IntegracaoLojaDto
                {
                    PlatformType = MarketplaceType.Shopee,
                    FriendlyName = _friendlyName,
                    TrackingId = string.IsNullOrWhiteSpace(_trackingId) ? null : _trackingId,
                    ShopId = _trackingId
                });

                if (shopeeResponse.Status)
                {
                    await OnLojaVinculada.InvokeAsync();
                    return;
                }

                _formError = string.IsNullOrWhiteSpace(shopeeResponse.Descricao)
                    ? "Não foi possível vincular a loja."
                    : shopeeResponse.Descricao;
                return;
            }

            if (string.IsNullOrWhiteSpace(authorizationCode))
            {
                authorizationCode = ConnectStoreManualLinkForm.HomologDefaultAuthorizationCode;
            }

            if (!long.TryParse(
                    shopIdInput,
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out var shopIdParsed)
                || shopIdParsed <= 0)
            {
                shopIdParsed = ConnectStoreManualLinkForm.HomologDefaultShopId;
            }

            _friendlyName = friendlyName;
            _authorizationCode = authorizationCode;
            _shopId = shopIdParsed.ToString(CultureInfo.InvariantCulture);
            _formError = null;
            _linking = true;

            Console.WriteLine("[DEBUG BLAZOR] Clique detectado, enviando requisição...");

            var response = await IntegracaoApi.LinkAsync(new IntegracaoLojaDto
            {
                PlatformType = _platform,
                FriendlyName = _friendlyName,
                AuthorizationCode = _authorizationCode,
                ShopId = _shopId
            });

            if (response.Status)
            {
                await OnLojaVinculada.InvokeAsync();
                return;
            }

            _formError = string.IsNullOrWhiteSpace(response.Descricao)
                ? "Não foi possível vincular a loja."
                : response.Descricao;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
            Logger.LogError(ex, "Erro ao vincular loja manualmente.");
            _formError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Erro inesperado ao vincular loja."
                : ex.Message;
        }
        finally
        {
            _linking = false;
        }
    }

    private async Task<string> ReadInputAsync(string elementId, string boundValue)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("tecFlowAppInterop.getInputValueById", elementId);
            if (!string.IsNullOrWhiteSpace(raw))
            {
                return raw;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
        }

        return boundValue ?? string.Empty;
    }

    private void ResetForm()
    {
        _platform = MarketplaceType.Shopee;
        _friendlyName = string.Empty;
        _trackingId = string.Empty;
        _authorizationCode = string.Empty;
        _shopId = string.Empty;
        _formError = null;
        _linking = false;
    }
}
