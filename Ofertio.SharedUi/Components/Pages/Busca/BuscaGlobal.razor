@page "/busca"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ofertio.Business.Dto
@using Ofertio.Business.Service.LinkStrategies
@using Ofertio.Business.Service.Radar
@using Ofertio.Core.Enums
@using Ofertio.Database.Filter
@using Ofertio.SharedUi.Helpers
@using Ofertio.SharedUi.Services.Integrations
@using Ofertio.SharedUi.Services.LinkGenerator
@using Ofertio.SharedUi.Services.Radar
@inject IOfficialCatalogSearchApiService SearchApi
@inject IIntegracaoLojaApiService IntegracaoApi
@inject IAffiliateLinkApiService AffiliateLinkApi
@inject IOfferRadarApiService RadarApi
@inject NavigationManager Navigation
@inject ILogger<BuscaGlobal> Logger

<PageTitle>Buscar Ofertas — Ofertio</PageTitle>

<div class="dashboard-page">
    <div class="text-center mb-4">
        <h1 class="h3 fw-bold mb-1">Buscar Ofertas</h1>
        <p class="text-muted small mb-1">Consulta paralela nas APIs oficiais do Mercado Livre, Shopee e Amazon.</p>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _showRules = true">
            ⓘ Como funciona a busca e as regras
        </button>
    </div>

    <form class="col-12 col-lg-8 mx-auto mb-4 px-0" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
        <div class="input-group input-group-lg">
            <input class="form-control" placeholder="Ex: notebook 16GB, fone bluetooth..." @bind="_keyword" />
            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Buscar
            </button>
        </div>
        <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
            <div class="form-check">
                <input id="busca-ml" class="form-check-input" type="checkbox" @bind="_ml" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-ml">Mercado Livre</label>
            </div>
            <div class="form-check">
                <input id="busca-shopee" class="form-check-input" type="checkbox" @bind="_shopee" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-shopee">Shopee</label>
            </div>
            <div class="form-check">
                <input id="busca-amazon" class="form-check-input" type="checkbox" @bind="_amazon" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-amazon">Amazon</label>
            </div>
            <div class="form-check">
                <input id="busca-cupom" class="form-check-input" type="checkbox" @bind="_couponOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-cupom">Apenas com cupom</label>
            </div>
            <div class="form-check">
                <input id="busca-frete" class="form-check-input" type="checkbox" @bind="_freeShippingOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-frete">Somente frete grátis</label>
            </div>
            <div class="form-check">
                <input id="busca-oficial" class="form-check-input" type="checkbox" @bind="_officialOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-oficial">Somente loja oficial</label>
            </div>
            <div class="form-check">
                <input id="busca-confiavel" class="form-check-input" type="checkbox" @bind="_trustedOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-confiavel">Somente vendedores confiáveis</label>
            </div>
            <div class="form-check">
                <input id="busca-mais-vendidos" class="form-check-input" type="checkbox" @bind="_bestSellersOnly" @bind:after="ApplyScreenFilters" />
                <label class="form-check-label" for="busca-mais-vendidos">Somente mais vendidos</label>
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-min">Preço mín.</label>
                <input id="busca-min" class="form-control" type="number" step="0.01" min="0" @bind="_minPrice" @bind:after="ApplyScreenFilters" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-max">Preço máx.</label>
                <input id="busca-max" class="form-control" type="number" step="0.01" min="0" @bind="_maxPrice" @bind:after="ApplyScreenFilters" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-ordem">Ordenar por</label>
                <select id="busca-ordem" class="form-select" @bind="_sortBy" @bind:after="ApplyScreenFilters">
                    <option value="@OfficialCatalogSearchRules.SortBestOpportunity">Melhor vantagem + segurança</option>
                    <option value="@OfficialCatalogSearchRules.SortBestSellers">Mais vendidos</option>
                    <option value="@OfficialCatalogSearchRules.SortHighestCommission">Maior comissão</option>
                    <option value="@OfficialCatalogSearchRules.SortBestRating">Melhor avaliação</option>
                    <option value="@OfficialCatalogSearchRules.SortLowestPrice">Menor preço</option>
                    <option value="@OfficialCatalogSearchRules.SortBiggestDiscount">Maior desconto</option>
                    <option value="@OfficialCatalogSearchRules.SortRelevance">Relevância da loja</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold" for="busca-categoria">Categoria (Mercado Livre)</label>
                <select id="busca-categoria" class="form-select" @bind="_mlCategory" @bind:after="ApplyScreenFilters" disabled="@(_categories.Count == 0)">
                    <option value="">@(_categories.Count == 0 ? "Busque para sugerir" : "Todas")</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small">@_info</div>
    }
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="alert alert-info py-2 small">@_notice</div>
    }

    @if (_searched && _channels.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3" aria-label="Status da busca por loja">
            @foreach (var channel in _channels.Where(item => item.Included))
            {
                <span class="badge rounded-pill @ChannelBadgeClass(channel.State) px-3 py-2 d-inline-flex align-items-center gap-2">
                    <span>
                        @ChannelGlyph(channel.State)
                        <span class="fw-semibold">@channel.Label:</span>
                        @ChannelDisplayMessage(channel)
                    </span>
                    @if (NeedsMercadoLivreConnect(channel))
                    {
                        <button type="button"
                                class="btn btn-sm btn-dark"
                                @onclick="GoToMercadoLivreConnect">
                            Conectar
                        </button>
                    }
                </span>
            }
        </div>
    }

    @if (_searched && _relevanceOrder.Count > 0 && _items.Count != _relevanceOrder.Count)
    {
        <p class="small text-muted text-center mb-3">
            Mostrando @_items.Count de @_relevanceOrder.Count resultados carregados. Os filtros alterados valem só para o que está na tela;
            clique em <strong>Buscar</strong> para consultar as lojas de novo com eles.
        </p>
    }
    @if (_searched && !_busy && _relevanceOrder.Count > 0 && _items.Count == 0)
    {
        <div class="alert alert-light border">Nenhum resultado carregado atende aos filtros. Ajuste os filtros ou clique em Buscar para consultar as lojas de novo.</div>
    }
    else if (_searched && !_busy && _relevanceOrder.Count == 0)
    {
        <div class="alert alert-light border">Nenhum produto retornado. Confira as lojas marcadas e as chaves da Amazon/Shopee.</div>
    }
    @if (_items is { Count: > 0 })
    {
        var metrics = OfficialCatalogSearchRules.BuildMetrics(_items);
        <section class="card border-0 shadow-sm mb-4" aria-label="Métricas da busca">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-3">Métricas das @metrics.Count ofertas na tela</h2>
                <div class="row g-3 small">
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Faixa de preço</div>
                        <div class="fw-semibold">@ProductMetadataHtmlParser.FormatBrl(metrics.MinPrice) – @ProductMetadataHtmlParser.FormatBrl(metrics.MaxPrice)</div>
                        <div class="text-muted">Mediana @ProductMetadataHtmlParser.FormatBrl(metrics.MedianPrice)</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Segurança</div>
                        <div class="fw-semibold">@metrics.TrustedSellerPercent% vendedores confiáveis</div>
                        <div class="text-muted">@metrics.OfficialStorePercent% loja oficial · @metrics.FreeShippingPercent% frete grátis</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Avaliação média</div>
                        <div class="fw-semibold">@(metrics.AverageRating is { } averageRating ? $"⭐ {averageRating:0.0}" : "não informada")</div>
                        <div class="text-muted">@(metrics.TotalSoldKnown is { } totalSold ? $"{totalSold:N0} vendidos (informados)" : "vendas não informadas pela API")</div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="text-muted">Maior comissão estimada</div>
                        <div class="fw-semibold">@(metrics.TopCommission is { } top ? ProductMetadataHtmlParser.FormatBrl(top.EstimatedCommission) : "—")</div>
                        <div class="text-muted">
                            @if (metrics.TopCommission is null)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => _showRules = true">Informe sua taxa</button>
                            }
                            else
                            {
                                @Shorten(metrics.TopCommission.ProductName)
                            }
                        </div>
                    </div>
                </div>
                <div class="row g-2 mt-2 small">
                    @if (metrics.BestOpportunity is { } best)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-success me-1">🏅 Melhor oportunidade</span>@Shorten(best.ProductName) · @ProductMetadataHtmlParser.FormatBrl(best.Price)</div>
                    }
                    @if (metrics.BestSeller is { } seller)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-warning me-1">🏆 Mais vendido</span>@Shorten(seller.ProductName) · @ProductMetadataHtmlParser.FormatBrl(seller.Price)</div>
                    }
                    @if (metrics.Cheapest is { } cheapest)
                    {
                        <div class="col-12 col-lg-4"><span class="badge text-bg-info me-1">💲 Menor preço</span>@Shorten(cheapest.ProductName) · @ProductMetadataHtmlParser.FormatBrl(cheapest.Price)</div>
                    }
                </div>
            </div>
        </section>
        <div class="row g-3">
            @foreach (var item in _items)
            {
                var platform = item.PlatformType ?? MarketplaceType.Shopee;
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex gap-3 mb-3">
                                <div class="product-image-preview-box product-image-preview-box--sm">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" class="product-image-preview-img" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="product-image-preview-placeholder">Sem imagem</span>
                                    }
                                </div>
                                <div>
                                    <span class="badge rounded-pill @PlatformBadgeHelper.GetPlatformBadgeClass(item.Platform)"
                                          style="background-color: @PlatformBadgeHelper.GetPlatformColor(item.Platform); color: @(platform == MarketplaceType.MercadoLivre ? "#000000" : "#FFFFFF");">
                                        @PlatformBadgeHelper.GetPlatformLabel(item.Platform, item.PlatformType)
                                    </span>
                                    <span class="badge text-bg-light">@item.Source</span>
                                    @if (!string.IsNullOrWhiteSpace(item.CouponCode))
                                    {
                                        <span class="badge text-bg-warning">@item.CouponCode</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge @OpportunityBadgeClass(item.OpportunityScore)" title="Média de vantagem e segurança">Oportunidade @item.OpportunityScore</span>
                                <span class="badge text-bg-light border" title="Desconto, frete, comissão, avaliação e vendas">Vantagem @item.AdvantageScore</span>
                                <span class="badge text-bg-light border" title="Loja oficial, reputação, MercadoLíder, Full, garantia e condição">Segurança @OfficialCatalogSearchRules.SafetyLabel(item.SafetyScore)</span>
                            </div>
                            <h2 class="h6">@(item.ProductName ?? "Produto")</h2>
                            <p class="fw-semibold mb-1">
                                @ProductMetadataHtmlParser.FormatBrl(item.Price)
                                @if (item.OriginalPrice > item.Price)
                                {
                                    <small class="text-muted text-decoration-line-through ms-1">@ProductMetadataHtmlParser.FormatBrl(item.OriginalPrice)</small>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Shipping))
                            {
                                <p class="small text-muted mb-1">@item.Shipping</p>
                            }
                            <ul class="list-unstyled small mb-2">
                                <li>
                                    💰
                                    @if (item.EstimatedCommission is > 0)
                                    {
                                        <span>Comissão estimada <strong>@ProductMetadataHtmlParser.FormatBrl(item.EstimatedCommission)</strong> (@($"{item.CommissionPercent:0.##}")%, @item.CommissionSource)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Comissão: informe sua taxa nas regras</span>
                                    }
                                </li>
                                <li>
                                    ⭐
                                    @if (item.RatingAverage is { } rating)
                                    {
                                        <span>@($"{rating:0.0}") @(item.RatingCount is > 0 ? $"({item.RatingCount:N0} avaliações)" : string.Empty)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sem avaliações informadas</span>
                                    }
                                </li>
                                <li>
                                    🛒
                                    @if (item.SoldQuantity is { } sold)
                                    {
                                        <span>@($"{sold:N0}") vendidos</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Vendas não informadas pela API</span>
                                    }
                                    @if (item.BestSellerPosition is { } position)
                                    {
                                        <span class="badge text-bg-warning ms-1">🏆 @(position)º mais vendido da categoria</span>
                                    }
                                </li>
                                @if (!string.IsNullOrWhiteSpace(item.SellerName) || item.SellerReputationLevel is not null || item.IsOfficialStore)
                                {
                                    <li>
                                        🏪 @(item.SellerName ?? "Vendedor")
                                        @if (OfficialCatalogSearchRules.ReputationLabel(item.SellerReputationLevel) is { } reputation)
                                        {
                                            <span class="text-muted">· @reputation</span>
                                        }
                                        @if (item.SellerCompletedSales is > 0)
                                        {
                                            <span class="text-muted">· @($"{item.SellerCompletedSales:N0}") vendas concluídas</span>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (item.Highlights.Count > 0 || item.Warnings.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var highlight in item.Highlights)
                                    {
                                        <span class="badge rounded-pill text-bg-success">@highlight</span>
                                    }
                                    @foreach (var warning in item.Warnings)
                                    {
                                        <span class="badge rounded-pill text-bg-danger">⚠ @warning</span>
                                    }
                                </div>
                            }
                            <button type="button"
                                    class="btn btn-primary mt-auto"
                                    disabled="@(_busy || _convertingUrl == item.SourceUrl)"
                                    @onclick="() => ConvertAsync(item)">
                                Converter &amp; Gerar Link
                            </button>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
    @if (_searched && _mlNextOffset is not null)
    {
        <div class="text-center mt-4">
            <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="LoadMoreMercadoLivreAsync">
                Carregar mais (Mercado Livre)
            </button>
        </div>
    }
</div>

@if (_searching)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-loading-title" aria-busy="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center py-4">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status" aria-hidden="true"></div>
                    <h2 id="busca-loading-title" class="h6 fw-bold mb-1">Buscando ofertas...</h2>
                    <p class="small text-muted mb-0">
                        Consultando @_searchingStores nas APIs oficiais. Isso pode levar alguns segundos.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_showRules)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="busca-regras-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h2 id="busca-regras-title" class="modal-title h5">Como funciona a Buscar Ofertas</h2>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => _showRules = false"></button>
                </div>
                <div class="modal-body small">
                    <h3 class="h6 fw-bold">Suas configurações</h3>
                    <ul class="mb-3">
                        @if (_storeSummaries.Count == 0)
                        {
                            <li>Nenhuma loja conectada em <strong>Minhas Lojas</strong>: o Mercado Livre exige a conta conectada (OAuth) para buscar.</li>
                        }
                        @foreach (var store in _storeSummaries)
                        {
                            <li><strong>@store.Platform</strong> — @store.Detail</li>
                        }
                        <li>ID de afiliado do Mercado Livre (<code>matt_tool</code>) nos links: <strong>@(string.IsNullOrWhiteSpace(_mlTrackingId) ? "não configurado (usa o padrão do sistema)" : _mlTrackingId)</strong></li>
                    </ul>

                    <h3 class="h6 fw-bold">Sua comissão</h3>
                    <p class="mb-2">
                        A Shopee informa a comissão de cada oferta pela API. O Mercado Livre e a Amazon não expõem a taxa de afiliado por API:
                        informe a sua taxa média (consulte o painel de afiliado de cada loja) para estimarmos a comissão por produto.
                    </p>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-semibold" for="taxa-ml">Mercado Livre (%)</label>
                            <input id="taxa-ml" class="form-control form-control-sm" type="number" step="0.1" min="0" max="90" @bind="_mlCommissionPercent" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold" for="taxa-amazon">Amazon (%)</label>
                            <input id="taxa-amazon" class="form-control form-control-sm" type="number" step="0.1" min="0" max="90" @bind="_amazonCommissionPercent" />
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-sm btn-primary w-100" disabled="@_savingRates" @onclick="SaveCommissionRatesAsync">Salvar</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_ratesMessage))
                    {
                        <p class="small text-muted mb-3">@_ratesMessage</p>
                    }

                    <h3 class="h6 fw-bold">Métricas e notas de cada oferta</h3>
                    <ul class="mb-3">
                        <li><strong>Vendidos, avaliações e mais vendidos:</strong> vêm das APIs oficiais (ML: anúncio, avaliações e ranking de mais vendidos da categoria; Shopee: vendas e nota). Quando a loja não informa, o card mostra "não informado".</li>
                        <li><strong>Vantagem (0–100):</strong> desconto (até 35), frete grátis (10), comissão (até 20), avaliação (até 15), ranking de mais vendidos (até 20) e unidades vendidas (até 10).</li>
                        <li><strong>Segurança:</strong> parte de 30 e soma loja oficial (+30), reputação verde do vendedor (+25), MercadoLíder (até +15), envio Full (+10), garantia (+5) e alta aprovação (+5); reputação ruim, produto usado e muitas avaliações negativas descontam. Alta a partir de @OfficialCatalogSearchRules.TrustedSafetyScore.</li>
                        <li><strong>Oportunidade:</strong> média de vantagem e segurança; é a ordenação padrão "Melhor vantagem + segurança".</li>
                        <li>O painel "Métricas" resume as ofertas na tela: faixa e mediana de preço, % de vendedores confiáveis, nota média, maior comissão, melhor oportunidade e mais vendido.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Onde buscamos</h3>
                    <ul class="mb-3">
                        <li>Somente as APIs oficiais das lojas; páginas públicas não são lidas.</li>
                        <li><strong>Mercado Livre:</strong> catálogo oficial com a sua conta conectada. Só aparecem produtos de catálogo com anúncio ativo e preço.</li>
                        <li><strong>Shopee:</strong> exige a chave de API de afiliado. <strong>Amazon:</strong> exige a PA-API configurada.</li>
                        <li><strong>Base Local (Grupos):</strong> ofertas já capturadas nos seus grupos que contêm o termo (até @OfficialCatalogSearchRules.MaxLimit).</li>
                    </ul>

                    <h3 class="h6 fw-bold">Regras do Mercado Livre</h3>
                    <ul class="mb-3">
                        <li>A busca analisa o catálogo em páginas de @OfficialCatalogSearchRules.MercadoLivreScanPageSize produtos até juntar cerca de @OfficialCatalogSearchRules.MaxLimit ofertas ou analisar @OfficialCatalogSearchRules.MercadoLivreMaxScannedProducts produtos.</li>
                        <li>Muitos produtos de catálogo não têm anúncio ativo; o selo mostra quantos foram analisados e quantos tinham oferta.</li>
                        <li>Produtos "família" (ex.: um modelo com várias configurações) trazem até @OfficialCatalogSearchRules.MercadoLivreMaxChildrenPerProduct variações com oferta.</li>
                        <li>Sem nenhuma oferta, a busca tenta sozinha um termo mais curto (remove as últimas palavras) e avisa o termo usado.</li>
                        <li><strong>Carregar mais</strong> continua a análise de onde parou, só no Mercado Livre.</li>
                        <li><strong>Categoria</strong> é sugerida a partir do termo depois da primeira busca e volta a "Todas" quando o termo muda.</li>
                        <li>A API do Mercado Livre não informa cupons: "Apenas com cupom" esconde os resultados do Mercado Livre.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Filtros</h3>
                    <ul class="mb-3">
                        <li><strong>Buscar</strong> consulta as lojas com o termo e todos os filtros marcados (preço, frete grátis, categoria).</li>
                        <li>Mudar um filtro depois da busca (lojas, preço, frete grátis, cupom, loja oficial, vendedores confiáveis, mais vendidos, categoria ou ordenação) filtra <strong>só o que já está na tela</strong>, sem nova consulta.</li>
                        <li>Para trazer produtos que ainda não foram carregados com o novo filtro, clique em <strong>Buscar</strong> de novo.</li>
                        <li>Ordenação: melhor vantagem + segurança, mais vendidos, maior comissão, melhor avaliação, menor preço, maior desconto ou relevância da loja.</li>
                    </ul>

                    <h3 class="h6 fw-bold">Links de afiliado</h3>
                    <ul class="mb-0">
                        <li><strong>Converter &amp; Gerar Link</strong> usa a loja da plataforma cadastrada em Minhas Lojas; sem ela, o link não é convertido.</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="() => _showRules = false">Entendi</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private string _keyword = string.Empty;
    private bool _ml = true;
    private bool _shopee = true;
    private bool _amazon = true;
    private bool _couponOnly;
    private bool _freeShippingOnly;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private string _sortBy = OfficialCatalogSearchRules.SortBestOpportunity;
    private bool _officialOnly;
    private bool _trustedOnly;
    private bool _bestSellersOnly;
    private decimal? _mlCommissionPercent;
    private decimal? _amazonCommissionPercent;
    private bool _savingRates;
    private string? _ratesMessage;
    private string? _mlCategory;
    private List<OfficialCatalogCategoryDto> _categories = [];
    private string? _categoriesKeyword;
    private bool _busy;
    private bool _searching;
    private string _searchingStores = "as lojas";
    private bool _searched;
    private string? _error;
    private string? _info;
    private string? _notice;
    private string? _convertingUrl;
    private List<OfficialCatalogProductDto> _items = [];
    private List<OfficialCatalogProductDto> _relevanceOrder = [];
    private List<OfficialCatalogChannelStatusDto> _channels = [];
    private OfficialCatalogSearchFilter? _lastFilter;
    private int? _mlNextOffset;
    private string? _mlEffectiveQuery;
    private string? _mlTrackingId;
    private bool _showRules;
    private List<(string Platform, string Detail)> _storeSummaries = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadMercadoLivreTrackingIdAsync(), LoadCommissionRatesAsync());
    }

    private async Task LoadCommissionRatesAsync()
    {
        try
        {
            var result = await RadarApi.GetProfileAsync();
            if (result.Success && result.Data?.Profile is { } profile)
            {
                _mlCommissionPercent = profile.MercadoLivreCommissionPercent;
                _amazonCommissionPercent = profile.AmazonCommissionPercent;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível carregar as taxas de comissão do perfil.");
        }
    }

    private async Task SaveCommissionRatesAsync()
    {
        _savingRates = true;
        _ratesMessage = null;
        try
        {
            var current = await RadarApi.GetProfileAsync();
            if (!current.Success || current.Data?.Profile is not { } profile)
            {
                _ratesMessage = current.ErrorMessage ?? "Não foi possível carregar o seu perfil para salvar as taxas.";
                return;
            }

            profile.MercadoLivreCommissionPercent = OfficialCatalogSearchRules.NormalizeCommissionPercent(_mlCommissionPercent);
            profile.AmazonCommissionPercent = OfficialCatalogSearchRules.NormalizeCommissionPercent(_amazonCommissionPercent);
            var saved = await RadarApi.SaveProfileAsync(profile);
            if (!saved.Success || saved.Data?.Profile is not { } updated)
            {
                _ratesMessage = saved.ErrorMessage ?? "Não foi possível salvar as taxas.";
                return;
            }

            _mlCommissionPercent = updated.MercadoLivreCommissionPercent;
            _amazonCommissionPercent = updated.AmazonCommissionPercent;
            foreach (var item in _relevanceOrder.Where(item => item.CommissionSource != "API Shopee"))
            {
                item.CommissionPercent = null;
                item.EstimatedCommission = null;
                item.CommissionSource = null;
                OfficialCatalogSearchRules.ApplyCommission(item, _mlCommissionPercent, _amazonCommissionPercent);
                OfficialCatalogSearchRules.ScoreOffer(item);
            }

            ApplyScreenFilters();
            _ratesMessage = "Taxas salvas no seu perfil; as comissões da tela foram recalculadas.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao salvar as taxas de comissão.");
            _ratesMessage = "Falha ao salvar as taxas.";
        }
        finally
        {
            _savingRates = false;
        }
    }

    private static string Shorten(string? text, int max = 60) =>
        string.IsNullOrWhiteSpace(text) ? "Produto" : text.Length <= max ? text : text[..max].TrimEnd() + "…";

    private static string OpportunityBadgeClass(int score) =>
        score >= 70 ? "text-bg-success" : score >= 45 ? "text-bg-warning" : "text-bg-secondary";

    private async Task LoadMercadoLivreTrackingIdAsync()
    {
        try
        {
            var response = await IntegracaoApi.ListAsync();
            _storeSummaries = (response.DataList ?? [])
                .Where(item => item.Status != MarketplaceIntegrationStatus.Inactive)
                .Select(item => (PlatformDisplayName(item.PlatformType), DescribeStore(item)))
                .ToList();
            var store = response.DataList?
                .Where(item => item.Status != MarketplaceIntegrationStatus.Inactive
                    && OfficialCatalogSearchRules.MatchesMercadoLivreAccount(
                        item.PlatformType,
                        item.FriendlyName,
                        item.ShopName))
                .Select(item => OfficialCatalogSearchRules.ResolveMercadoLivreAffiliateId(
                    item.TrackingId,
                    item.AffiliateTrackingId))
                .FirstOrDefault(id => !string.IsNullOrWhiteSpace(id));
            _mlTrackingId = store;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível carregar o TrackingId do Mercado Livre para a busca.");
        }
    }

    private static string PlatformDisplayName(MarketplaceType platform) => platform switch
    {
        MarketplaceType.MercadoLivre => "Mercado Livre",
        _ => platform.ToString()
    };

    private static string DescribeStore(MarketplaceAccountDto store)
    {
        var name = string.IsNullOrWhiteSpace(store.FriendlyName) ? store.ShopName : store.FriendlyName;
        var status = store.Status == MarketplaceIntegrationStatus.Expired ? "expirada" : "ativa";
        var detail = string.IsNullOrWhiteSpace(name) ? $"loja {status}" : $"{name} ({status})";
        if (store.PlatformType == MarketplaceType.MercadoLivre)
        {
            detail += store.HasOAuthToken
                ? " · busca autorizada (OAuth)"
                : " · sem OAuth: conecte a conta para buscar no Mercado Livre";
        }

        return detail;
    }

    private OfficialCatalogSearchFilter CurrentFilter() => new()
    {
        Keyword = _keyword?.Trim() ?? string.Empty,
        MinPrice = _minPrice,
        MaxPrice = _maxPrice,
        HasCoupon = _couponOnly ? true : null,
        FreeShippingOnly = _freeShippingOnly ? true : null,
        SortBy = _sortBy,
        MercadoLivre = _ml,
        MercadoLivreTrackingId = _mlTrackingId,
        MercadoLivreCategory = string.IsNullOrWhiteSpace(_mlCategory) ? null : _mlCategory,
        OfficialStoreOnly = _officialOnly ? true : null,
        TrustedSellersOnly = _trustedOnly ? true : null,
        BestSellersOnly = _bestSellersOnly ? true : null,
        Shopee = _shopee,
        Amazon = _amazon
    };

    private void ApplyScreenFilters() =>
        _items = [.. OfficialCatalogSearchRules.ApplySort(
            OfficialCatalogSearchRules.FilterLoadedResults(_relevanceOrder, CurrentFilter()),
            _sortBy)];

    private static string ChannelGlyph(string? state) => state switch
    {
        "ok" => "🟢",
        "missing" => "⚠️",
        "error" => "❌",
        _ => "⚪"
    };

    private static string ChannelBadgeClass(string? state) => state switch
    {
        "ok" => "text-bg-success",
        "missing" => "text-bg-warning text-dark",
        "error" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static bool NeedsMercadoLivreConnect(OfficialCatalogChannelStatusDto channel) =>
        string.Equals(channel.Key, "MercadoLivre", StringComparison.OrdinalIgnoreCase)
        && channel.State is "missing";

    private static string ChannelDisplayMessage(OfficialCatalogChannelStatusDto channel)
    {
        if (NeedsMercadoLivreConnect(channel))
        {
            return OfficialCatalogSearchRules.MercadoLivreMissingAccountMessage;
        }

        return channel.Message;
    }

    private void GoToMercadoLivreConnect() =>
        Navigation.NavigateTo("/minhas-lojas?conectar=mercadolivre");

    private string SelectedStoresLabel()
    {
        var stores = new List<string>();
        if (_ml)
        {
            stores.Add("Mercado Livre");
        }

        if (_shopee)
        {
            stores.Add("Shopee");
        }

        if (_amazon)
        {
            stores.Add("Amazon");
        }

        return stores.Count switch
        {
            0 => "as lojas",
            1 => stores[0],
            _ => string.Join(", ", stores.Take(stores.Count - 1)) + " e " + stores[^1]
        };
    }

    private async Task SearchAsync()
    {
        if (_searching)
        {
            return;
        }

        var keyword = _keyword?.Trim() ?? string.Empty;
        if (!string.Equals(keyword, _categoriesKeyword, StringComparison.OrdinalIgnoreCase))
        {
            _mlCategory = null;
            _categories = [];
        }

        _busy = true;
        _searching = true;
        _searchingStores = SelectedStoresLabel();
        _error = null;
        _info = null;
        _notice = null;
        _channels = [];
        _items = [];
        _relevanceOrder = [];
        _mlNextOffset = null;
        _mlEffectiveQuery = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var filter = CurrentFilter();
            var result = await SearchApi.SearchAsync(filter);
            _searched = true;
            _lastFilter = filter;
            if (!result.Success || result.Data is null)
            {
                _items = [];
                _error = result.ErrorMessage ?? "Não foi possível consultar as lojas oficiais.";
                return;
            }

            _relevanceOrder = [.. result.Data.DataList ?? []];
            ApplyScreenFilters();
            _channels = result.Data.Channels ?? [];
            ApplyMercadoLivreScan(result.Data, keyword);
            if (result.Data.MercadoLivreCategories.Count > 0)
            {
                _categories = result.Data.MercadoLivreCategories;
                _categoriesKeyword = keyword;
            }

            if (_items.Count > 0)
            {
                _error = null;
            }
            else
            {
                var channelError = _channels.FirstOrDefault(item =>
                    string.Equals(item.State, "error", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(item.Message));
                if (channelError is not null)
                {
                    _error = channelError.Message;
                }
                else if (!result.Data.Status && !string.IsNullOrWhiteSpace(result.Data.Descricao))
                {
                    _error = result.Data.Descricao;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha na busca omnichannel.");
            _error = string.IsNullOrWhiteSpace(ex.Message) ? "Falha inesperada na busca." : ex.Message;
            _items = [];
        }
        finally
        {
            _busy = false;
            _searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyMercadoLivreScan(OfficialCatalogSearchResponseDto response, string typedKeyword)
    {
        _mlNextOffset = response.MercadoLivreNextOffset;
        _mlEffectiveQuery = response.MercadoLivreEffectiveQuery;
        if (!string.IsNullOrWhiteSpace(_mlEffectiveQuery)
            && !string.Equals(_mlEffectiveQuery.Trim(), typedKeyword, StringComparison.OrdinalIgnoreCase))
        {
            _notice = $"Nenhuma oferta ativa no Mercado Livre para \"{typedKeyword}\"; mostrando resultados para \"{_mlEffectiveQuery.Trim()}\".";
        }
    }

    private async Task LoadMoreMercadoLivreAsync()
    {
        if (_searching || _lastFilter is null || _mlNextOffset is not int offset)
        {
            return;
        }

        _busy = true;
        _searching = true;
        _searchingStores = "mais produtos do Mercado Livre";
        _error = null;
        _info = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await SearchApi.SearchAsync(new OfficialCatalogSearchFilter
            {
                Keyword = string.IsNullOrWhiteSpace(_mlEffectiveQuery) ? _lastFilter.Keyword : _mlEffectiveQuery,
                MinPrice = _lastFilter.MinPrice,
                MaxPrice = _lastFilter.MaxPrice,
                HasCoupon = _lastFilter.HasCoupon,
                FreeShippingOnly = _lastFilter.FreeShippingOnly,
                SortBy = _sortBy,
                MercadoLivre = true,
                MercadoLivreTrackingId = _lastFilter.MercadoLivreTrackingId,
                MercadoLivreCategory = _lastFilter.MercadoLivreCategory,
                MercadoLivreOffset = offset,
                Shopee = false,
                Amazon = false
            });
            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Não foi possível carregar mais ofertas do Mercado Livre.";
                return;
            }

            var known = _relevanceOrder
                .Select(item => item.SourceUrl.Trim())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var added = (result.Data.DataList ?? [])
                .Where(item => known.Add(item.SourceUrl.Trim()))
                .ToList();
            _relevanceOrder.AddRange(added);
            ApplyScreenFilters();
            _mlNextOffset = result.Data.MercadoLivreNextOffset;

            var mlChannel = result.Data.Channels?.FirstOrDefault(item =>
                string.Equals(item.Key, "MercadoLivre", StringComparison.OrdinalIgnoreCase));
            if (mlChannel is not null)
            {
                _channels = [.. _channels.Select(item =>
                    string.Equals(item.Key, "MercadoLivre", StringComparison.OrdinalIgnoreCase) ? mlChannel : item)];
                if (mlChannel.State is "error")
                {
                    _error = mlChannel.Message;
                }
            }

            _info = added.Count == 0
                ? "Nenhuma oferta nova nesta página do Mercado Livre."
                : $"{added.Count} nova(s) oferta(s) do Mercado Livre carregada(s).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao carregar mais ofertas do Mercado Livre.");
            _error = string.IsNullOrWhiteSpace(ex.Message) ? "Falha inesperada na busca." : ex.Message;
        }
        finally
        {
            _busy = false;
            _searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConvertAsync(OfficialCatalogProductDto item)
    {
        if (string.IsNullOrWhiteSpace(item.SourceUrl))
        {
            return;
        }

        _convertingUrl = item.SourceUrl;
        _busy = true;
        _error = null;
        _info = null;
        try
        {
            var result = await AffiliateLinkApi.GenerateAsync(new GerarLinkAfiliadoDto
            {
                OriginalUrl = item.SourceUrl,
                Source = "Gerador",
                SourceGroup = "Busca omnichannel",
                CustomNickname = item.ProductName
            });
            if (result.Success && result.Data is not null)
            {
                result.Data.NormalizeHttp200();
            }

            if (result.Success && result.Data is { HasConvertedLink: true })
            {
                var link = string.IsNullOrWhiteSpace(result.Data.ShortenedUrl)
                    ? result.Data.AffiliateUrl
                    : result.Data.ShortenedUrl;
                _info = $"Link gerado: {link}";
            }
            else
            {
                _error = result.Data?.Descricao
                    ?? result.ErrorMessage
                    ?? "Não foi possível converter. Cadastre a loja da plataforma em Minhas Lojas.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao converter da busca. Url={Url}", item.SourceUrl);
            _error = "Falha ao gerar o link de afiliado.";
        }
        finally
        {
            _convertingUrl = null;
            _busy = false;
        }
    }
}
