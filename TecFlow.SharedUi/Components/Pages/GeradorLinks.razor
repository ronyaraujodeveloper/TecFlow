@page "/gerador-links"
@page "/comissao/gerar"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Business.Service.LinkStrategies
@using TecFlow.Core.Enums
@using TecFlow.SharedUi.Components.LinkGenerator
@using TecFlow.SharedUi.Helpers
@using TecFlow.SharedUi.Services.LinkGenerator
@inject IIntegracaoLojaApiService IntegracaoApi
@inject IAffiliateLinkApiService AffiliateLinkApi
@inject IActiveStoreScopeService StoreScope
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ILogger<GeradorLinks> Logger
@implements IDisposable

<PageTitle>Gerador de Links de Comissão — TecFlow</PageTitle>

<div class="link-generator-page dashboard-page">
    <header class="link-generator-hero text-center mb-4">
        <span class="brand-badge mb-3">Comissões</span>
        <h1 class="h3 fw-bold mb-2">Gerador de Links de Comissão</h1>
        <p class="text-muted small mb-0 mx-auto link-generator-lead">
            Cole o link do produto e gere sua URL encurtada com rastreio TecFlow.
        </p>
    </header>

    <section id="link-generator-form" class="link-generator-card card border-0 shadow-sm mx-auto">
        <div class="card-body p-3 p-md-4">
            <form @onsubmit="GenerateLinkAsync" @onsubmit:preventDefault="true">
            <label class="form-label fw-semibold" for="product-url">
                Link do produto
            </label>

            <div class="link-generator-input-wrap @GetInputWrapClass()">
                <input id="product-url"
                       class="form-control form-control-lg link-generator-input"
                       placeholder="Cole aqui o link do produto da Shopee, TikTok, Amazon, Magalu, Kabum! ou Casas Bahia..."
                       value="@_productUrl"
                       @oninput="HandleUrlInput"
                       @onblur="HandleUrlBlur"
                       disabled="@_isLoading"
                       autocomplete="off"
                       inputmode="url"
                       aria-invalid="@(_feedbackIsError ? "true" : "false")" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_detectionHint))
            {
                <p class="link-generator-hint @(_detectedPlatform is not null ? "text-success" : "text-muted") small mt-2 mb-0"
                   role="status">
                    @_detectionHint
                </p>
            }

            @if (_detectedPlatform is { IsBackendReady: true } && AccountsForDetectedPlatform.Count > 0)
            {
                <div class="link-generator-accounts mt-3" role="group" aria-label="Contas da plataforma">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <label class="form-label fw-semibold mb-0">Contas @_detectedPlatform.DisplayName</label>
                        <button type="button"
                                class="btn btn-link btn-sm p-0"
                                disabled="@_isLoading"
                                @onclick="ToggleSelectAllDetectedAccounts">
                            @(AreAllDetectedAccountsSelected() ? "Limpar seleção" : "Selecionar todas")
                        </button>
                    </div>
                    @foreach (var store in AccountsForDetectedPlatform)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@($"store-account-{store.Id}")"
                                   checked="@_selectedStoreIds.Contains(store.Id)"
                                   disabled="@_isLoading"
                                   @onchange="e => ToggleAccountSelection(store.Id, e)" />
                            <label class="form-check-label" for="@($"store-account-{store.Id}")">
                                @(string.IsNullOrWhiteSpace(store.FriendlyName) ? store.ShopId : store.FriendlyName)
                            </label>
                        </div>
                    }
                </div>
            }

            <div class="link-generator-actions mt-4">
                <button type="submit"
                        class="btn btn-primary btn-lg btn-touch w-100 link-generator-submit"
                        disabled="@(_isLoading || string.IsNullOrWhiteSpace(_productUrl))"
                        aria-busy="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Gerando link...</span>
                    }
                    else
                    {
                        <span>Gerar Link de Comissão</span>
                    }
                </button>
            </div>

            @if (_needsConnectAccount && _detectedPlatform is not null)
            {
                <div class="alert alert-warning py-2 small mt-3 mb-0" role="alert">
                    ⚠️ Você ainda não tem uma conta da @_detectedPlatform.DisplayName conectada.
                    <a href="/minhas-lojas" class="alert-link fw-semibold">Clique aqui para conectar sua loja</a>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_feedbackMessage) && _feedbackIsError)
            {
                <div class="alert alert-danger py-2 small mt-3 mb-0" role="alert">
                    @_feedbackMessage
                    @if (_feedbackIsMissingAccount)
                    {
                        <span>
                            <a href="/minhas-lojas" class="alert-link fw-semibold">Clique aqui para conectar sua loja</a>
                        </span>
                    }
                </div>
            }
            </form>
        </div>
    </section>

    <LinkGeneratorResultPanel Response="@_generatedResponse" />

    <HistoricoLinks RefreshToken="@_historyRefreshToken" OnVisualizar="VisualizarLink" OnEditar="AbrirEdicaoAsync" />

    @if (_editItem is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="edit-link-accounts-title">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                        <div>
                            <h2 class="modal-title h5 fw-bold mb-1" id="edit-link-accounts-title">Editar contas do link</h2>
                            <p class="text-muted small mb-0">Desmarcar uma conta inativa o vínculo e preserva o histórico de cliques.</p>
                        </div>
                        <button type="button" class="btn-close" aria-label="Fechar" @onclick="FecharEdicao"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <p class="small text-break mb-3">@_editItem.OriginalUrl</p>
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="fw-semibold small">Contas</span>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="ToggleSelectAllEditAccounts">
                                @(AreAllEditAccountsSelected() ? "Limpar seleção" : "Selecionar todas")
                            </button>
                        </div>
                        @foreach (var store in AccountsForEdit)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"edit-store-{store.Id}")"
                                       checked="@_editSelectedStoreIds.Contains(store.Id)"
                                       disabled="@_isSavingEdit"
                                       @onchange="e => ToggleEditAccountSelection(store.Id, e)" />
                                <label class="form-check-label" for="@($"edit-store-{store.Id}")">
                                    @(string.IsNullOrWhiteSpace(store.FriendlyName) ? store.ShopId : store.FriendlyName)
                                </label>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_editError))
                        {
                            <div class="alert alert-danger py-2 small mt-3 mb-0" role="alert">@_editError</div>
                        }
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary btn-touch" disabled="@_isSavingEdit" @onclick="FecharEdicao">Cancelar</button>
                        <button type="button" class="btn btn-primary btn-touch" disabled="@_isSavingEdit" @onclick="SalvarEdicaoAsync">
                            @(_isSavingEdit ? "Salvando..." : "Salvar contas")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    <section class="link-generator-platforms mt-4 mx-auto" aria-label="Marketplaces suportados">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
            <h2 class="h6 fw-semibold mb-0">Marketplaces suportados</h2>
            <a href="/minhas-lojas" class="btn btn-sm btn-outline-secondary btn-touch">
                Gerenciar integrações
            </a>
        </div>

        <div class="marketplace-chip-row" role="list">
            @foreach (var platform in MarketplaceUrlDetector.All)
            {
                <MarketplacePlatformChip Definition="platform"
                                           IsConnected="@IsPlatformConnected(platform)"
                                           IsDetected="@IsPlatformDetected(platform)" />
            }
        </div>

        <p class="text-muted small mt-3 mb-0 text-center text-sm-start">
            Logos coloridas indicam contas conectadas. Ao colar um link, a plataforma detectada recebe destaque imediato.
        </p>
    </section>
</div>

@code {
    private string _productUrl = string.Empty;
    private string? _detectionHint;
    private string? _feedbackMessage;
    private bool _feedbackIsError;
    private bool _feedbackIsMissingAccount;
    private bool _needsConnectAccount;
    private bool _isLoading;
    private bool _integrationsLoaded;
    private MarketplaceDefinition? _detectedPlatform;
    private GerarLinkAfiliadoResponseDto? _generatedResponse;
    private int _historyRefreshToken;
    private readonly HashSet<MarketplaceType> _connectedPlatforms = [];
    private readonly List<MarketplaceAccountDto> _stores = [];
    private readonly HashSet<int> _selectedStoreIds = [];
    private readonly HashSet<int> _editSelectedStoreIds = [];
    private ShortAffiliateLinkDto? _editItem;
    private string? _editError;
    private bool _isSavingEdit;

    private IReadOnlyList<MarketplaceAccountDto> AccountsForDetectedPlatform =>
        _detectedPlatform?.IntegrationType is { } platform
            ? _stores.Where(store => store.PlatformType == platform && store.Status == MarketplaceIntegrationStatus.Active).ToList()
            : [];

    private IReadOnlyList<MarketplaceAccountDto> AccountsForEdit =>
        _editItem is null
            ? []
            : _stores.Where(store => store.PlatformType == _editItem.PlatformType).ToList();

    private bool CanGenerate =>
        !_isLoading
        && _integrationsLoaded
        && _detectedPlatform is { IsBackendReady: true }
        && IsPlatformConnected(_detectedPlatform)
        && StoreScope.ActiveStoreId is > 0
        && ActiveStoreMatchesDetectedPlatform()
        && !string.IsNullOrWhiteSpace(_productUrl);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            StoreScope.OnStoreChanged += HandleStoreChanged;
            await StoreScope.EnsureInitializedAsync();
            await LoadIntegrationsAsync();
            AnalyzeUrl(_productUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
            Logger.LogError(ex, "Erro ao inicializar o gerador de links.");
            _feedbackIsError = true;
            _feedbackMessage = "Não foi possível carregar as lojas do gerador. Tente atualizar a página.";
            _integrationsLoaded = true;
        }
    }

    public void Dispose()
    {
        StoreScope.OnStoreChanged -= HandleStoreChanged;
    }

    private void HandleStoreChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadIntegrationsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadIntegrationsAsync()
    {
        _integrationsLoaded = false;

        try
        {
            var response = await IntegracaoApi.ListAsync();
            _connectedPlatforms.Clear();

            if (response.Status && response.DataList is { Count: > 0 })
            {
                _stores.Clear();
                _stores.AddRange(response.DataList);

                foreach (var store in response.DataList)
                {
                    if (store.Status == MarketplaceIntegrationStatus.Active)
                    {
                        _connectedPlatforms.Add(store.PlatformType);
                    }
                }

                var firstActive = response.DataList
                    .Where(store => store.Status == MarketplaceIntegrationStatus.Active)
                    .OrderByDescending(store => store.CreatedAt)
                    .FirstOrDefault()
                    ?? response.DataList.OrderByDescending(store => store.CreatedAt).First();

                if (!StoreScope.IsAllStoresScope && StoreScope.ActiveStoreId is null or <= 0)
                {
                    await StoreScope.SetActiveStoreAsync(firstActive);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar integrações para o gerador de links.");
            Console.WriteLine($"[ERRO BLAZOR]: {ex.Message} - {ex.StackTrace}");
            _feedbackIsError = true;
            _feedbackMessage = "Não foi possível carregar as lojas do gerador. Tente atualizar a página.";
        }
        finally
        {
            _integrationsLoaded = true;
        }
    }

    private void HandleUrlInput(ChangeEventArgs e)
    {
        _productUrl = e.Value?.ToString() ?? string.Empty;
        ClearGeneratedResult();
        AnalyzeUrl(_productUrl);
    }

    private void HandleUrlBlur(FocusEventArgs _) => AnalyzeUrl(_productUrl);

    private void AnalyzeUrl(string? url)
    {
        _detectedPlatform = MarketplaceUrlDetector.Detect(url);

        if (string.IsNullOrWhiteSpace(url))
        {
            _detectionHint = null;
            _needsConnectAccount = false;
            return;
        }

        if (_detectedPlatform is null)
        {
            _needsConnectAccount = false;
            _detectionHint = "Não reconhecemos este domínio. Use links de Shopee, TikTok Shop, Amazon, Mercado Livre, Magalu, Kabum! ou Casas Bahia.";
            return;
        }

        if (!_detectedPlatform.IsBackendReady)
        {
            _needsConnectAccount = false;
            _detectionHint = $"{_detectedPlatform.DisplayName} identificado. Integração em breve no TecFlow.";
            return;
        }

        if (!IsPlatformConnected(_detectedPlatform) || AccountsForDetectedPlatform.Count == 0)
        {
            _needsConnectAccount = true;
            _detectionHint = null;
            return;
        }

        _needsConnectAccount = false;
        _detectionHint = $"{_detectedPlatform.DisplayName} identificado com sucesso. Pronto para gerar comissão.";
        EnsureDetectedAccountsSelected();
    }

    private async Task GenerateLinkAsync()
    {
        ClearFeedback();
        ClearGeneratedResult();
        AnalyzeUrl(_productUrl);
        _isLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(_productUrl))
            {
                ShowError("Não foi possível converter este link. Verifique se uma loja está selecionada.");
                return;
            }

            if (_detectedPlatform is null)
            {
                ShowError("Não foi possível converter este link. Verifique se uma loja está selecionada.");
                return;
            }

            var selectedStores = ResolveStoresForGeneration();

            if (selectedStores.Count == 0)
            {
                _needsConnectAccount = true;
                ShowError(BuildMissingAccountMessage(_detectedPlatform.DisplayName));
                return;
            }

            var request = new GerarLinkAfiliadoDto
            {
                OriginalUrl = _productUrl.Trim(),
                StoreId = IntegracaoLojaScopeHelper.EncodeStoreScope(selectedStores[0].Id),
                StoreIds = selectedStores.Select(store => IntegracaoLojaScopeHelper.EncodeStoreScope(store.Id)).ToList(),
                TenantId = selectedStores[0].TenantId != Guid.Empty ? selectedStores[0].TenantId : null,
                ShopId = string.IsNullOrWhiteSpace(selectedStores[0].ShopId) ? null : selectedStores[0].ShopId
            };

            var result = await AffiliateLinkApi.GenerateAsync(request);

            if (result.Success && result.Data is not null)
            {
                result.Data.NormalizeHttp200();
            }

            if (result.Success && result.Data is { HasConvertedLink: true })
            {
                _generatedResponse = result.Data;
                _feedbackMessage = null;
                _feedbackIsError = false;
                _historyRefreshToken++;
                StateHasChanged();
                await ScrollToResultPanelAsync();
            }
            else
            {
                _generatedResponse = null;
                ShowError(ResolveConversionError(result.ErrorMessage, result.Data?.Message));
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Erro inesperado ao gerar link de comissão. OriginalUrl={OriginalUrl} StoreId={StoreId} ExceptionType={ExceptionType} Causa={Causa}",
                _productUrl,
                StoreScope.ActiveStoreId,
                ex.GetType().FullName,
                ex.ToString());
            ShowError(ResolveConversionError(ex.Message, null));
            StateHasChanged();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private IReadOnlyList<MarketplaceAccountDto> ResolveStoresForGeneration()
    {
        var platformStores = AccountsForDetectedPlatform;
        if (platformStores.Count == 0)
        {
            return [];
        }

        var selected = platformStores.Where(store => _selectedStoreIds.Contains(store.Id)).ToList();
        if (selected.Count > 0)
        {
            return selected;
        }

        if (StoreScope.IsAllStoresScope
            || StoreScope.ActiveStore is null
            || StoreScope.ActiveStore.PlatformType != _detectedPlatform?.IntegrationType)
        {
            EnsureDetectedAccountsSelected();
            return platformStores.Where(store => _selectedStoreIds.Contains(store.Id)).DefaultIfEmpty(platformStores[0]).ToList();
        }

        var scoped = platformStores.FirstOrDefault(store => store.Id == StoreScope.ActiveStoreId);
        return scoped is null ? [platformStores[0]] : [scoped];
    }

    private static string BuildMissingAccountMessage(string platformName) =>
        $"⚠️ Você ainda não tem uma conta da {platformName} conectada.";

    private bool IsPlatformConnected(MarketplaceDefinition platform) =>
        platform.IntegrationType is { } integrationType && _connectedPlatforms.Contains(integrationType);

    private bool IsPlatformDetected(MarketplaceDefinition platform) =>
        _detectedPlatform?.Key == platform.Key;

    private bool ActiveStoreMatchesDetectedPlatform()
    {
        if (_detectedPlatform?.IntegrationType is not { } expectedType)
        {
            return false;
        }

        return StoreScope.ActiveStore?.PlatformType == expectedType;
    }

    private string GetInputWrapClass()
    {
        if (_detectedPlatform is null || string.IsNullOrWhiteSpace(_productUrl))
        {
            return string.Empty;
        }

        return $"link-generator-input-wrap--{_detectedPlatform.CssClass.Replace("marketplace-chip--", string.Empty)}";
    }

    private void ClearFeedback()
    {
        _feedbackMessage = null;
        _feedbackIsError = false;
        _feedbackIsMissingAccount = false;
        _needsConnectAccount = false;
    }

    private void ClearGeneratedResult() => _generatedResponse = null;

    private async Task VisualizarLink(ShortAffiliateLinkDto item)
    {
        if (item is null)
        {
            return;
        }

        _productUrl = item.OriginalUrl?.Trim() ?? string.Empty;
        AnalyzeUrl(_productUrl);
        ClearFeedback();

        _generatedResponse = GerarLinkAfiliadoResponseDto.FromHistory(item);
        SyncSelectedStoresFromResponse(_generatedResponse);

        await InvokeAsync(StateHasChanged);
        await ScrollToFormAsync();
    }

    private Task AbrirEdicaoAsync(ShortAffiliateLinkDto item)
    {
        _editItem = item;
        _editError = null;
        _editSelectedStoreIds.Clear();
        foreach (var account in item.Accounts.Where(account => account.IsActive && account.StoreId > 0))
        {
            _editSelectedStoreIds.Add(account.StoreId);
        }

        if (_editSelectedStoreIds.Count == 0)
        {
            foreach (var store in AccountsForEdit.Where(store => store.Status == MarketplaceIntegrationStatus.Active))
            {
                _editSelectedStoreIds.Add(store.Id);
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    private void FecharEdicao()
    {
        _editItem = null;
        _editError = null;
        _isSavingEdit = false;
        _editSelectedStoreIds.Clear();
    }

    private async Task SalvarEdicaoAsync()
    {
        if (_editItem is null)
        {
            return;
        }

        var selectedStores = AccountsForEdit.Where(store => _editSelectedStoreIds.Contains(store.Id)).ToList();
        if (selectedStores.Count == 0)
        {
            _editError = "Selecione ao menos uma conta ou mantenha o histórico inativo apenas desmarcando após gerar novamente.";
            return;
        }

        _isSavingEdit = true;
        _editError = null;
        StateHasChanged();

        try
        {
            var request = new GerarLinkAfiliadoDto
            {
                OriginalUrl = _editItem.OriginalUrl.Trim(),
                StoreId = IntegracaoLojaScopeHelper.EncodeStoreScope(selectedStores[0].Id),
                StoreIds = selectedStores.Select(store => IntegracaoLojaScopeHelper.EncodeStoreScope(store.Id)).ToList(),
                TenantId = selectedStores[0].TenantId != Guid.Empty ? selectedStores[0].TenantId : null,
                ShopId = string.IsNullOrWhiteSpace(selectedStores[0].ShopId) ? null : selectedStores[0].ShopId
            };

            var result = await AffiliateLinkApi.GenerateAsync(request);
            if (result.Success && result.Data is not null)
            {
                result.Data.NormalizeHttp200();
            }

            if (result.Success && result.Data is { HasConvertedLink: true })
            {
                _generatedResponse = result.Data;
                _productUrl = result.Data.OriginalUrl;
                AnalyzeUrl(_productUrl);
                _historyRefreshToken++;
                FecharEdicao();
                await ScrollToResultPanelAsync();
            }
            else
            {
                _editError = ResolveConversionError(result.ErrorMessage, result.Data?.Message);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao atualizar contas do link de comissão.");
            _editError = "Não foi possível atualizar as contas. Tente novamente.";
        }
        finally
        {
            _isSavingEdit = false;
            StateHasChanged();
        }
    }

    private void ToggleAccountSelection(int storeId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool flag && flag || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isChecked)
        {
            _selectedStoreIds.Add(storeId);
        }
        else
        {
            _selectedStoreIds.Remove(storeId);
        }
    }

    private void ToggleEditAccountSelection(int storeId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool flag && flag || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isChecked)
        {
            _editSelectedStoreIds.Add(storeId);
        }
        else
        {
            _editSelectedStoreIds.Remove(storeId);
        }
    }

    private void ToggleSelectAllDetectedAccounts()
    {
        var accounts = AccountsForDetectedPlatform;
        if (AreAllDetectedAccountsSelected())
        {
            foreach (var store in accounts)
            {
                _selectedStoreIds.Remove(store.Id);
            }
        }
        else
        {
            foreach (var store in accounts)
            {
                _selectedStoreIds.Add(store.Id);
            }
        }
    }

    private void ToggleSelectAllEditAccounts()
    {
        var accounts = AccountsForEdit;
        if (AreAllEditAccountsSelected())
        {
            _editSelectedStoreIds.Clear();
        }
        else
        {
            foreach (var store in accounts)
            {
                _editSelectedStoreIds.Add(store.Id);
            }
        }
    }

    private bool AreAllDetectedAccountsSelected()
    {
        var accounts = AccountsForDetectedPlatform;
        return accounts.Count > 0 && accounts.All(store => _selectedStoreIds.Contains(store.Id));
    }

    private bool AreAllEditAccountsSelected()
    {
        var accounts = AccountsForEdit;
        return accounts.Count > 0 && accounts.All(store => _editSelectedStoreIds.Contains(store.Id));
    }

    private void EnsureDetectedAccountsSelected()
    {
        var accounts = AccountsForDetectedPlatform;
        if (accounts.Count == 0)
        {
            return;
        }

        if (!_selectedStoreIds.Overlaps(accounts.Select(store => store.Id)))
        {
            foreach (var store in accounts)
            {
                _selectedStoreIds.Add(store.Id);
            }
        }
    }

    private void SyncSelectedStoresFromResponse(GerarLinkAfiliadoResponseDto response)
    {
        foreach (var account in response.Accounts.Where(item => item.IsActive && item.StoreId > 0))
        {
            _selectedStoreIds.Add(account.StoreId);
        }
    }

    private async Task ScrollToFormAsync()
    {
        try
        {
            await Task.Delay(50);
            await Js.InvokeVoidAsync("tecFlowAppInterop.scrollIntoViewById", "link-generator-form", "start");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Não foi possível rolar até o formulário do gerador.");
            await ScrollToResultPanelAsync();
        }
    }

    private async Task ScrollToResultPanelAsync()
    {
        try
        {
            await Task.Delay(50);
            await Js.InvokeVoidAsync("tecFlowAppInterop.scrollIntoViewById", "link-generator-result");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Não foi possível rolar até o painel de resultados.");
        }
    }

    private void ShowError(string message)
    {
        _feedbackMessage = message;
        _feedbackIsError = true;
        _feedbackIsMissingAccount = message.Contains("ainda não tem uma conta", StringComparison.OrdinalIgnoreCase);
        _needsConnectAccount = _feedbackIsMissingAccount;
    }

    private string ResolveConversionError(string? apiMessage, string? dtoMessage)
    {
        var raw = FirstNonEmpty(apiMessage, dtoMessage);
        if (IsShopeeParseFailure(raw))
        {
            return ShopeeProductUrlParser.UnrecognizedLinkMessage;
        }

        return string.IsNullOrWhiteSpace(raw)
            ? "Não foi possível converter este link. Verifique se uma loja está selecionada."
            : raw;
    }

    private bool IsShopeeParseFailure(string? raw)
    {
        if (_detectedPlatform?.IntegrationType != MarketplaceType.Shopee)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(raw))
        {
            return true;
        }

        return raw.Contains("não reconhec", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("formato enviado", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("Formato de link da Shopee", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("ItemId", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("ShopId", StringComparison.OrdinalIgnoreCase);
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }
}
