@page "/integracoes/whatsapp/agendador"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using TecFlow.Business.Dto
@using TecFlow.Business.Service.WhatsApp
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Components.Integrations
@using TecFlow.SharedUi.Services.Integrations
@inject IWhatsAppIntegrationApiService WhatsAppApi
@inject IJSRuntime Js
@inject ILogger<WhatsAppAgendador> Logger

<PageTitle>Agendador WhatsApp — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Disparo para grupos</h1>
            <p class="text-muted small mb-0">
                Sincronize os grupos, escolha os destinos e agende a oferta com intervalo anti-bloqueio.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/integracoes/whatsapp" class="btn btn-outline-secondary btn-touch">Conexão</a>
            <button type="button" class="btn btn-primary btn-touch" disabled="@_isBusy" @onclick="SyncGroupsAsync">
                @(_isBusy ? "Sincronizando..." : "Sincronizar Meus Grupos do WhatsApp")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small" role="status">@_info</div>
    }

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">@(_editingId is null ? "Nova campanha" : "Editar campanha")</h2>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="wa-title">Título</label>
                <input id="wa-title" class="form-control" value="@_title" @oninput="e => _title = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="wa-message">Mensagem</label>
                <textarea id="wa-message"
                          class="form-control @(_messageUrlWarning is null ? string.Empty : "is-invalid")"
                          rows="4"
                          placeholder="Escreva somente o texto da oferta. URLs devem ir no campo Link de Comissão."
                          @oninput="OnMessageInput">@_message</textarea>
                @if (!string.IsNullOrWhiteSpace(_messageUrlWarning))
                {
                    <div class="invalid-feedback d-block">@_messageUrlWarning</div>
                }
                else
                {
                    <div class="form-text">Somente o copy da oferta. Não cole links neste campo.</div>
                }
            </div>
            <CommissionLinkPicker @ref="_linkPicker" OnLinkSelected="OnCommissionLinkSelected" />
            <div class="mb-3">
                <label class="form-label fw-semibold" for="wa-commission-link">Link de Comissão</label>
                <input id="wa-commission-link"
                       class="form-control font-monospace"
                       value="@_commissionLink"
                       @oninput="e => _commissionLink = e.Value?.ToString() ?? string.Empty" />
                <div class="form-text">O link selecionado será anexado automaticamente ao final da mensagem no momento do disparo.</div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="wa-image">URL da imagem (opcional)</label>
                <input id="wa-image" class="form-control" value="@_imageUrl" @oninput="e => _imageUrl = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="wa-when">Data e hora</label>
                    <input id="wa-when" type="datetime-local" class="form-control" value="@_scheduledLocal" @oninput="e => _scheduledLocal = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="wa-interval">Intervalo entre grupos</label>
                    <select id="wa-interval" class="form-select" value="@_interval" @onchange="OnIntervalChanged">
                        <option value="15">15 segundos</option>
                        <option value="30">30 segundos</option>
                        <option value="45">45 segundos</option>
                        <option value="60">60 segundos</option>
                    </select>
                </div>
            </div>

            @if (_groups.Count == 0)
            {
                <p class="text-muted small">Nenhum grupo sincronizado. Conecte o WhatsApp e clique em sincronizar.</p>
            }
            else
            {
                <WhatsAppGroupPicker @key="_pickerEpoch"
                                     Groups="_groups"
                                     Campaigns="_campaigns"
                                     SelectedJids="_selectedJids" />
            }

            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-success" disabled="@_isBusy" @onclick="ScheduleAsync">
                    @(_editingId is null ? "Agendar disparo" : "Salvar Alterações")
                </button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="CancelEditAsync">
                        Cancelar edição
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1" for="wa-page-size">Exibir registros</label>
                    <select id="wa-page-size" class="form-select form-select-sm" value="@_pageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1" for="wa-filter-status">Status</label>
                    <select id="wa-filter-status" class="form-select form-select-sm" value="@_statusFilter" @onchange="OnStatusFilterChanged">
                        <option value="">Todos</option>
                        <option value="@WhatsAppBroadcastStatuses.Pending">Pendente</option>
                        <option value="@WhatsAppBroadcastStatuses.Processing">Processando</option>
                        <option value="@WhatsAppBroadcastStatuses.Completed">Concluído</option>
                        <option value="@WhatsAppBroadcastStatuses.Failed">Falhou</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1" for="wa-filter-from">Data de (agendamento)</label>
                    <input id="wa-filter-from" type="date" class="form-control form-control-sm" value="@_filterFrom" @oninput="OnFilterFromInput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small mb-1" for="wa-filter-to">Data até</label>
                    <input id="wa-filter-to" type="date" class="form-control form-control-sm" value="@_filterTo" @oninput="OnFilterToInput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small mb-1" for="wa-filter-search">Busca (título ou grupo)</label>
                    <input id="wa-filter-search"
                           class="form-control form-control-sm"
                           placeholder="Filtrar por título ou nome do grupo"
                           value="@_searchText"
                           @oninput="OnSearchInput" />
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Status</th>
                        <th>Agendado</th>
                        <th>Intervalo</th>
                        <th>Grupos</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedCampaigns.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted small px-3 py-3">Nenhuma campanha ainda.</td>
                        </tr>
                    }
                    @foreach (var item in PagedCampaigns)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td><span class="badge @StatusClass(item.Status)">@item.UiStatusLabel</span></td>
                            <td class="small">@item.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.IntervalSeconds s</td>
                            <td>
                                <div class="campaign-groups-popover" tabindex="0">
                                    <button type="button" class="badge text-bg-light border text-dark">
                                        @item.TargetGroupJids.Count @(item.TargetGroupJids.Count == 1 ? "grupo" : "grupos")
                                    </button>
                                    <div class="campaign-groups-menu" role="tooltip">
                                        @if (item.TargetGroupNames.Count == 0)
                                        {
                                            <div class="text-muted">Nenhum grupo.</div>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var name in item.TargetGroupNames)
                                                {
                                                    <li>@name</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            title="Editar"
                                            aria-label="Editar"
                                            disabled="@(!item.CanEdit || _isBusy)"
                                            @onclick="() => BeginEditAsync(item)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            title="Excluir"
                                            aria-label="Excluir"
                                            disabled="@(!item.CanDelete || _isBusy)"
                                            @onclick="() => DeleteAsync(item)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
            <span class="small text-muted">
                @FilteredCount registro(s) • página @_pageIndex de @TotalPages
            </span>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" disabled="@(_pageIndex <= 1)" @onclick="PreviousPage">Anterior</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@(_pageIndex >= TotalPages)" @onclick="NextPage">Próxima</button>
            </div>
        </div>
    </section>
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50, 75, 100];
    private readonly List<WhatsAppGroupDto> _groups = [];
    private readonly List<WhatsAppBroadcastCampaignDto> _campaigns = [];
    private readonly HashSet<string> _selectedJids = new(StringComparer.OrdinalIgnoreCase);
    private CommissionLinkPicker? _linkPicker;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private string _commissionLink = string.Empty;
    private string? _messageUrlWarning;
    private string _imageUrl = string.Empty;
    private string _scheduledLocal = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
    private int _interval = WhatsAppBroadcastStatuses.DefaultIntervalSeconds;
    private bool _isBusy;
    private string? _error;
    private string? _info;
    private int? _editingId;
    private int _pickerEpoch;
    private int _pageSize = 10;
    private int _pageIndex = 1;
    private string _statusFilter = string.Empty;
    private string _filterFrom = string.Empty;
    private string _filterTo = string.Empty;
    private string _searchText = string.Empty;

    private IEnumerable<WhatsAppBroadcastCampaignDto> FilteredCampaigns
    {
        get
        {
            IEnumerable<WhatsAppBroadcastCampaignDto> query = _campaigns;
            if (!string.IsNullOrWhiteSpace(_statusFilter))
            {
                query = query.Where(item => item.Status == _statusFilter);
            }

            if (DateTime.TryParse(_filterFrom, out var from))
            {
                var start = from.Date;
                query = query.Where(item => item.ScheduledAt.ToLocalTime().Date >= start);
            }

            if (DateTime.TryParse(_filterTo, out var to))
            {
                var end = to.Date;
                query = query.Where(item => item.ScheduledAt.ToLocalTime().Date <= end);
            }

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim();
                query = query.Where(item =>
                    item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || item.TargetGroupNames.Any(name => name.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return query;
        }
    }

    private int FilteredCount => FilteredCampaigns.Count();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)_pageSize));

    private List<WhatsAppBroadcastCampaignDto> PagedCampaigns =>
        FilteredCampaigns.Skip((_pageIndex - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        StartPolling();
    }

    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        _ = PollLoopAsync();
    }

    private async Task PollLoopAsync()
    {
        if (_pollTimer is null || _pollCts is null)
        {
            return;
        }

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(_pollCts.Token))
            {
                await RefreshCampaignsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Falha no polling de campanhas WhatsApp.");
        }
    }

    private async Task LoadAsync()
    {
        var groups = await WhatsAppApi.ListGroupsAsync();
        _groups.Clear();
        _groups.AddRange(groups.Data?.Groups ?? []);
        await RefreshCampaignsAsync();
    }

    private async Task RefreshCampaignsAsync()
    {
        var campaigns = await WhatsAppApi.ListCampaignsAsync();
        _campaigns.Clear();
        _campaigns.AddRange(campaigns.Data?.Campaigns ?? []);
        ClampPage();
    }

    private async Task SyncGroupsAsync()
    {
        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            var response = await WhatsAppApi.SyncGroupsAsync();
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível sincronizar os grupos.";
                return;
            }

            _groups.Clear();
            _groups.AddRange(response.Data.Groups);
            _info = $"Grupos sincronizados: {_groups.Count}.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ScheduleAsync()
    {
        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            DateTime? when = null;
            if (DateTime.TryParse(_scheduledLocal, out var parsed))
            {
                when = DateTime.SpecifyKind(parsed, DateTimeKind.Local).ToUniversalTime();
            }

            var response = await WhatsAppApi.ScheduleCampaignAsync(new WhatsAppScheduleCampaignDto
            {
                Id = _editingId ?? 0,
                Title = _title,
                MessageText = _message,
                CommissionLinkUrl = _commissionLink,
                ImageUrl = _imageUrl,
                TargetGroupJids = _selectedJids.ToList(),
                ScheduledAt = when,
                IntervalSeconds = _interval
            });
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível agendar.";
                return;
            }

            _campaigns.Clear();
            _campaigns.AddRange(response.Data.Campaigns);
            ClampPage();
            _info = response.Data.Descricao ?? "Disparo agendado com sucesso.";
            await ResetFormAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task BeginEditAsync(WhatsAppBroadcastCampaignDto item)
    {
        if (!item.CanEdit)
        {
            _error = "Somente agendamentos pendentes podem ser editados.";
            return;
        }

        var (copy, link) = WhatsAppBroadcastRules.SplitDispatchMessage(item.MessageText);
        _editingId = item.Id;
        _title = item.Title;
        _message = copy;
        _commissionLink = string.IsNullOrWhiteSpace(item.CommissionLinkUrl) ? link : item.CommissionLinkUrl;
        _messageUrlWarning = null;
        _imageUrl = item.ImageUrl ?? string.Empty;
        _scheduledLocal = item.ScheduledAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
        _interval = WhatsAppBroadcastRules.ClampIntervalSeconds(item.IntervalSeconds);
        if (_interval is not 15 and not 30 and not 45 and not 60)
        {
            _interval = WhatsAppBroadcastStatuses.DefaultIntervalSeconds;
        }

        _selectedJids.Clear();
        foreach (var jid in item.TargetGroupJids)
        {
            _selectedJids.Add(jid);
        }

        _pickerEpoch++;
        _info = "Editando agendamento. Salve as alterações no formulário acima.";
        _error = null;
        await Task.CompletedTask;
    }

    private async Task CancelEditAsync()
    {
        await ResetFormAsync();
        _info = null;
    }

    private async Task DeleteAsync(WhatsAppBroadcastCampaignDto item)
    {
        if (!item.CanDelete)
        {
            _error = "Este agendamento não pode ser excluído.";
            return;
        }

        var confirmed = await Js.InvokeAsync<bool>("confirm", $"Excluir o agendamento \"{item.Title}\"?");
        if (!confirmed)
        {
            return;
        }

        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            var response = await WhatsAppApi.DeleteCampaignAsync(item.Id);
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível excluir.";
                return;
            }

            _campaigns.Clear();
            _campaigns.AddRange(response.Data.Campaigns);
            ClampPage();
            if (_editingId == item.Id)
            {
                await ResetFormAsync();
            }

            _info = response.Data.Descricao ?? "Agendamento excluído.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnMessageInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        if (WhatsAppBroadcastRules.ContainsHttpUrl(value))
        {
            _messageUrlWarning = "A mensagem deve conter só o texto da oferta. URLs vão no campo Link de Comissão.";
            _message = WhatsAppBroadcastRules.StripHttpUrls(value);
            return;
        }

        _messageUrlWarning = null;
        _message = value;
    }

    private Task OnCommissionLinkSelected(string url)
    {
        _commissionLink = url ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task ResetFormAsync()
    {
        _editingId = null;
        _title = string.Empty;
        _message = string.Empty;
        _commissionLink = string.Empty;
        _messageUrlWarning = null;
        _imageUrl = string.Empty;
        _scheduledLocal = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
        _interval = WhatsAppBroadcastStatuses.DefaultIntervalSeconds;
        _selectedJids.Clear();
        _pickerEpoch++;
        if (_linkPicker is not null)
        {
            await _linkPicker.ResetAsync();
        }
    }

    private void OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            _interval = value;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value) && PageSizes.Contains(value))
        {
            _pageSize = value;
            _pageIndex = 1;
        }
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? string.Empty;
        _pageIndex = 1;
    }

    private void OnFilterFromInput(ChangeEventArgs e)
    {
        _filterFrom = e.Value?.ToString() ?? string.Empty;
        _pageIndex = 1;
    }

    private void OnFilterToInput(ChangeEventArgs e)
    {
        _filterTo = e.Value?.ToString() ?? string.Empty;
        _pageIndex = 1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        _pageIndex = 1;
    }

    private void PreviousPage()
    {
        if (_pageIndex > 1)
        {
            _pageIndex--;
        }
    }

    private void NextPage()
    {
        if (_pageIndex < TotalPages)
        {
            _pageIndex++;
        }
    }

    private void ClampPage()
    {
        if (_pageIndex > TotalPages)
        {
            _pageIndex = TotalPages;
        }

        if (_pageIndex < 1)
        {
            _pageIndex = 1;
        }
    }

    private static string StatusClass(string status) =>
        status switch
        {
            WhatsAppBroadcastStatuses.Completed => "text-bg-success",
            WhatsAppBroadcastStatuses.Failed => "text-bg-danger",
            WhatsAppBroadcastStatuses.Processing => "text-bg-warning",
            _ => "text-bg-secondary"
        };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
        }

        _pollTimer?.Dispose();
        _pollCts?.Dispose();
    }
}
