@page "/integracoes/conexoes"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Business.Security
@using TecFlow.Business.Service.Security
@using TecFlow.Business.Service.Telegram
@using TecFlow.Business.Service.WhatsApp
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Services.Integrations
@implements IAsyncDisposable
@inject IWhatsAppIntegrationApiService WhatsAppApi
@inject ITelegramIntegrationApiService TelegramApi
@inject ILogger<Conexoes> Logger
@inject NavigationManager Navigation

<PageTitle>Conexões — TecFlow</PageTitle>

<div class="dashboard-page conexoes-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Gerenciamento de conexões</h1>
            <p class="text-muted small mb-0">
                Centralize WhatsApp (Evolution API) e Telegram (BotFather) com status, QR Code e validação do bot.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/integracoes/whatsapp/agendador" class="btn btn-outline-success btn-sm">Agendador WhatsApp</a>
            <a href="/integracoes/telegram/agendador" class="btn btn-outline-primary btn-sm">Agendador Telegram</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_ok))
    {
        <div class="alert @(_okWarning ? "alert-warning" : "alert-success") py-2 small" role="status">@_ok</div>
    }
    @if (!string.IsNullOrWhiteSpace(_toastMessage))
    {
        <div class="toast show campaign-toast @ToastClass" role="status" aria-live="polite">
            <div class="toast-body">@_toastMessage</div>
        </div>
    }

    <ul class="nav nav-tabs conexoes-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="nav-link @(_tab == "whatsapp" ? "active" : string.Empty)"
                    role="tab"
                    aria-selected="@(_tab == "whatsapp")"
                    @onclick='() => _tab = "whatsapp"'>
                <i class="bi bi-whatsapp me-1" aria-hidden="true"></i>
                WhatsApp (Evolution API)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="nav-link @(_tab == "telegram" ? "active" : string.Empty)"
                    role="tab"
                    aria-selected="@(_tab == "telegram")"
                    @onclick='() => _tab = "telegram"'>
                <i class="bi bi-telegram me-1" aria-hidden="true"></i>
                Telegram (BotFather)
            </button>
        </li>
    </ul>

    @if (_tab == "whatsapp")
    {
        <section class="card border-0 shadow-sm conexoes-card">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="conexoes-avatar" title="Foto de perfil da sessão Evolution">
                            @if (!string.IsNullOrWhiteSpace(_whatsApp?.ProfilePictureUrl))
                            {
                                <img src="@_whatsApp.ProfilePictureUrl" alt="Foto de perfil WhatsApp" />
                            }
                            else
                            {
                                <i class="bi bi-whatsapp" aria-hidden="true"></i>
                            }
                        </div>
                        <div>
                            <h2 class="h5 fw-bold mb-1">Sessão Evolution</h2>
                            <p class="text-muted small mb-0">
                                @(_whatsApp?.ProfileName ?? "Nenhum perfil conectado")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(_whatsApp?.PhoneNumber))
                            {
                                <p class="small mb-0 font-monospace">@_whatsApp.PhoneNumber</p>
                            }
                        </div>
                    </div>
                    <span class="badge @WhatsAppBadgeClass" title="Estado da instância isolada por usuário">
                        @WhatsAppStatusText
                    </span>
                </div>

                <button type="button"
                        class="btn btn-success mb-4"
                        disabled="@_isBusy"
                        title="Gera uma nova instância e exibe o QR Code da Evolution API"
                        @onclick="OpenWhatsAppQrModalAsync">
                    @(_isBusy && _qrModalVisible ? "Gerando QR..." : "Gerar Conexão WhatsApp")
                </button>

                <h3 class="h6 fw-semibold mb-2">
                    Segurança
                    <i class="bi bi-info-circle text-muted"
                       title="Tokens e chaves nunca são exibidos em texto puro. O header X-Webhook-Secret é exigido nos webhooks."></i>
                </h3>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-muted">Token</dt>
                    <dd class="col-sm-8 font-monospace mb-1">@MaskOrDash(_whatsApp?.TokenMasked)</dd>
                    <dt class="col-sm-4 text-muted">ApiKey Evolution</dt>
                    <dd class="col-sm-8 font-monospace mb-1">@MaskOrDash(_whatsApp?.ApiKeyMasked)</dd>
                    <dt class="col-sm-4 text-muted">SessionData</dt>
                    <dd class="col-sm-8 font-monospace mb-1">@MaskOrDash(_whatsApp?.SessionDataMasked)</dd>
                    <dt class="col-sm-4 text-muted">@WebhookSecurityOptions.HeaderName</dt>
                    <dd class="col-sm-8 mb-0">
                        <input class="form-control form-control-sm font-monospace"
                               type="password"
                               readonly
                               value="@SecretMasking.MaskedValue"
                               title="Valor configurado no servidor. Nunca é enviado à interface."
                               autocomplete="off" />
                    </dd>
                </dl>
            </div>
        </section>
    }
    else
    {
        <section class="card border-0 shadow-sm conexoes-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">BotFather</h2>
                    <span class="badge @TelegramBadgeClass"
                          title="Resultado da última validação GetMeAsync">
                        @TelegramStatusText
                    </span>
                </div>

                @if (_telegram?.IsConnected == true && !string.IsNullOrWhiteSpace(_telegram.BotUsername))
                {
                    <div class="alert alert-success py-2 small" role="status">
                        Bot validado: <strong>@($"@{_telegram.BotUsername.TrimStart('@')}")</strong>
                    </div>
                }

                <div class="mb-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <label class="form-label small fw-semibold mb-0" for="cx-tg-token">Bot Token</label>
                        <button type="button"
                                class="btn btn-link btn-sm p-0 text-decoration-none"
                                title="Abre o passo a passo do @("@BotFather")"
                                @onclick="OpenBotFatherHelpModal">
                            <i class="bi bi-question-circle me-1" aria-hidden="true"></i>
                            Saiba onde obter o código
                        </button>
                    </div>
                    <input id="cx-tg-token"
                           class="form-control"
                           type="password"
                           autocomplete="off"
                           placeholder="@SecretMasking.MaskedValue"
                           title="Token gerado no BotFather. Armazenado com AES-256."
                           @bind="_tokenInput" />
                    <div class="form-text">Armazenado: @MaskOrDash(_telegram?.TokenMasked)</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold" for="cx-tg-chat">
                        Chat ID do Canal
                        <span class="text-muted fw-normal">(Preenchimento manual ou via detecção)</span>
                    </label>
                    <input id="cx-tg-chat"
                           class="form-control"
                           placeholder="-100707440297"
                           title="ID numérico do canal ou grupo de destino. Canais e grupos iniciam com -100."
                           @bind="_chatId" />
                    <div class="form-text">IDs de canais e grupos iniciam com <code>-100</code>.</div>
                </div>
                <button type="button"
                        class="btn btn-primary w-100 mb-4"
                        disabled="@_isLoading"
                        title="Chama GetMeAsync e registra o webhook com o secret do servidor"
                        @onclick="ValidateTelegramAsync">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Validando...</span>
                    }
                    else
                    {
                        <span>Validar e Conectar Bot</span>
                    }
                </button>

                <h3 class="h6 fw-semibold mb-2">Escuta de canais (UserBot MTProto)</h3>
                <p class="text-muted small mb-3">
                    Opcional. Informe <code>api_id</code> e <code>api_hash</code> de
                    <a href="https://my.telegram.org" target="_blank" rel="noopener noreferrer">my.telegram.org</a>
                    para ouvir canais como membro leitor. A sessão fica em
                    <code>App_Data/telegram-sessions</code> no servidor.
                </p>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold" for="cx-tg-api-id">ApiId</label>
                        <input id="cx-tg-api-id"
                               class="form-control"
                               inputmode="numeric"
                               placeholder="123456"
                               @bind="_userBotApiId" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold" for="cx-tg-api-hash">ApiHash</label>
                        <input id="cx-tg-api-hash"
                               class="form-control"
                               type="password"
                               autocomplete="off"
                               placeholder="@SecretMasking.MaskedValue"
                               @bind="_userBotApiHash" />
                        <div class="form-text">Armazenado: @MaskOrDash(_telegram?.UserBotApiHashMasked)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="cx-tg-phone">Telefone da conta leitora</label>
                        <input id="cx-tg-phone"
                               class="form-control"
                               placeholder="+5511999999999"
                               @bind="_userBotPhone" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="cx-tg-code">Código de verificação</label>
                        <input id="cx-tg-code"
                               class="form-control"
                               autocomplete="one-time-code"
                               placeholder="Somente se o Telegram enviar SMS/app"
                               @bind="_userBotCode" />
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                    <button type="button"
                            class="btn btn-outline-primary"
                            disabled="@_isSavingUserBot"
                            @onclick="SaveUserBotAsync">
                        @(_isSavingUserBot ? "Salvando..." : "Salvar UserBot")
                    </button>
                    <span class="badge @(_telegram?.HasUserBotSession == true ? "text-bg-success" : "text-bg-secondary")">
                        @(_telegram?.UserBotStatusLabel ?? "Inativo")
                    </span>
                </div>

                <h3 class="h6 fw-semibold mb-2">Segurança</h3>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-muted">ApiKey</dt>
                    <dd class="col-sm-8 font-monospace mb-1">@MaskOrDash(_telegram?.ApiKeyMasked)</dd>
                    <dt class="col-sm-4 text-muted">SessionData</dt>
                    <dd class="col-sm-8 font-monospace mb-1">@MaskOrDash(_telegram?.SessionDataMasked)</dd>
                    <dt class="col-sm-4 text-muted">@WebhookSecurityOptions.HeaderName</dt>
                    <dd class="col-sm-8 mb-0">
                        <input class="form-control form-control-sm font-monospace"
                               type="password"
                               readonly
                               value="@SecretMasking.MaskedValue"
                               title="Header exigido no webhook Telegram. O valor real não é exibido."
                               autocomplete="off" />
                    </dd>
                </dl>
            </div>
        </section>
    }
</div>

@if (_qrModalVisible)
{
    <div class="modal fade show d-block conexoes-qr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="conexoes-qr-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <div>
                        <h2 class="modal-title h5 fw-bold" id="conexoes-qr-title">Gerar Conexão WhatsApp</h2>
                        <p class="text-muted small mb-0">Abra o WhatsApp no celular e leia o QR Code. O código é atualizado automaticamente.</p>
                    </div>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseQrModal"></button>
                </div>
                <div class="modal-body text-center">
                    @if (!string.IsNullOrWhiteSpace(_qrCode))
                    {
                        <img src="@_qrCode"
                             alt="QR Code WhatsApp"
                             class="whatsapp-qr img-fluid rounded border"
                             width="240"
                             height="240" />
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Aguardando QR Code da Evolution API...</p>
                    }
                    <p class="small text-muted mt-3 mb-0">Status: @WhatsAppStatusText</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isBusy"
                            title="Solicita um novo QR Code na Evolution API"
                            @onclick="ReloadQrAsync">
                        Recarregar QR
                    </button>
                    <button type="button" class="btn btn-success" @onclick="CloseQrModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" @onclick="CloseQrModal"></div>
}

@if (isBotFatherHelpModalOpen)
{
    <div class="modal fade show d-block conexoes-qr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="botfather-help-title">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0">
                    <div class="d-flex align-items-start gap-3">
                        <span class="confirm-dialog-icon confirm-dialog-icon--info" aria-hidden="true">
                            <i class="bi bi-question-circle-fill"></i>
                        </span>
                        <h2 class="modal-title h5 fw-bold mb-0" id="botfather-help-title">Como obter o seu Bot Token no Telegram</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseBotFatherHelpModal"></button>
                </div>
                <div class="modal-body pt-0">
                    <ol class="small mb-0 ps-3">
                        <li class="mb-2">Abra o app do <strong>Telegram</strong> e pesquise por <strong>@("@BotFather")</strong> (conta oficial com selo azul).</li>
                        <li class="mb-2">Inicie a conversa e envie o comando <code>/newbot</code>.</li>
                        <li class="mb-2">Digite o <strong>Nome</strong> para o seu robô (ex: <em>Ofertas da Minha Loja</em>).</li>
                        <li class="mb-2">Digite o <strong>Username</strong> do robô (deve terminar obrigatoriamente com <code>bot</code>, ex: <em>minha_loja_ofertas_bot</em>).</li>
                        <li class="mb-0">Copie o <strong>HTTP API Token</strong> gerado (ex: <code>8743142006:AAH...</code>) e cole no campo ao lado.</li>
                    </ol>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-primary" @onclick="CloseBotFatherHelpModal">Entendi, fechar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" @onclick="CloseBotFatherHelpModal"></div>
}

@code {
    private string _tab = "whatsapp";
    private WhatsAppIntegrationDto? _whatsApp;
    private TelegramIntegrationDto? _telegram;
    private string? _qrCode;
    private bool _qrModalVisible;
    private string _tokenInput = string.Empty;
    private string? _chatId;
    private string? _userBotApiId;
    private string? _userBotApiHash;
    private string? _userBotPhone;
    private string? _userBotCode;
    private string? _error;
    private string? _ok;
    private bool _okWarning;
    private string? _toastMessage;
    private bool _toastSuccess;
    private bool _toastWarning;
    private bool _isBusy;
    private bool _isLoading;
    private bool _isSavingUserBot;
    private bool isBotFatherHelpModalOpen;
    private string? _telegramUiStatus;
    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _toastCts;

    private string WhatsAppStatusText =>
        _whatsApp?.IsConnected == true
            ? "Conectado"
            : _whatsApp?.ConnectionStatus == WhatsAppConnectionStatuses.AwaitingQr
                ? "Aguardando leitura"
                : "Desconectado";

    private string TelegramStatusText =>
        _telegramUiStatus
        ?? _telegram?.UiStatusLabel
        ?? TelegramBotRules.DisconnectedLabel;

    private string TelegramBadgeClass =>
        string.Equals(TelegramStatusText, TelegramBotRules.DispatchModeLabel, StringComparison.Ordinal)
            ? "text-bg-info"
            : string.Equals(TelegramStatusText, TelegramBotRules.AwaitingChannelMessageLabel, StringComparison.Ordinal)
                ? "text-bg-warning"
                : _telegram?.IsConnected == true
                    ? "text-bg-success"
                    : "text-bg-secondary";

    private string ToastClass =>
        _toastWarning ? "text-bg-warning"
        : _toastSuccess ? "text-bg-success"
        : "text-bg-danger";

    private string WhatsAppBadgeClass =>
        _whatsApp?.IsConnected == true
            ? "text-bg-success"
            : _whatsApp?.ConnectionStatus == WhatsAppConnectionStatuses.AwaitingQr
                ? "text-bg-warning"
                : "text-bg-secondary";

    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("telegram", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "telegram";
        }

        await LoadWhatsAppAsync();
        await LoadTelegramAsync();
        if (_whatsApp?.ConnectionStatus == WhatsAppConnectionStatuses.AwaitingQr)
        {
            StartPolling();
        }
    }

    private async Task LoadWhatsAppAsync()
    {
        var response = await WhatsAppApi.GetMineAsync();
        ApplyWhatsApp(response.Data?.Data, response.Data?.Descricao ?? response.ErrorMessage, response.Success);
    }

    private async Task LoadTelegramAsync()
    {
        var response = await TelegramApi.GetMineAsync();
        _telegram = response.Data?.Data;
        _chatId = _telegram?.ChatId;
        _userBotApiId = _telegram?.UserBotApiId?.ToString();
        _userBotPhone = _telegram?.UserBotPhone;
        if (!response.Success)
        {
            _error = response.Data?.Descricao ?? response.ErrorMessage;
        }
    }

    private async Task OpenWhatsAppQrModalAsync()
    {
        _qrModalVisible = true;
        await ReloadQrAsync();
    }

    private async Task ReloadQrAsync()
    {
        _error = null;
        _ok = null;
        _isBusy = true;
        try
        {
            var response = await WhatsAppApi.ConnectAsync();
            ApplyWhatsApp(
                response.Data?.Data,
                WhatsAppSessionRules.ResolveConnectUiMessage(
                    response.Data?.Descricao,
                    response.ErrorMessage,
                    response.StatusCode),
                response.Success);
            if (!string.IsNullOrWhiteSpace(_qrCode) && _whatsApp?.IsConnected != true)
            {
                StartPolling();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao gerar QR WhatsApp na tela de conexões.");
            _error = WhatsAppSessionRules.EvolutionUnreachableMessage;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void CloseQrModal()
    {
        _qrModalVisible = false;
        if (_whatsApp?.IsConnected == true)
        {
            _qrCode = null;
        }
    }

    private void OpenBotFatherHelpModal() => isBotFatherHelpModalOpen = true;

    private void CloseBotFatherHelpModal() => isBotFatherHelpModalOpen = false;

    private async Task ValidateTelegramAsync()
    {
        _error = null;
        _ok = null;
        _okWarning = false;
        _tab = "telegram";
        if (TelegramBotRules.IsPlaceholderToken(_tokenInput))
        {
            await ShowToastAsync(TelegramBotRules.MissingTokenMessage, success: false);
            return;
        }

        _isLoading = true;
        try
        {
            var response = await TelegramApi.ConnectAsync(new SaveTelegramIntegrationDto
            {
                Token = _tokenInput,
                ChatId = _chatId
            });
            if (!response.Success)
            {
                var fail = response.Data?.Descricao ?? response.ErrorMessage ?? TelegramBotRules.InvalidTokenMessage;
                await ShowToastAsync(fail, success: false);
                return;
            }

            _telegram = response.Data?.Data;
            _telegramUiStatus = _telegram?.UiStatusLabel;
            var description = response.Data?.Descricao ?? TelegramBotRules.ConnectedLabel;
            var dispatchMode = _telegram?.WebhookRegistered != true
                || string.Equals(description, TelegramBotRules.DispatchModeSavedMessage, StringComparison.Ordinal);
            _ok = description;
            _okWarning = dispatchMode;
            _tokenInput = string.Empty;
            await ShowToastAsync(description, success: true, warning: dispatchMode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao validar o BotToken do Telegram.");
            await ShowToastAsync(
                string.IsNullOrWhiteSpace(ex.Message) ? TelegramBotRules.InvalidTokenMessage : ex.Message,
                success: false);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveUserBotAsync()
    {
        _error = null;
        _ok = null;
        _okWarning = false;
        _tab = "telegram";
        _isSavingUserBot = true;
        try
        {
            int? apiId = null;
            if (int.TryParse(_userBotApiId, out var parsed) && parsed > 0)
            {
                apiId = parsed;
            }

            var response = await TelegramApi.SaveAsync(new SaveTelegramIntegrationDto
            {
                ChatId = _chatId,
                UserBotApiId = apiId,
                UserBotApiHash = string.IsNullOrWhiteSpace(_userBotApiHash) ? SecretMasking.MaskedValue : _userBotApiHash,
                UserBotPhone = _userBotPhone,
                UserBotVerificationCode = _userBotCode
            });
            if (!response.Success)
            {
                await ShowToastAsync(response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível salvar o UserBot.", success: false);
                return;
            }

            _telegram = response.Data?.Data;
            _userBotApiHash = string.Empty;
            _userBotCode = string.Empty;
            _ok = response.Data?.Descricao ?? "UserBot salvo.";
            await ShowToastAsync(_ok, success: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao salvar credenciais do UserBot Telegram.");
            await ShowToastAsync("Não foi possível salvar o UserBot.", success: false);
        }
        finally
        {
            _isSavingUserBot = false;
        }
    }

    private async Task ShowToastAsync(string message, bool success, bool warning = false)
    {
        _toastMessage = message;
        _toastSuccess = success;
        _toastWarning = warning;
        if (!success)
        {
            _error = message;
        }

        if (_toastCts is not null)
        {
            await _toastCts.CancelAsync();
            _toastCts.Dispose();
        }

        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), token);
            _toastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2.5));
            var ticks = 0;
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                ticks++;
                var response = await WhatsAppApi.RefreshStatusAsync(cancellationToken);
                ApplyWhatsApp(response.Data?.Data, keepQr: true);
                if (_whatsApp?.IsConnected == true)
                {
                    _qrModalVisible = false;
                    _ok = "WhatsApp conectado.";
                }

                await InvokeAsync(StateHasChanged);
                if (_whatsApp?.IsConnected == true || ticks >= 48)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Polling WhatsApp na tela de conexões interrompido.");
        }
    }

    private void ApplyWhatsApp(WhatsAppIntegrationDto? data, string? message = null, bool success = true, bool keepQr = false)
    {
        if (!success && !string.IsNullOrWhiteSpace(message))
        {
            _error = message;
        }

        if (data is null)
        {
            return;
        }

        _whatsApp = data;
        if (!string.IsNullOrWhiteSpace(data.QrCodeDataUrl))
        {
            _qrCode = data.QrCodeDataUrl;
        }
        else if (!keepQr || data.IsConnected)
        {
            _qrCode = data.IsConnected ? null : _qrCode;
        }

        if (data.IsConnected)
        {
            _qrCode = null;
            _pollCts?.Cancel();
        }
    }

    private static string MaskOrDash(string? value) =>
        string.IsNullOrEmpty(value) ? "—" : value;

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null)
        {
            await _pollCts.CancelAsync();
            _pollCts.Dispose();
        }

        if (_toastCts is not null)
        {
            await _toastCts.CancelAsync();
            _toastCts.Dispose();
        }
    }
}
