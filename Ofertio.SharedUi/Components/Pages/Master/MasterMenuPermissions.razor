@page "/master/menu-permissions"
@attribute [Authorize(Roles = MasterRoles.AnyMaster)]
@layout Ofertio.SharedUi.Components.Layout.MasterMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits MasterPageBase
@inject IMasterApiService Api
@inject IJSRuntime Js

<PageTitle>Menus por plano — Painel Master</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 master-sticky-bar">
        <div>
            <h1 class="h3 fw-bold mb-1">Matriz de menus por plano</h1>
            <p class="text-muted small mb-0">
                Marque o que cada plano enxerga na sidebar.
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => _showHelp = !_showHelp">@(_showHelp ? "Ocultar ajuda" : "Como funciona?")</button>
            </p>
            @if (_showHelp)
            {
                <p class="text-muted small mb-0 mt-1">
                    Hierarquia: <strong>grupo</strong> → <strong>tela</strong> → <strong>componente</strong> (gráfico, campo, botão, seção).
                    Desmarcar uma pasta esconde todos os itens dela; desmarcar uma tela esconde a tela, bloqueia a rota e oculta os componentes dela;
                    desativar um item o remove para todos.
                    Linhas <span class="badge text-bg-secondary">permissão</span> liberam um conjunto de telas: desligadas num plano, ocultam essas telas automaticamente.
                </p>
            }
        </div>
        @if (PendingChanges > 0)
        {
            <span class="small text-warning ms-md-auto" role="status">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i> Alterações não salvas
            </span>
        }
        <button type="button" class="btn btn-primary btn-touch" disabled="@(!_canManage || PendingChanges == 0)" @onclick="SaveAsync">
            <i class="bi bi-save me-1" aria-hidden="true"></i>Salvar @(PendingChanges > 0 ? $"({PendingChanges})" : string.Empty)
        </button>
    </div>

    <MasterAlerts Error="@Error" Info="@Info" />

    @if (_canManage)
    {
        <div class="menu-dnd-help small mb-3">
            <i class="bi bi-arrows-move" aria-hidden="true"></i>
            Arraste pela alça <i class="bi bi-grip-vertical" aria-hidden="true"></i>:
            solte na <strong>borda de cima/baixo</strong> de uma linha para reordenar,
            no <strong>centro de uma pasta</strong> para movê-lo para dentro dela,
            ou no <strong>centro de outro item</strong> para criar uma nova pasta com os dois.
            A sidebar dos clientes reflete a mudança na próxima navegação.
        </div>
    }

    @if (_matrix is not null)
    {
        <div class="menu-tree-toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
            <div class="menu-tree-search">
                <label class="visually-hidden" for="menu-search">Buscar item do menu</label>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="menu-search" type="search" class="form-control form-control-sm" placeholder="Buscar tela, componente ou rota"
                       autocomplete="off" @bind="_search" @bind:event="oninput" />
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ExpandAllAsync">
                <i class="bi bi-arrows-expand me-1" aria-hidden="true"></i>Expandir tudo
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CollapseAllAsync">
                <i class="bi bi-arrows-collapse me-1" aria-hidden="true"></i>Recolher tudo
            </button>
            @if (IsSearching)
            {
                <span class="small text-muted" role="status">@VisibleRows().Count() item(ns) encontrado(s)</span>
            }
        </div>

        <div class="table-responsive card shadow-sm">
            <table class="table table-sm align-middle mb-0 small menu-matrix">
                <thead class="table-light">
                    <tr>
                        <th class="menu-grip-col" aria-label="Arrastar"></th>
                        <th>Item do menu</th>
                        <th class="text-center">Ativo</th>
                        @foreach (var plan in _matrix.Plans)
                        {
                            <th class="text-center">
                                @plan.Name
                                <div>
                                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@(!_canManage)" @onclick="() => SetColumn(plan.Id, true)">todos</button>
                                    ·
                                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@(!_canManage)" @onclick="() => SetColumn(plan.Id, false)">nenhum</button>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in VisibleRows())
                    {
                        var expandable = row.ChildCount > 0;
                        var expanded = IsExpanded(row);
                        <tr data-menu-row="@row.MenuItemId"
                            draggable="@(_canManage ? "true" : "false")"
                            class="@RowClass(row)"
                            @ondragstart="() => _dragId = row.MenuItemId"
                            @ondragend="() => _dragId = null"
                            @ondrop="() => DropAsync(row)"
                            @ondrop:preventDefault="true">
                            <td class="menu-grip-col text-center">
                                @if (_canManage)
                                {
                                    <i class="bi bi-grip-vertical menu-grip" title="Arrastar" aria-hidden="true"></i>
                                }
                            </td>
                            <td style="padding-left: @(0.5 + row.Depth * 1.5)rem;">
                                @if (expandable)
                                {
                                    <button type="button" class="btn btn-link btn-sm menu-tree-toggle" aria-expanded="@(expanded ? "true" : "false")"
                                            aria-label="@($"{(expanded ? "Recolher" : "Expandir")} {row.Title}")" @onclick="() => ToggleAsync(row)">
                                        <i class="bi @(expanded ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="menu-tree-spacer" aria-hidden="true"></span>
                                }
                                @if (row.IsGroup && expandable)
                                {
                                    <button type="button" class="btn btn-link menu-tree-title p-0" @onclick="() => ToggleAsync(row)">
                                        <i class="bi @(row.Icon ?? "bi-folder2") me-1" aria-hidden="true"></i>@row.Title
                                    </button>
                                }
                                else
                                {
                                    <i class="bi @(row.IsGroup ? (row.Icon ?? "bi-folder2") : row.Icon) me-1" aria-hidden="true"></i>@row.Title
                                }
                                @if (row.IsGroup)
                                {
                                    <span class="badge text-bg-light ms-1">pasta</span>
                                }
                                @if (row.IsComponent)
                                {
                                    <span class="badge menu-component-badge ms-1">@ComponentTypes.Label(row.ComponentType)</span>
                                }
                                else if (!row.IsGroup && row.ChildCount > 0)
                                {
                                    <span class="badge text-bg-light ms-1">@row.ChildCount componente@(row.ChildCount == 1 ? string.Empty : "s")</span>
                                }
                                @if (expandable && !expanded && HasPendingBelow(row))
                                {
                                    <span class="small text-warning ms-1" title="Há alterações não salvas dentro deste item">
                                        <i class="bi bi-dot" aria-hidden="true"></i>alterações
                                    </span>
                                }
                                @if (row.IsFeatureToggle)
                                {
                                    <span class="badge text-bg-secondary ms-1">permissão</span>
                                    @if (row.ControlledTitles.Count > 0)
                                    {
                                        <div class="text-muted fw-normal">Libera: @string.Join(", ", row.ControlledTitles)</div>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Badge))
                                {
                                    <span class="badge text-bg-primary ms-1">@row.Badge</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Route))
                                {
                                    <span class="ms-1"><code class="menu-route">@row.Route</code></span>
                                }
                                @if (row.IsCustomFolder && _canManage && IsEmptyFolder(row))
                                {
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-2" title="Excluir pasta vazia" @onclick="() => DeleteFolderAsync(row)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                }
                            </td>
                            <td class="text-center">
                                <label class="visually-hidden" for="menu-active-@row.MenuItemId">Ativo: @row.Title</label>
                                <input id="menu-active-@row.MenuItemId" type="checkbox" class="form-check-input" checked="@row.IsActive" disabled="@(!_canManage)"
                                       @onchange="args => ToggleActive(row, (bool)args.Value!)" />
                            </td>
                            @foreach (var plan in _matrix.Plans)
                            {
                                var blockReason = BlockReason(row, plan.Id);
                                var blockedByFeature = blockReason is not null;
                                <td class="text-center" title="@blockReason">
                                    <label class="visually-hidden" for="menu-plan-@row.MenuItemId-@plan.Id">@row.Title no plano @plan.Name</label>
                                    <input id="menu-plan-@row.MenuItemId-@plan.Id" type="checkbox" class="form-check-input" checked="@(IsVisible(row, plan.Id) && !blockedByFeature)" disabled="@(!_canManage || !row.IsActive || blockedByFeature)"
                                           aria-label="@($"{row.Title} no plano {plan.Name}")"
                                           @onchange="args => ToggleCell(row, plan.Id, (bool)args.Value!)" />
                                    @if (blockedByFeature)
                                    {
                                        <i class="bi bi-lock-fill text-muted ms-1" aria-hidden="true"></i>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_folderDraft is not null)
{
    <div class="modal fade show d-block menu-folder-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="menu-folder-title-label">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="menu-folder-title-label">Nova pasta</h2>
                    <button type="button" class="btn-close" aria-label="Cancelar" @onclick="CancelFolder"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        "<strong>@_folderTargetTitle</strong>" e "<strong>@_folderItemTitle</strong>" serão agrupados na nova pasta, na posição de "@_folderTargetTitle".
                    </p>
                    <label class="form-label small mb-1" for="menu-folder-title">Título da pasta</label>
                    <input id="menu-folder-title" class="form-control" maxlength="@MenuTreeEditRules.FolderTitleMaxLength"
                           placeholder="ex.: Ferramentas de venda" autocomplete="off"
                           @ref="_folderInput" @bind="_folderDraft.Title" @bind:event="oninput" @onkeydown="FolderKeyDownAsync" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelFolder"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancelar</button>
                    <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_folderDraft.Title)" @onclick="CreateFolderAsync">
                        <i class="bi bi-folder-plus" aria-hidden="true"></i> Criar pasta
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _showHelp;

    private MenuPermissionMatrixDto? _matrix;
    private readonly Dictionary<(int PlanId, int ItemId), bool> _cells = [];
    private readonly Dictionary<int, bool> _active = [];
    private bool _canManage;
    private int? _dragId;
    private MenuFolderCreateDto? _folderDraft;
    private string _folderItemTitle = string.Empty;
    private string _folderTargetTitle = string.Empty;
    private ElementReference _folderInput;
    private bool _focusFolderInput;

    private const string ExpandedStorageKey = "ofertio.master.menu.expanded";
    /// <summary>Chaves dos grupos/telas abertos; tudo começa fechado (só a raiz aparece).</summary>
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<int, MenuPermissionRowDto> _byId = [];
    private string _search = string.Empty;

    private int PendingChanges => _cells.Count + _active.Count;

    private bool IsSearching => !string.IsNullOrWhiteSpace(_search);

    protected override async Task LoadAsync()
    {
        _canManage = Can(MasterPermissions.ManagePlans);
        if (!_canManage)
        {
            Error = "Seu papel não permite alterar menus por plano.";
            return;
        }

        var result = await Api.MenuPermissionsAsync();
        if (Accept(result))
        {
            _matrix = result.Data;
            IndexRows();
            _cells.Clear();
            _active.Clear();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            await RestoreExpandedAsync();
        }

        if (_focusFolderInput && _folderDraft is not null)
        {
            _focusFolderInput = false;
            await _folderInput.FocusAsync();
        }
    }

    /// <summary>Recarrega a árvore após mover/criar pasta sem descartar marcações ainda não salvas.</summary>
    private async Task RefreshStructureAsync(string? message)
    {
        var result = await Api.MenuPermissionsAsync();
        if (!Accept(result) || result.Data is null)
        {
            return;
        }

        _matrix = result.Data;
        IndexRows();
        foreach (var row in _matrix.Rows.Where(row => _active.ContainsKey(row.MenuItemId)))
        {
            row.IsActive = _active[row.MenuItemId];
        }

        Info = message;
    }

    private bool IsEmptyFolder(MenuPermissionRowDto folder) =>
        _matrix?.Rows.All(row => row.ParentId != folder.MenuItemId) ?? false;

    private async Task DropAsync(MenuPermissionRowDto target)
    {
        if (_dragId is not int itemId || itemId == target.MenuItemId || _matrix is null)
        {
            _dragId = null;
            return;
        }

        _dragId = null;
        var zone = await Js.InvokeAsync<string>("ofertioMenuDnd.zone");
        if (zone == MenuDropPositions.Into && !target.IsGroup)
        {
            _folderDraft = new MenuFolderCreateDto { ItemId = itemId, TargetId = target.MenuItemId };
            _folderItemTitle = _matrix.Rows.FirstOrDefault(row => row.MenuItemId == itemId)?.Title ?? string.Empty;
            _folderTargetTitle = target.Title;
            _focusFolderInput = true;
            return;
        }

        var result = await Api.MoveMenuItemAsync(new MenuMoveDto { ItemId = itemId, TargetId = target.MenuItemId, Position = zone });
        if (AcceptOperation(result))
        {
            await RefreshStructureAsync(Info);
        }
    }

    private async Task CreateFolderAsync()
    {
        if (_folderDraft is null || string.IsNullOrWhiteSpace(_folderDraft.Title))
        {
            return;
        }

        var draft = _folderDraft;
        if (AcceptOperation(await Api.CreateMenuFolderAsync(draft)))
        {
            _folderDraft = null;
            await RefreshStructureAsync(Info);
        }
    }

    private async Task FolderKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateFolderAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelFolder();
        }
    }

    private void CancelFolder() => _folderDraft = null;

    private async Task DeleteFolderAsync(MenuPermissionRowDto folder)
    {
        if (AcceptOperation(await Api.DeleteMenuFolderAsync(folder.MenuItemId)))
        {
            _cells.Keys.Where(key => key.ItemId == folder.MenuItemId).ToList().ForEach(key => _cells.Remove(key));
            _active.Remove(folder.MenuItemId);
            await RefreshStructureAsync(Info);
        }
    }

    private bool IsVisible(MenuPermissionRowDto row, int planId) =>
        _cells.TryGetValue((planId, row.MenuItemId), out var pending)
            ? pending
            : row.Visibility.GetValueOrDefault(planId, true);

    /// <summary>
    /// Motivo do bloqueio da célula (null = livre): tela que depende de chave de permissão desligada,
    /// ou componente cuja tela está inativa/desmarcada no plano (a cascata oculta o componente).
    /// </summary>
    private string? BlockReason(MenuPermissionRowDto row, int planId)
    {
        if (row.RequiresFeatureId is int featureId)
        {
            var feature = _byId.GetValueOrDefault(featureId);
            if (feature is null || !feature.IsActive || !IsVisible(feature, planId))
            {
                return $"Oculto: {row.RequiresFeatureTitle} desligada neste plano";
            }
        }

        if (row.IsComponent && row.ParentId is int parentId && _byId.TryGetValue(parentId, out var page)
            && (!page.IsActive || !IsVisible(page, planId)))
        {
            return $"Oculto: a tela \"{page.Title}\" está desmarcada neste plano";
        }

        return null;
    }

    private void IndexRows() => _byId = _matrix?.Rows.ToDictionary(row => row.MenuItemId) ?? [];

    private IEnumerable<MenuPermissionRowDto> Ancestors(MenuPermissionRowDto row)
    {
        var guard = 0;
        var current = row;
        while (current.ParentId is int parentId && _byId.TryGetValue(parentId, out var parent) && guard++ < 32)
        {
            yield return parent;
            current = parent;
        }
    }

    private bool Matches(MenuPermissionRowDto row)
    {
        var term = _search.Trim();
        return row.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || row.Key.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (row.Route?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    /// <summary>Raiz sempre; demais linhas só com todos os ancestrais abertos. Na busca: resultados e seus ancestrais.</summary>
    private IEnumerable<MenuPermissionRowDto> VisibleRows()
    {
        if (_matrix is null)
        {
            return [];
        }

        if (IsSearching)
        {
            var shown = new HashSet<int>();
            foreach (var match in _matrix.Rows.Where(Matches))
            {
                shown.Add(match.MenuItemId);
                shown.UnionWith(Ancestors(match).Select(item => item.MenuItemId));
            }

            return _matrix.Rows.Where(row => shown.Contains(row.MenuItemId));
        }

        return _matrix.Rows.Where(row => Ancestors(row).All(ancestor => _expanded.Contains(ancestor.Key)));
    }

    private bool IsExpanded(MenuPermissionRowDto row) =>
        _expanded.Contains(row.Key)
        || (IsSearching && _matrix is not null && _matrix.Rows.Any(item => Matches(item) && Ancestors(item).Any(a => a.MenuItemId == row.MenuItemId)));

    private string RowClass(MenuPermissionRowDto row) => string.Join(' ',
        row.IsGroup ? "table-secondary fw-semibold menu-group-row" : string.Empty,
        row.IsComponent ? "menu-component-row" : string.Empty,
        row.IsActive ? string.Empty : "text-muted");

    /// <summary>Há marcação pendente em algum item abaixo deste (aviso no grupo recolhido).</summary>
    private bool HasPendingBelow(MenuPermissionRowDto row) =>
        _cells.Keys.Select(key => key.ItemId).Concat(_active.Keys)
            .Distinct()
            .Any(id => _byId.TryGetValue(id, out var item) && Ancestors(item).Any(a => a.MenuItemId == row.MenuItemId));

    private async Task ToggleAsync(MenuPermissionRowDto row)
    {
        if (!_expanded.Remove(row.Key))
        {
            _expanded.Add(row.Key);
        }

        await SaveExpandedAsync();
    }

    private async Task ExpandAllAsync()
    {
        _expanded.UnionWith(_matrix?.Rows.Where(row => row.ChildCount > 0).Select(row => row.Key) ?? []);
        await SaveExpandedAsync();
    }

    private async Task CollapseAllAsync()
    {
        _expanded.Clear();
        _search = string.Empty;
        await SaveExpandedAsync();
    }

    /// <summary>Lembra os grupos abertos nesta aba; sem armazenamento disponível, tudo segue fechado.</summary>
    private async Task RestoreExpandedAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("sessionStorage.getItem", ExpandedStorageKey);
            if (!string.IsNullOrWhiteSpace(json)
                && System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) is { Count: > 0 } keys)
            {
                _expanded.UnionWith(keys);
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or System.Text.Json.JsonException)
        {
        }
    }

    private async Task SaveExpandedAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("sessionStorage.setItem", ExpandedStorageKey, System.Text.Json.JsonSerializer.Serialize(_expanded));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    private void ToggleCell(MenuPermissionRowDto row, int planId, bool visible)
    {
        if (row.Visibility.GetValueOrDefault(planId, true) == visible)
        {
            _cells.Remove((planId, row.MenuItemId));
        }
        else
        {
            _cells[(planId, row.MenuItemId)] = visible;
        }
    }

    private void ToggleActive(MenuPermissionRowDto row, bool active)
    {
        if (!_active.Remove(row.MenuItemId))
        {
            _active[row.MenuItemId] = active;
        }

        row.IsActive = active;
    }

    private void SetColumn(int planId, bool visible)
    {
        if (_matrix is null)
        {
            return;
        }

        foreach (var row in _matrix.Rows)
        {
            ToggleCell(row, planId, visible);
        }
    }

    private async Task SaveAsync()
    {
        var request = new MenuPermissionSaveDto
        {
            Cells = _cells.Select(pair => new MenuPermissionCellDto
            {
                PlanId = pair.Key.PlanId,
                MenuItemId = pair.Key.ItemId,
                IsVisible = pair.Value
            }).ToList(),
            ActiveItems = new Dictionary<int, bool>(_active)
        };

        if (AcceptOperation(await Api.SaveMenuPermissionsAsync(request)))
        {
            var message = Info;
            await LoadAsync();
            Info = message;
        }
    }
}
