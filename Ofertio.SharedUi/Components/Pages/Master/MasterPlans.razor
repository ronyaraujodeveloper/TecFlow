@page "/master/planos"
@attribute [Authorize(Roles = MasterRoles.AnyMaster)]
@layout Ofertio.SharedUi.Components.Layout.MasterMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits MasterPageBase
@inject IMasterApiService Api

<PageTitle>Planos — Painel Master</PageTitle>

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Planos e matriz de funcionalidades</h1>
        <p class="text-muted small mb-0">Preços, ciclos e limites aplicados automaticamente aos inquilinos. Disparos/dia soma WhatsApp e Telegram; 0 = ilimitado. As vantagens de cada plano aparecem para o cliente em Meu plano.</p>
    </div>

    <MasterAlerts Error="@Error" Info="@Info" />

    <div class="table-responsive card shadow-sm">
        <table class="table align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Plano</th>
                    <th>Mensal (R$)</th>
                    <th>Anual (R$)</th>
                    <th>Lojas</th>
                    <th>Achadinhos/dia</th>
                    <th>Disparos/dia</th>
                    <th>Radar</th>
                    <th>Ativo</th>
                    <th class="text-end">Inquilinos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in _plans)
                {
                    <tr>
                        <td>
                            <label class="visually-hidden" for="plan-name-@plan.Code">Nome do plano @plan.Code</label>
                            <input id="plan-name-@plan.Code" class="form-control form-control-sm" style="min-width: 110px;" @bind="plan.Name" />
                            <div class="text-muted">@plan.Code</div>
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-monthly-@plan.Code">Mensal do plano @plan.Code</label>
                            <input id="plan-monthly-@plan.Code" type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="plan.MonthlyPrice" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-annual-@plan.Code">Anual do plano @plan.Code</label>
                            <input id="plan-annual-@plan.Code" type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="plan.AnnualPrice" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-stores-@plan.Code">Lojas do plano @plan.Code</label>
                            <input id="plan-stores-@plan.Code" type="number" min="0" class="form-control form-control-sm" @bind="plan.MaxStores" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-vip-@plan.Code">Achadinhos por dia do plano @plan.Code</label>
                            <input id="plan-vip-@plan.Code" type="number" min="0" class="form-control form-control-sm" @bind="plan.DailyVipQuota" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-schedules-@plan.Code">Disparos por dia do plano @plan.Code</label>
                            <input id="plan-schedules-@plan.Code" type="number" min="0" class="form-control form-control-sm" title="Disparos de WhatsApp e Telegram somados neste plano. 0 = ilimitado." @bind="plan.MaxDailySchedules" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-radar-@plan.Code">Radar do plano @plan.Code</label>
                            <input id="plan-radar-@plan.Code" type="checkbox" class="form-check-input" @bind="plan.RadarEnabled" />
                        </td>
                        <td>
                            <label class="visually-hidden" for="plan-active-@plan.Code">Ativo do plano @plan.Code</label>
                            <input id="plan-active-@plan.Code" type="checkbox" class="form-check-input" @bind="plan.IsActive" />
                        </td>
                        <td class="text-end">@plan.TenantCount</td>
                        <td class="text-end">
                            @if (Can(MasterPermissions.ManagePlans))
                            {
                                <button id="plan-save-@plan.Code" type="button" class="btn btn-sm btn-primary" @onclick="() => SaveAsync(plan)"><i class="bi bi-check-circle me-1"></i>Salvar</button>
                            }
                        </td>
                    </tr>
                    <tr class="master-plan-highlights-row">
                        <td colspan="10" class="border-top-0 pt-0">
                            <label class="form-label small text-muted mb-1" for="plan-highlights-@plan.Code">Vantagens (uma por linha) — aparecem no olho de Meu plano</label>
                            <textarea id="plan-highlights-@plan.Code" class="form-control form-control-sm" rows="2" maxlength="2000" @bind="plan.Highlights"></textarea>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<SaasPlanDto> _plans = [];

    protected override async Task LoadAsync()
    {
        var result = await Api.PlansAsync();
        if (Accept(result))
        {
            _plans = result.Data ?? [];
        }
    }

    private async Task SaveAsync(SaasPlanDto plan)
    {
        if (Accept(await Api.SavePlanAsync(plan)))
        {
            SetResult(true, $"Plano {plan.Name} salvo.");
        }
    }
}
