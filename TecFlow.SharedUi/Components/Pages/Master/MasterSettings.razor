@page "/master/vault"
@page "/master/configuracoes"
@attribute [Authorize(Roles = MasterRoles.AnyMaster)]
@layout TecFlow.SharedUi.Components.Layout.MasterMainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits MasterPageBase
@inject IMasterApiService Api

<PageTitle>Cofre de chaves (Vault) — Painel Master</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Cofre de chaves globais (Vault)</h1>
            <p class="text-muted small mb-0">
                Chaves da plataforma usadas por todos os clientes: AppId/SecretKey dos marketplaces, Evolution API, Telegram, OpenAI e ASAAS.
                Valores criptografados no banco (AES); segredos aparecem mascarados — deixe o campo como está para manter o valor atual ou apague-o para remover.
                Contas corporativas de teste/dev ficam em <a href="@MasterRoutes.DeveloperAccounts">Contas de teste / dev</a>.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary btn-touch" disabled="@(!Can(MasterPermissions.ManageGlobalKeys))" @onclick="CheckKeysAsync">
                <i class="bi bi-activity" aria-hidden="true"></i> Testar chaves em uso
            </button>
            <button type="button" class="btn btn-primary btn-touch" disabled="@(!Can(MasterPermissions.ManageGlobalKeys))" @onclick="SaveAsync">Salvar</button>
            <button type="button" class="btn btn-outline-warning btn-touch" disabled="@(!Can(MasterPermissions.ManageGlobalKeys))" @onclick="RestartAsync">Aplicar e reiniciar API</button>
        </div>
    </div>

    <MasterAlerts Error="@Error" Info="@Info" />

    @if (_checks.Count > 0)
    {
        <div class="row g-3 mb-4">
            @foreach (var check in _checks)
            {
                <div class="col-12 col-md-4">
                    <div class="card h-100 border-@(check.Success ? "success" : "danger")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>@DeveloperPlatforms.Label(check.Platform)</strong>
                                <span class="badge @(check.Success ? "text-bg-success" : "text-bg-danger")">@(check.Success ? "Online" : "Falha")</span>
                            </div>
                            <div class="small text-muted mb-1">@check.Source · @check.LatencyMs ms</div>
                            <div class="small">@check.Message</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @foreach (var group in _items.GroupBy(item => item.Category))
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">@group.Key</div>
            <div class="card-body row g-3">
                @foreach (var item in group)
                {
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1">
                            @item.Label
                            @if (item.IsSecret)
                            {
                                <i class="bi bi-lock-fill text-muted ms-1" title="Segredo criptografado" aria-hidden="true"></i>
                            }
                        </label>
                        <input type="@(item.IsSecret ? "password" : "text")"
                               class="form-control"
                               autocomplete="off"
                               placeholder="@item.Placeholder"
                               value="@_values[item.Key]"
                               @onchange="args => _values[item.Key] = args.Value?.ToString()" />
                        <div class="form-text">
                            <code>@item.Key</code>
                            @if (item.UpdatedAt is not null)
                            {
                                <span> · atualizado em @DateTimeText(item.UpdatedAt) por @(item.UpdatedBy ?? "—")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<SystemSettingItemDto> _items = [];
    private List<DeveloperAccountCheckDto> _checks = [];
    private Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string?> _original = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task LoadAsync()
    {
        var result = await Api.SettingsAsync();
        if (!Accept(result))
        {
            return;
        }

        _items = result.Data ?? [];
        _values = _items.ToDictionary(item => item.Key, item => (string?)item.DisplayValue, StringComparer.OrdinalIgnoreCase);
        _original = new Dictionary<string, string?>(_values, StringComparer.OrdinalIgnoreCase);
    }

    private async Task SaveAsync()
    {
        var changed = _values
            .Where(pair => !string.Equals(pair.Value ?? string.Empty, _original.GetValueOrDefault(pair.Key) ?? string.Empty, StringComparison.Ordinal))
            .ToDictionary(pair => pair.Key, pair => pair.Value);
        if (changed.Count == 0)
        {
            SetResult(true, "Nenhuma alteração para salvar.");
            return;
        }

        if (AcceptOperation(await Api.SaveSettingsAsync(new SystemSettingSaveDto { Values = changed })))
        {
            var info = Info;
            await LoadAsync();
            Info = info;
        }
    }

    private async Task RestartAsync()
    {
        AcceptOperation(await Api.RestartApiAsync());
    }

    private async Task CheckKeysAsync()
    {
        var result = await Api.CheckGlobalKeysAsync();
        if (Accept(result))
        {
            _checks = result.Data ?? [];
            Error = null;
        }
    }
}
