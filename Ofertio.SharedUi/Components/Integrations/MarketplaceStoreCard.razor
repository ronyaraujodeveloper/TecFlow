@using Ofertio.Business.Dto
@using Ofertio.Core.Enums
@inject IUserClock Clock

<div class="store-row-wrap" role="listitem">
    <div class="store-row">
        <span class="marketplace-platform-badge store-row-platform @GetPlatformBadgeClass()" title="@GetPlatformLabel()">@GetPlatformLabel()</span>
        <span class="store-row-status @StatusIconColor" role="img" tabindex="0" title="@GetStatusLabel()" aria-label="@GetStatusLabel()">
            <i class="bi @StatusIcon" aria-hidden="true"></i>
        </span>
        <span class="store-row-name" title="@Store.FriendlyName">
            <span class="store-row-name-text">@Store.FriendlyName</span>
            @if (NeedsCreatorAccount)
            {
                <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0" role="img" tabindex="0"
                   title="Conecte sua conta de criador TikTok para garantir a comissão nos links. Abra Editar para conectar."
                   aria-label="Falta conectar a conta de criador TikTok"></i>
            }
            @if (Store.RequiresTrackingIdCorrection)
            {
                <i class="bi bi-exclamation-octagon-fill text-danger flex-shrink-0" role="img" tabindex="0"
                   title="ID de afiliado inválido (URL detectada). Abra Editar e informe o ID numérico/tag."
                   aria-label="ID de afiliado inválido"></i>
            }
        </span>
        @if (OnEdit.HasDelegate)
        {
            <button id="store-edit-@Store.Id"
                    type="button"
                    class="store-row-btn"
                    title="Editar loja"
                    aria-label="Editar loja @Store.FriendlyName"
                    disabled="@IsBusy"
                    @onclick="() => OnEdit.InvokeAsync(Store)">
                <i class="bi bi-pencil" aria-hidden="true"></i>
            </button>
        }
        <button id="store-unlink-@Store.Id"
                type="button"
                class="store-row-btn store-row-btn-danger"
                title="Desconectar loja"
                aria-label="Desconectar loja @Store.FriendlyName"
                aria-expanded="@_confirmDelete"
                disabled="@IsBusy"
                @onclick="RequestDelete">
            <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>
    </div>
    @if (_confirmDelete)
    {
        <div class="store-row-confirm" role="alert">
            <span>Desconectar <strong>@Store.FriendlyName</strong>? Os links dessa loja deixam de usar este cadastro.</span>
            <span class="store-row-confirm-actions">
                <button id="store-unlink-confirm-@Store.Id" type="button" class="btn btn-danger btn-sm" disabled="@IsBusy" @onclick="() => ConfirmarDesconexaoAsync(Store)">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Sim, desconectar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@IsBusy" @onclick="CancelDelete">Cancelar</button>
            </span>
        </div>
    }
</div>
@code {
    [Parameter, EditorRequired] public MarketplaceAccountDto Store { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback<MarketplaceAccountDto> OnUnlink { get; set; }
    [Parameter] public EventCallback<MarketplaceAccountDto> OnEdit { get; set; }

    private bool _confirmDelete;

    private bool IsTikTokShop => Store.PlatformType == MarketplaceType.TikTokShop;

    private bool NeedsCreatorAccount => IsTikTokShop && !Store.HasOAuthToken;

    private string StatusIcon => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "bi-check-circle-fill",
        MarketplaceIntegrationStatus.Expired => "bi-exclamation-circle-fill",
        _ => "bi-dash-circle-fill"
    };

    private string StatusIconColor => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "text-success",
        MarketplaceIntegrationStatus.Expired => "text-warning",
        _ => "text-secondary"
    };

    protected override Task OnInitializedAsync() => Clock.EnsureLoadedAsync();

    private string AffiliateIdDisplay
    {
        get
        {
            if (Store.RequiresTrackingIdCorrection)
            {
                return "inválido — informe o ID";
            }

            return string.IsNullOrWhiteSpace(Store.AffiliateTrackingId) ? "—" : Store.AffiliateTrackingId;
        }
    }

    private string GetPlatformLabel() => Store.PlatformType switch
    {
        MarketplaceType.TikTokShop => "TikTok Shop",
        MarketplaceType.Shopee => "Shopee",
        MarketplaceType.MercadoLivre => "Mercado Livre",
        MarketplaceType.Amazon => "Amazon",
        MarketplaceType.MagazineLuiza => "Magazine Luiza",
        MarketplaceType.Kabum => "Kabum!",
        MarketplaceType.CasasBahia => "Casas Bahia",
        _ => Store.PlatformType.ToString()
    };

    private string GetPlatformBadgeClass() =>
        PlatformBadgeHelper.GetPlatformBadgeClass(Store.PlatformType);

    /// <summary>Lojas Universal Link não dependem de token: validade de um OAuth antigo não as torna expiradas.</summary>
    private MarketplaceIntegrationStatus EffectiveStatus =>
        Store.Status == MarketplaceIntegrationStatus.Expired && Store.PlatformType.IsUniversalAffiliatePlatform()
            ? MarketplaceIntegrationStatus.Active
            : Store.Status;

    private string GetStatusLabel() => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "Ativo",
        MarketplaceIntegrationStatus.Expired => "Expirado",
        MarketplaceIntegrationStatus.Inactive => "Inativo",
        _ => Store.Status.ToString()
    };

    private string GetStatusBadgeClass() => EffectiveStatus switch
    {
        MarketplaceIntegrationStatus.Active => "text-bg-success",
        MarketplaceIntegrationStatus.Expired => "text-bg-warning",
        MarketplaceIntegrationStatus.Inactive => "text-bg-secondary",
        _ => "text-bg-secondary"
    };

    private void RequestDelete() => _confirmDelete = true;

    private void CancelDelete() => _confirmDelete = false;

    private async Task ConfirmarDesconexaoAsync(MarketplaceAccountDto account)
    {
        try
        {
            Console.WriteLine($"[MarketplaceStoreCard] Sim, desconectar accountId={account.Id} shop={account.ShopId}");
            await OnUnlink.InvokeAsync(account);
            _confirmDelete = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO BLAZOR] ConfirmarDesconexaoAsync accountId={account.Id}: {ex.Message} - {ex.StackTrace}");
            throw;
        }
    }
}
