@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger py-2 small" role="alert"><i class="bi bi-x-octagon me-1" aria-hidden="true"></i>@Error</div>
}
@if (!string.IsNullOrWhiteSpace(Info))
{
    <div class="alert alert-success py-2 small" role="status"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>@Info</div>
}

@code {
    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Info { get; set; }
}
