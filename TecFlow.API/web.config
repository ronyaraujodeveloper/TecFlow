<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled: diagnóstico IIS (ver Configurar-Logs-IIS.ps1) -->
      <aspNetCore processPath="dotnet" arguments=".\TecFlow.API.dll" hostingModel="inprocess" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" requestTimeout="20:00:00" shutdownTimeLimit="300">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Homologacao" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
