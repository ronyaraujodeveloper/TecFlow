<?xml version="1.0" encoding="utf-8"?>
<!-- Igual à VPS: sem isto o Refit 10.1.6 falha no restore com NU3012 (certificado revogado). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
