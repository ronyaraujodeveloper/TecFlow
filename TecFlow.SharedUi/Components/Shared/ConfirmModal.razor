@if (IsOpen)
{
    <div class="modal fade show d-block confirm-dialog-host"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="confirm-modal-title"
         @onkeydown="OnKeyDown">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-dialog-content">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-start gap-3">
                        <span class="confirm-dialog-icon @IconClass" aria-hidden="true">
                            <i class="bi @IconName"></i>
                        </span>
                        <h2 class="modal-title h5 mb-0" id="confirm-modal-title">@Title</h2>
                    </div>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="CancelAsync"></button>
                </div>
                <div class="modal-body pt-3">
                    <p class="mb-0">@Message</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">@CancelText</button>
                    <button type="button" class="btn @ConfirmClass" @onclick="ConfirmAsync">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show confirm-dialog-backdrop" @onclick="CancelAsync"></div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirmar";

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public ConfirmDialogKind Kind { get; set; } = ConfirmDialogKind.Danger;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string IconClass => Kind switch
    {
        ConfirmDialogKind.Warning => "confirm-dialog-icon--warning",
        ConfirmDialogKind.Info => "confirm-dialog-icon--info",
        _ => "confirm-dialog-icon--danger"
    };

    private string IconName => Kind switch
    {
        ConfirmDialogKind.Warning => "bi-exclamation-triangle-fill",
        ConfirmDialogKind.Info => "bi-info-circle-fill",
        _ => "bi-exclamation-octagon-fill"
    };

    private string ConfirmClass => Kind switch
    {
        ConfirmDialogKind.Warning => "btn-warning",
        ConfirmDialogKind.Info => "btn-primary",
        _ => "btn-danger"
    };

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync() => OnCancel.InvokeAsync();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape")
        {
            _ = CancelAsync();
        }
    }
}
