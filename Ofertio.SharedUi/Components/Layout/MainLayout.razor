@inherits LayoutComponentBase

<PageTitle>Ofertio - Inteligência em Ofertas</PageTitle>

<div class="portal-shell min-vh-100 d-flex flex-column">
    <ImpersonationBanner />
    <header class="portal-header py-2 py-md-3">
        <div class="container-fluid portal-header-inner d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <button type="button"
                            class="btn btn-outline-secondary portal-nav-toggle btn-touch d-lg-none"
                            aria-controls="portal-sidebar"
                            aria-label="Abrir ou fechar menu"
                            onclick="window.ofertioAppInterop.toggleSidebar(); return false;">
                        <span class="portal-nav-toggle-icon" aria-hidden="true"></span>
                    </button>
                </Authorized>
            </AuthorizeView>

            <div class="flex-grow-1 d-flex align-items-center">
                <a href="/" class="navbar-brand brand-logo-link mb-0" aria-label="Ofertio — Página inicial">
                    <img src="images/logo-ofertio.png" alt="Ofertio — Inteligência em Ofertas" class="brand-logo" />
                </a>
            </div>

            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <UserProfileMenu />
            </div>
        </div>
    </header>
    <AuthorizeView>
        <Authorized>
            <AccessRouteGuard />
            <GlobalAnnouncements />
            <TrialNotice />
        </Authorized>
    </AuthorizeView>

    <div class="portal-body flex-grow-1 d-flex">
        <AuthorizeView>
            <Authorized>
                <aside id="portal-sidebar"
                       class="portal-sidebar"
                       aria-label="Navegação principal">
                    <NavMenu />
                </aside>
                <button type="button"
                        id="portal-sidebar-backdrop"
                        class="portal-sidebar-backdrop d-lg-none"
                        aria-label="Fechar menu"
                        onclick="window.ofertioAppInterop.closeSidebar(); return false;"></button>
            </Authorized>
        </AuthorizeView>

        <main class="portal-main main-content flex-grow-1 container-fluid py-3 py-md-4">
            @Body
        </main>
    </div>

    <footer class="portal-footer py-3 text-center text-muted small">
        &copy; @DateTime.UtcNow.Year Ofertio
        · <a href="mailto:@LegalRoutes.ContactEmail">Fale conosco</a>
    </footer>
</div>

<TermsReacceptanceHost />
<DeepLinkListener />
<NavigationScrollReset />
<LoadingOverlay />
<ConfirmDialogHost />
<ToastContainer />

<div id="blazor-error-ui" class="blazor-error-ui-custom">
    Ocorreu um erro inesperado.
    <a href="" class="reload">Recarregar</a>
    <button type="button" class="btn-close btn-close-white float-end btn-touch" aria-label="Fechar"></button>
</div>

