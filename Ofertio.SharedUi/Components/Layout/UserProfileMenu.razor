@using System.Security.Claims
@* <details> nativo: os layouts são SSR estático, sem circuito Blazor nem bootstrap.js para abrir dropdowns. *@
<AuthorizeView>
    <Authorized>
        @{
            var user = context.User;
            var name = DisplayName(user);
            var email = user.FindFirst(ClaimTypes.Email)?.Value;
            var isAdmin = MasterAccess.IsMaster(user) && !MasterAccess.IsImpersonating(user);
            var masterView = MasterAccess.IsMasterView(user);
        }
        <details class="ofertio-profile-menu" data-profile-menu>
            <summary class="btn btn-sm btn-outline-secondary rounded-pill ofertio-profile-toggle" title="@name">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <span class="ofertio-profile-name d-none d-sm-inline">@name</span>
                <i class="bi bi-chevron-down ofertio-profile-caret" aria-hidden="true"></i>
            </summary>
            <div class="dropdown-menu dropdown-menu-end show ofertio-profile-dropdown" role="menu" aria-label="Menu do perfil">
                <div class="dropdown-header">
                    <div class="fw-semibold text-body text-truncate">@name</div>
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <div class="small text-truncate">@email</div>
                    }
                    @if (isAdmin)
                    {
                        <span class="badge text-bg-warning mt-1">@MasterRoles.Label(MasterAccess.Role(user))</span>
                    }
                </div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/minha-conta" role="menuitem">
                    <i class="bi bi-gear" aria-hidden="true"></i> Minha Conta
                </a>
                <a class="dropdown-item" href="/meus-dados" role="menuitem">
                    <i class="bi bi-person-vcard" aria-hidden="true"></i> Meus dados
                </a>
                <a class="dropdown-item" href="/meu-plano" role="menuitem">
                    <i class="bi bi-credit-card" aria-hidden="true"></i> Meu plano
                </a>
                @if (isAdmin)
                {
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-header small text-uppercase profile-section-title">Visão</div>
                    <a class="dropdown-item @(masterView ? "is-current" : string.Empty)"
                       href="/master/visao/master"
                       data-enhance-nav="false"
                       aria-current="@(masterView ? "true" : null)"
                       role="menuitemradio" aria-checked="@masterView">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i> Painel Master
                        @if (masterView) { <i class="bi bi-check2 profile-view-check" aria-hidden="true"></i> }
                    </a>
                    <a class="dropdown-item @(!masterView ? "is-current" : string.Empty)"
                       href="/master/visao/cliente"
                       data-enhance-nav="false"
                       aria-current="@(!masterView ? "true" : null)"
                       role="menuitemradio" aria-checked="@(!masterView)">
                        <i class="bi bi-person" aria-hidden="true"></i> Visão Cliente
                        @if (!masterView) { <i class="bi bi-check2 profile-view-check" aria-hidden="true"></i> }
                    </a>
                }
                <div class="dropdown-divider"></div>
                <a class="dropdown-item text-danger" href="/auth/logout" data-enhance-nav="false" role="menuitem">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sair
                </a>
            </div>
        </details>
    </Authorized>
    <NotAuthorized>
        <a href="/entrar" class="btn btn-sm btn-primary rounded-pill">Entrar</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string DisplayName(ClaimsPrincipal user)
    {
        var name = user.FindFirst(ClaimTypes.Name)?.Value;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name.Trim();
        }

        var email = user.FindFirst(ClaimTypes.Email)?.Value;
        return string.IsNullOrWhiteSpace(email) ? "Minha conta" : email.Trim();
    }
}
