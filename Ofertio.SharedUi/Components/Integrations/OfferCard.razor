@using Ofertio.Business.Dto
@using Ofertio.Business.Service.Groups
@using Ofertio.Business.Service.LinkStrategies
@using Ofertio.Core.Entities
@using Ofertio.SharedUi.Models
@inject IUserClock Clock

<article class="card border-0 shadow-sm h-100 monitored-offer-card" aria-busy="@(PendingAction is not null ? "true" : "false")">
    <div class="card-body p-3 d-flex flex-column gap-2">
        <div class="d-flex align-items-center justify-content-between gap-2 monitored-offer-header">
            <span class="monitored-offer-captured" title="Capturada em @CapturedAtLabel">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <time datetime="@CapturedAtLocal.ToString("yyyy-MM-ddTHH:mm")">@CapturedAtLabel</time>
            </span>
            <small class="text-muted text-truncate monitored-offer-meta" title="@Item.GroupName">@Item.GroupName</small>
        </div>

        <div class="d-flex gap-2">
            <div class="product-image-preview-box product-image-preview-box--sm flex-shrink-0">
                @if (!string.IsNullOrEmpty(Item.ImageUrl))
                {
                    <img src="@Item.ImageUrl"
                         class="img-fluid rounded product-image-preview-img"
                         alt="@(Item.Title ?? "Oferta capturada")"
                         style="object-fit: contain;"
                         loading="lazy" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light rounded text-muted h-100">
                        <small>Sem imagem</small>
                    </div>
                }
            </div>
            <div class="min-w-0 flex-grow-1">
                <h2 class="fw-semibold mb-1 text-break monitored-offer-title" title="@Item.Title">@(string.IsNullOrWhiteSpace(Item.Title) ? "Oferta capturada" : Item.Title)</h2>
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <span class="fw-bold text-body monitored-offer-price">@(Item.Price?.ToString("C2") ?? "—")</span>
                    @if (!string.IsNullOrWhiteSpace(Item.CouponCode))
                    {
                        <span class="badge badge-sm rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">🎫 @Item.CouponCode</span>
                    }
                    @if (Item.IsLowestPrice30Days)
                    {
                        <span class="badge badge-sm rounded-pill bg-fire" title="Menor Preço dos Últimos 30 Dias">🔥 Menor preço 30d</span>
                    }
                    @if (Item.SavingsVersusAverage is > 0)
                    {
                        <span class="badge badge-sm rounded-pill bg-success" title="Economia vs. Média Histórica">🏷️ -R$ @Item.SavingsVersusAverage.Value.ToString("N2")</span>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-1">
            <span class="marketplace-platform-badge badge-sm @PlatformBadgeHelper.GetPlatformBadgeClass(Item.PlatformName)">
                @PlatformBadgeHelper.GetPlatformLabel(Item.PlatformName, Item.PlatformType)
            </span>
            <span class="badge badge-sm rounded-pill @StatusBadgeClass">@StatusLabel</span>
        </div>

        <button type="button" class="btn btn-outline-primary w-100" title="Comparar preços deste produto em outras lojas" @onclick="() => OnCompare.InvokeAsync(Item)">
            <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Comparar em outras lojas
        </button>

        <div class="monitored-offer-actions mt-auto">
            <a class="btn btn-outline-secondary" href="@OpenUrl" target="_blank" rel="noopener noreferrer" title="Abrir Link Original">
                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                <span>Abrir</span>
            </a>
            <button type="button" class="btn btn-outline-primary" disabled="@IsLocked" title="Verificar anúncio" @onclick="() => OnValidate.InvokeAsync(Item.Id)">
                @ActionIcon(OfferCardAction.Validate, "bi-shield-check")
                <span>@(IsPending(OfferCardAction.Validate) ? "Verificando..." : "Verificar")</span>
            </button>
            @if (ShowIgnored)
            {
                <button type="button" class="btn btn-outline-success" disabled="@IsLocked" title="Restaurar no feed" @onclick="() => OnRestore.InvokeAsync(Item.Id)">
                    @ActionIcon(OfferCardAction.Restore, "bi-arrow-counterclockwise")
                    <span>@(IsPending(OfferCardAction.Restore) ? "Restaurando..." : "Restaurar")</span>
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(IsLocked || !CanClone)"
                        title="@(CanClone ? CloneTitle : "Clonagem indisponível para anúncio esgotado, inativo ou com preço suspeito")"
                        @onclick="() => OnClone.InvokeAsync(Item.Id)">
                    @ActionIcon(OfferCardAction.Clone, "bi-copy")
                    <span>@(IsPending(OfferCardAction.Clone) ? "Clonando..." : "Clonar")</span>
                </button>
                <button type="button" class="btn btn-outline-danger" disabled="@IsLocked" title="Ocultar (sem interesse)" @onclick="() => OnIgnore.InvokeAsync(Item.Id)">
                    @ActionIcon(OfferCardAction.Ignore, "bi-eye-slash")
                    <span>@(IsPending(OfferCardAction.Ignore) ? "Ocultando..." : "Ocultar")</span>
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ScheduleUrl))
        {
            <a class="btn btn-success btn-sm w-100" href="@ScheduleUrl">
                @CloneOfferRules.ScheduleActionLabel
            </a>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public GroupCapturedOfferDto Item { get; set; } = default!;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public OfferCardAction? PendingAction { get; set; }

    [Parameter]
    public bool ShowIgnored { get; set; }

    [Parameter]
    public bool IsTelegram { get; set; }

    [Parameter]
    public string? ScheduleUrl { get; set; }

    [Parameter]
    public EventCallback<int> OnValidate { get; set; }

    [Parameter]
    public EventCallback<int> OnClone { get; set; }

    [Parameter]
    public EventCallback<int> OnIgnore { get; set; }

    [Parameter]
    public EventCallback<int> OnRestore { get; set; }

    [Parameter]
    public EventCallback<GroupCapturedOfferDto> OnCompare { get; set; }

    private bool IsLocked => IsBusy || PendingAction is not null;

    private bool IsPending(OfferCardAction action) => PendingAction == action;

    private RenderFragment ActionIcon(OfferCardAction action, string icon) => IsPending(action)
        ? @<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        : @<i class="bi @icon" aria-hidden="true"></i>;

    private bool IsInactive => !Item.IsAvailable || GroupOfferStatuses.IsInactive(Item.OfferStatus);

    private bool CanClone =>
        !IsInactive && Item.OfferStatus != GroupOfferStatuses.PrecoSuspeito;

    private string CloneTitle => IsTelegram ? "Clonar Oferta" : "Clonar para Minha Campanha";

    private DateTime CapturedAtLocal => Clock.ToLocal(Item.ReceivedAt);

    protected override Task OnInitializedAsync() => Clock.EnsureLoadedAsync();

    private string CapturedAtLabel => CapturedAtLocal.ToString("dd/MM/yyyy HH:mm");

    private string StatusLabel => IsInactive && !GroupOfferStatuses.IsInactive(Item.OfferStatus)
        ? "Esgotado"
        : Item.OfferStatusLabel;

    private string OpenUrl =>
        string.IsNullOrWhiteSpace(Item.AffiliateUrl)
            ? AffiliateUrlBuilderRules.Build(Item.OriginalUrl, Item.PrimaryProductUrl, Item.PlatformType, null)
            : Item.AffiliateUrl;

    private string StatusBadgeClass => IsInactive
        ? "bg-danger-subtle text-danger-emphasis border border-danger-subtle"
        : Item.OfferStatus switch
        {
            GroupOfferStatuses.Ativo => "bg-success-subtle text-success-emphasis border border-success-subtle",
            GroupOfferStatuses.PrecoAlterado => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            GroupOfferStatuses.PrecoSuspeito => "bg-warning-subtle text-danger-emphasis border border-danger-subtle",
            _ => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle"
        };
}
