# Kit base: estilo e analisadores (.NET)
# Severidades começam conservadoras (suggestion/warning). Subir para error só depois de zerar a dívida.
# Referência: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/configuration-files

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Scripts PowerShell: UTF-8 com BOM, porque o Windows PowerShell 5.1 lê arquivo sem BOM como ANSI e quebra acentos (docs/projeto/encoding-e-legado.md).
[*.ps1]
charset = utf-8-bom

[*.{json,yml,yaml,csproj,props,targets,xml,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
# --- Organização ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_namespace_match_folder = true:suggestion

# --- Preferências de linguagem ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_throw_expression = true:suggestion

# --- Nomenclatura ---
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = suggestion

# --- Analisadores de qualidade e segurança (CA) ---
# Async e confiabilidade
dotnet_diagnostic.CA2007.severity = none          # ConfigureAwait: desnecessário em ASP.NET Core
dotnet_diagnostic.CA2012.severity = error         # ValueTask usado errado
dotnet_diagnostic.CA2016.severity = warning       # repassar CancellationToken
dotnet_diagnostic.CA1849.severity = suggestion    # chamar versão assíncrona quando existir
# Logs
dotnet_diagnostic.CA2254.severity = warning       # template de log constante (sem interpolação)
dotnet_diagnostic.CA1848.severity = none          # LoggerMessage delegates: custo/benefício baixo neste porte
# Exceções
dotnet_diagnostic.CA2200.severity = error         # throw ex; perde a pilha
dotnet_diagnostic.CA1031.severity = none          # catch genérico: tratado em revisão (regra codigo-csharp §6)
# Segurança
dotnet_diagnostic.CA2100.severity = error         # SQL montado com entrada
dotnet_diagnostic.CA5350.severity = warning       # algoritmo criptográfico fraco
dotnet_diagnostic.CA5351.severity = error         # algoritmo criptográfico quebrado (MD5/DES)
dotnet_diagnostic.CA3075.severity = error         # XML inseguro
dotnet_diagnostic.CA5394.severity = suggestion    # Random inseguro (só onde for segurança)
# Ruído que não compensa neste porte
dotnet_diagnostic.CA1062.severity = none          # validar argumentos públicos (Nullable cobre)
dotnet_diagnostic.CA1303.severity = none          # literais localizados
dotnet_diagnostic.CA1305.severity = suggestion    # IFormatProvider
dotnet_diagnostic.CA1707.severity = none          # underscore em nomes de teste
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA2227.severity = none          # setter de coleção em DTO
dotnet_diagnostic.CA1002.severity = none          # List<T> em DTO
dotnet_diagnostic.CA1056.severity = none          # Uri em vez de string
dotnet_diagnostic.CA1054.severity = none

# --- Estilo de código (IDE) com efeito no build quando EnforceCodeStyleInBuild=true ---
dotnet_diagnostic.IDE0005.severity = warning      # using desnecessário (exige GenerateDocumentationFile)
dotnet_diagnostic.IDE0161.severity = warning      # namespace com escopo de arquivo
dotnet_diagnostic.IDE0055.severity = warning      # formatação

[**/Migrations/*.cs]
# Código gerado pelo EF Core: não analisar estilo
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[*Tests.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
