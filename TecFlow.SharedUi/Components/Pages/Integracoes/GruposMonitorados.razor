@page "/integracoes/whatsapp/grupos/monitorados"
@page "/integracoes/telegram/grupos/monitorados"
@page "/integracoes/grupos/monitorados"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Business.Service.Groups
@using TecFlow.Business.Service.LinkStrategies
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Helpers
@using TecFlow.SharedUi.Services.Integrations
@using TecFlow.SharedUi.Services.UI
@inject IMonitoredGroupsApiService Api
@inject IModalService ModalService
@inject NavigationManager Navigation
@inject ILogger<GruposMonitorados> Logger
@implements IAsyncDisposable

<PageTitle>Grupos monitorados @ChannelLabel — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <h1 class="h3 fw-bold mb-0">Grupos monitorados</h1>
                <span class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 text-white" style="background-color: @(IsTelegram ? "#0088cc" : "#25D366");">
                    <i class="bi @(IsTelegram ? "bi-telegram" : "bi-whatsapp")" aria-hidden="true"></i>
                    <span>@ChannelLabel</span>
                </span>
            </div>
            <p class="text-muted small mb-0">
                Sincronize os grupos do @ChannelLabel, filtre as ofertas capturadas e clone o link de comissão para o agendador.
                @if (IsTelegram)
                {
                    <span> A escuta UserBot (ApiId/ApiHash) captura canais de terceiros como Pelando e PC do Fafa.</span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary btn-touch" disabled="@_isBusy" @onclick="RefreshFeedAsync">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                Atualizar Feed
            </button>
            @if (IsTelegram)
            {
                <button type="button" class="btn btn-outline-danger btn-touch me-2" disabled="@(_isProcessing || _isBusy || _isSyncing)" @onclick="HandleResetAllAsync">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    Limpar
                </button>
            }
            <button type="button" class="btn btn-primary btn-touch" disabled="@_isSyncing" @onclick="SyncAsync">
                @(_isSyncing ? "Sincronização em andamento" : $"Sincronizar grupos do {ChannelLabel}")
            </button>
        </div>
    </div>
    @if (_isSyncing)
    {
        <div class="mb-3">
            <span class="badge rounded-pill text-bg-info px-3 py-2 d-inline-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Sincronizando novas ofertas em background...</span>
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small" role="status">@_info</div>
    }
    @if (!string.IsNullOrWhiteSpace(_toastMessage))
    {
        <div class="toast show campaign-toast @(_toastSuccess ? "text-bg-success" : "text-bg-danger")" role="status" aria-live="polite">
            <div class="toast-body">@_toastMessage</div>
        </div>
    }

    <form class="row g-2 align-items-end mb-4" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault="true">
        <div class="col-12 col-md-4">
            <label class="form-label fw-semibold" for="live-search-q">Busca rápida</label>
            <input id="live-search-q" class="form-control" placeholder="Palavra-chave, cupom ou loja" @bind="_searchKeyword" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold" for="live-search-min">Preço mín.</label>
            <input id="live-search-min" class="form-control" type="number" step="0.01" min="0" @bind="_minPrice" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold" for="live-search-max">Preço máx.</label>
            <input id="live-search-max" class="form-control" type="number" step="0.01" min="0" @bind="_maxPrice" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label fw-semibold" for="live-search-store">Loja</label>
            <input id="live-search-store" class="form-control" placeholder="Shopee, ML..." @bind="_store" />
        </div>
        <div class="col-6 col-md-2 form-check mt-4">
            <input id="live-search-coupon" class="form-check-input" type="checkbox" @bind="_couponOnly" />
            <label class="form-check-label" for="live-search-coupon">Só com cupom</label>
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        </div>
    </form>

        <div class="d-flex flex-wrap align-items-end gap-3 mb-4">
            <div>
                <span class="form-label fw-semibold d-block">Período</span>
                <div class="btn-group" role="group" aria-label="Filtro de período">
                    <button type="button" class="btn btn-sm @ChipClass(10)" @onclick="() => SetHoursAsync(10)">Últimas 10 horas</button>
                    <button type="button" class="btn btn-sm @ChipClass(24)" @onclick="() => SetHoursAsync(24)">Últimas 24 horas</button>
                    <button type="button" class="btn btn-sm @ChipClass(48)" @onclick="() => SetHoursAsync(48)">Últimos 2 dias</button>
                </div>
            </div>
            <div class="flex-grow-1" style="min-width: 16rem;">
                <label class="form-label fw-semibold" for="monitored-group">Grupo selecionado</label>
                <select id="monitored-group" class="form-select" value="@_groupKey" @onchange="OnGroupChanged">
                    <option value="">Todos os grupos</option>
                    @foreach (var group in _groups)
                    {
                        <option value="@group.GroupKey">@group.Name</option>
                    }
                </select>
            </div>
            @if (!GroupOfferCaptureRules.TemporaryLimitTenOffers)
            {
                <div>
                    <label class="form-label fw-semibold" for="monitored-page-size">Ofertas por página</label>
                    <select id="monitored-page-size" class="form-select" value="@_pageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in GroupOfferCaptureRules.AllowedPageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="text-muted small">Exibindo até 10 ofertas (limite temporário).</div>
            }
        </div>

    <div class="mb-4">
        <span class="form-label fw-semibold d-block">Lista</span>
        <div class="btn-group flex-wrap" role="group" aria-label="Filtro do feed">
            <button type="button" class="btn btn-sm @FeedChipClass(false)" @onclick="() => SetIgnoredFeedAsync(false)">Feed de Ofertas</button>
            <button type="button" class="btn btn-sm @FeedChipClass(true)" @onclick="() => SetIgnoredFeedAsync(true)">Ocultos / Descartados</button>
        </div>
    </div>

    @if (_offers.Count == 0)
    {
        <div class="alert alert-light border">
            @if (_groups.Count > 0)
            {
                <span>@_groups.Count grupo(s) do @ChannelLabel. @(_showIgnored ? "Nenhuma oferta ocultada neste período." : "Nenhuma oferta das suas lojas ativas neste período.")</span>
            }
            else
            {
                <span>Nenhum grupo do @ChannelLabel listado. Sincronize e aguarde mensagens com links.</span>
            }
        </div>
    }
    else
    {
        @Pager
        <div class="row g-3">
            @foreach (var item in _offers)
            {
                <div class="col-12 col-md-6 col-xl-4" @key="item.Id">
                    <article class="card border-0 shadow-sm h-100 monitored-offer-card">
                        <div class="card-body">
                            <div class="d-flex gap-3 mb-3">
                                <div class="product-image-preview-box product-image-preview-box--sm">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             class="img-fluid card-img-top rounded product-image-preview-img"
                                             alt="@(item.Title ?? "Oferta capturada")"
                                             style="max-height: 180px; object-fit: contain;"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light rounded text-muted" style="height: 140px;">
                                            <small>Sem imagem</small>
                                        </div>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <h2 class="h6 fw-semibold mb-1 text-break monitored-offer-title">@(string.IsNullOrWhiteSpace(item.Title) ? "Oferta capturada" : item.Title)</h2>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="badge text-bg-light border">
                                            <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                            @(item.Price?.ToString("C2") ?? "—")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.CouponCode))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success me-1">🎫 @item.CouponCode</span>
                                        }
                                        @if (item.IsLowestPrice30Days)
                                        {
                                            <span class="badge bg-fire">🔥 Menor Preço dos Últimos 30 Dias</span>
                                        }
                                        @if (item.SavingsVersusAverage is > 0)
                                        {
                                            <span class="badge bg-success">🏷️ Economia de R$ @item.SavingsVersusAverage.Value.ToString("N2") vs. Média Histórica</span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-0">@item.GroupName · @item.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm")</p>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                <span class="marketplace-platform-badge @PlatformBadgeHelper.GetPlatformBadgeClass(item.PlatformName)">
                                    @PlatformBadgeHelper.GetPlatformLabel(item.PlatformName, item.PlatformType)
                                </span>
                                @if (!item.IsAvailable || item.OfferStatus == GroupOfferStatuses.Esgotado)
                                {
                                    <span class="badge text-bg-secondary border border-danger">Esgotado</span>
                                }
                                else
                                {
                                    <span class="badge @StatusBadgeClass(item.OfferStatus)">@item.OfferStatusLabel</span>
                                }
                            </div>
                            <div class="monitored-offer-actions">
                                <a class="btn btn-outline-secondary w-100" href="@item.OriginalUrl" target="_blank" rel="noopener noreferrer">
                                    Abrir Link Original
                                </a>
                                <button type="button" class="btn btn-outline-primary w-100" disabled="@_isBusy" @onclick="() => ValidateAsync(item.Id)">
                                    Verificar anúncio
                                </button>
                                @if (_showIgnored)
                                {
                                    <button type="button" class="btn btn-outline-success w-100" disabled="@_isBusy" @onclick="() => RestoreAsync(item.Id)">
                                        Restaurar
                                    </button>
                                    <span></span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary w-100" disabled="@_isBusy" @onclick="() => CloneAsync(item.Id)">
                                        @(IsTelegram ? "Clonar Oferta" : "Clonar para Minha Campanha")
                                    </button>
                                    <button type="button" class="btn btn-outline-danger w-100" disabled="@_isBusy" @onclick="() => MarkAsUninterested(item.Id)">
                                        Sem interesse
                                    </button>
                                }
                            </div>
                            @if (IsTelegram && !_showIgnored && _clonedOfferId == item.Id && !string.IsNullOrWhiteSpace(_scheduleUrl))
                            {
                                <a class="btn btn-success w-100 mt-2" href="@_scheduleUrl">
                                    @CloneOfferRules.ScheduleActionLabel
                                </a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
        @Pager
    }
</div>

@code {
    private const string WhatsAppPath = "/integracoes/whatsapp/grupos/monitorados";
    private const string TelegramPath = "/integracoes/telegram/grupos/monitorados";
    private const string LegacyPath = "/integracoes/grupos/monitorados";

    private readonly List<MonitoredGroupDto> _groups = [];
    private readonly List<GroupCapturedOfferDto> _offers = [];
    private int _hours = 24;
    private int _totalOffers;
    private int _page = 1;
    private int _pageSize = GroupOfferCaptureRules.OffersPageSize;
    private string? _searchKeyword;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private string? _store;
    private bool _couponOnly;
    private string _groupKey = string.Empty;
    private bool _isBusy;
    private bool _isSyncing;
    private bool _isProcessing;
    private string? _error;
    private string? _info;
    private string? _toastMessage;
    private bool _toastSuccess;
    private string? _scheduleUrl;
    private int? _clonedOfferId;
    private bool _showIgnored;
    private CancellationTokenSource? _refreshCts;

    private bool IsTelegram => CurrentPath().Equals(TelegramPath, StringComparison.OrdinalIgnoreCase);

    private string Channel => IsTelegram
        ? GroupOfferCaptureRules.TelegramChannel
        : GroupOfferCaptureRules.WhatsAppChannel;

    private string ChannelLabel => IsTelegram ? "Telegram" : "WhatsApp";

    private int TotalPages => GroupOfferCaptureRules.ResolveTotalPages(_totalOffers, _pageSize);

    private int DisplayStart => _totalOffers == 0 ? 0 : ((_page - 1) * _pageSize) + 1;

    private int DisplayEnd => Math.Min(_page * _pageSize, _totalOffers);

    private RenderFragment Pager => @<nav class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 my-3" aria-label="Paginação de ofertas">
        <p class="text-muted small mb-0">Exibindo @DisplayStart a @DisplayEnd de @_totalOffers ofertas</p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_isBusy || _page <= 1)" @onclick="() => SetPageAsync(_page - 1)">Anterior</button>
            @foreach (var pageNumber in VisiblePages())
            {
                <button type="button" class="btn btn-sm @(_page == pageNumber ? "btn-primary" : "btn-outline-secondary")" disabled="@_isBusy" @onclick="() => SetPageAsync(pageNumber)">@pageNumber</button>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_isBusy || _page >= TotalPages)" @onclick="() => SetPageAsync(_page + 1)">Próximo</button>
        </div>
    </nav>;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentPath().Equals(LegacyPath, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(WhatsAppPath, replace: true);
            return;
        }

        await LoadAsync();
        if (IsTelegram)
        {
            StartOfferRefresh();
        }
    }

    private string CurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrEmpty(relative) ? "/" : "/" + relative.Split('?', '#')[0];
    }

    private string ChipClass(int hours) =>
        _hours == hours ? "btn-primary" : "btn-outline-secondary";

    private string FeedChipClass(bool ignored) =>
        _showIgnored == ignored ? "btn-primary" : "btn-outline-secondary";

    private Task SetIgnoredFeedAsync(bool ignored)
    {
        _showIgnored = ignored;
        _page = 1;
        return LoadAsync();
    }

    private static string StatusBadgeClass(string? status) => status switch
    {
        GroupOfferStatuses.Ativo => "text-bg-success",
        GroupOfferStatuses.Esgotado => "text-bg-danger",
        GroupOfferStatuses.PrecoAlterado => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private Task ApplySearchAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private LiveSearchFilterDto? BuildSearch()
    {
        var filter = new LiveSearchFilterDto
        {
            Keyword = _searchKeyword,
            MinPrice = _minPrice,
            MaxPrice = _maxPrice,
            HasCoupon = _couponOnly ? true : null,
            Store = _store
        };
        return filter.HasAny ? filter : null;
    }

    private Task SetHoursAsync(int hours)
    {
        _hours = hours;
        _page = 1;
        return LoadAsync();
    }

    private Task OnGroupChanged(ChangeEventArgs e)
    {
        _groupKey = e.Value?.ToString() ?? string.Empty;
        _page = 1;
        return LoadAsync();
    }

    private Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size))
        {
            size = GroupOfferCaptureRules.OffersPageSize;
        }

        _pageSize = GroupOfferCaptureRules.ResolveOffersTake(size);
        _page = 1;
        return LoadAsync();
    }

    private Task SetPageAsync(int page)
    {
        _page = GroupOfferCaptureRules.ResolveOffersPage(page);
        return LoadAsync();
    }

    private IEnumerable<int> VisiblePages()
    {
        var total = TotalPages;
        var start = Math.Max(1, _page - 2);
        var end = Math.Min(total, start + 4);
        start = Math.Max(1, end - 4);
        for (var i = start; i <= end; i++)
        {
            yield return i;
        }
    }

    private async Task RefreshFeedAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task HandleResetAllAsync()
    {
        if (!IsTelegram || _isProcessing)
        {
            return;
        }

        var confirmed = await ModalService.ConfirmAsync(new ConfirmDialogRequest
        {
            Title = "Limpar ofertas capturadas",
            Message = "Isso apaga as ofertas capturadas e as imagens em uploads/products deste usuário. Depois use Sincronizar grupos para recarregar. Continuar?",
            ConfirmText = "Limpar",
            CancelText = "Cancelar",
            Kind = ConfirmDialogKind.Danger
        });
        if (!confirmed)
        {
            return;
        }

        try
        {
            _isProcessing = true;
            StateHasChanged();
            _error = null;
            _info = null;

            var result = await Api.ResetAndResyncAsync(Channel);

            _offers.Clear();
            _totalOffers = 0;
            _page = 1;
            StateHasChanged();

            if (result.Success || result.Data is { Status: true })
            {
                _info = string.IsNullOrWhiteSpace(result.Data?.Descricao)
                    ? "Banco de dados e imagens zerados. Use Sincronizar grupos para recarregar."
                    : result.Data.Descricao;
                _ = ShowToastAsync(_info, success: true);
                return;
            }

            var fail = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível limpar o feed.";
            _error = fail;
            _ = ShowToastAsync($"Falha ao limpar: {fail}", success: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao limpar dados");
            _error = $"Falha ao limpar: {ex.Message}";
            _ = ShowToastAsync($"Falha ao limpar: {ex.Message}", success: false);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SyncAsync()
    {
        _error = null;
        _info = null;
        try
        {
            var result = await Api.SyncAsync(Channel);
            if (result.Success || result.Data is { Status: true })
            {
                _isSyncing = true;
                _info = string.IsNullOrWhiteSpace(result.Data?.Descricao)
                    ? MonitoredGroupSyncRules.BackgroundStartedMessage
                    : result.Data.Descricao;
                if (result.Data is not null)
                {
                    Apply(result.Data, null, append: false, silent: true);
                }

                StartOfferRefresh();
                _ = StopSyncingBadgeAsync();
                return;
            }

            _error = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível sincronizar os grupos.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao sincronizar grupos monitorados.");
            _error = "Não foi possível sincronizar os grupos.";
        }
    }

    private async Task StopSyncingBadgeAsync()
    {
        try
        {
            await Task.Delay(MonitoredGroupSyncRules.ClientTimeout);
            _isSyncing = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadAsync(bool silent = false, bool append = false)
    {
        if (!silent)
        {
            _isBusy = true;
            _error = null;
        }
        try
        {
            var skip = GroupOfferCaptureRules.ResolveOffersSkipFromPage(_page, _pageSize);
            var result = await Api.ListAsync(
                _hours,
                string.IsNullOrWhiteSpace(_groupKey) ? null : _groupKey,
                Channel,
                skip,
                _pageSize,
                _showIgnored,
                BuildSearch());
            if (result.Data is not null)
            {
                Apply(result.Data, silent ? null : result.ErrorMessage, append, silent);
            }
            else if (!silent)
            {
                Apply(null, result.ErrorMessage, append: false, silent: false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao listar ofertas monitoradas.");
            if (!silent)
            {
                _error = "Não foi possível carregar as ofertas.";
            }
        }
        finally
        {
            if (!silent)
            {
                _isBusy = false;
            }
        }
    }

    private void StartOfferRefresh()
    {
        _refreshCts?.Cancel();
        _refreshCts = new CancellationTokenSource();
        _ = RefreshOffersLoopAsync(_refreshCts.Token);
    }

    private async Task RefreshOffersLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(_isSyncing ? TimeSpan.FromSeconds(8) : TimeSpan.FromSeconds(20));
        try
        {
            await PollSyncStatusAsync();
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await PollSyncStatusAsync();
                await LoadAsync(silent: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollSyncStatusAsync()
    {
        if (!IsTelegram)
        {
            return;
        }

        try
        {
            var result = await Api.GetSyncStatusAsync();
            var status = result.Data;
            if (status is null)
            {
                return;
            }

            if (status.IsFailed)
            {
                _isSyncing = false;
                _error = status.Message;
                _ = ShowToastAsync(status.Message, success: false);
                return;
            }

            if (status.IsCompleted && _isSyncing)
            {
                _isSyncing = false;
                _info = status.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao consultar status da sincronização UserBot.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCts is not null)
        {
            await _refreshCts.CancelAsync();
            _refreshCts.Dispose();
        }
    }

    private async Task ValidateAsync(int offerId)
    {
        _isBusy = true;
        _error = null;
        try
        {
            var result = await Api.ValidateAsync(offerId, Channel);
            Apply(result.Data, result.ErrorMessage, append: false, silent: false);
            _info = result.Data?.Descricao;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao validar oferta {OfferId}.", offerId);
            _error = "Não foi possível validar o anúncio.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task MarkAsUninterested(int offerId)
    {
        _isBusy = true;
        _error = null;
        try
        {
            var result = await Api.IgnoreAsync(offerId, Channel);
            if (result.Data is { Status: true })
            {
                _info = result.Data.Descricao;
                await LoadAsync();
                return;
            }

            _error = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível ocultar a oferta.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao ocultar oferta {OfferId}.", offerId);
            _error = "Não foi possível marcar a oferta como sem interesse.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RestoreAsync(int offerId)
    {
        _isBusy = true;
        _error = null;
        try
        {
            var result = await Api.RestoreAsync(offerId, Channel);
            if (result.Data is { Status: true })
            {
                _info = result.Data.Descricao;
                await LoadAsync();
                return;
            }

            _error = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível restaurar a oferta.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao restaurar oferta {OfferId}.", offerId);
            _error = "Não foi possível restaurar a oferta.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CloneAsync(int offerId)
    {
        _isBusy = true;
        _error = null;
        _toastMessage = null;
        try
        {
            var result = await Api.CloneAsync(offerId, Channel);
            if (result.Data is { Status: true, Clone.AffiliateUrl: { Length: > 0 } })
            {
                Apply(result.Data, null, append: false, silent: false);
                _clonedOfferId = offerId;
                _scheduleUrl = result.Data.Clone.RedirectUrl;
                _info = result.Data.Descricao;
                await ShowToastAsync(CloneOfferRules.SuccessToast, success: true);
                if (!IsTelegram && !string.IsNullOrWhiteSpace(result.Data.Clone.RedirectUrl))
                {
                    Navigation.NavigateTo(result.Data.Clone.RedirectUrl);
                }

                return;
            }

            Apply(result.Data, result.ErrorMessage, append: false, silent: false);
            _error = result.Data?.Descricao ?? result.ErrorMessage ?? "Não foi possível clonar a oferta.";
            await ShowToastAsync(_error, success: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao clonar oferta {OfferId}.", offerId);
            _error = "Não foi possível converter o link de comissão.";
            await ShowToastAsync(_error, success: false);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ShowToastAsync(string message, bool success)
    {
        _toastMessage = message;
        _toastSuccess = success;
        StateHasChanged();
        await Task.Delay(4500);
        _toastMessage = null;
        StateHasChanged();
    }

    private static string FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value.Trim();
            }
        }

        return string.Empty;
    }

    private void Apply(MonitoredGroupsResponseDto? data, string? error, bool append, bool silent)
    {
        if (data is null)
        {
            if (!silent)
            {
                _error = error ?? "Resposta vazia da API.";
            }

            return;
        }

        _groups.Clear();
        _groups.AddRange(data.Groups);
        _totalOffers = data.TotalOffers;
        var maxPage = GroupOfferCaptureRules.ResolveTotalPages(_totalOffers, _pageSize);
        if (_page > maxPage)
        {
            _page = maxPage;
        }

        var incoming = GroupOfferCaptureRules.DeduplicateOffers(data.Offers);
        if (append)
        {
            foreach (var offer in incoming)
            {
                if (_offers.Exists(existing => GroupOfferCaptureRules.IsSameCapturedOffer(existing, offer)))
                {
                    continue;
                }

                _offers.Add(offer);
            }
        }
        else
        {
            _offers.Clear();
            _offers.AddRange(incoming);
        }

        if (!data.Status)
        {
            _error = FirstNonEmpty(data.Descricao, error, "Não foi possível carregar os grupos monitorados.");
        }
    }
}
