@if (_user is not null && MasterAccess.IsImpersonating(_user))
{
    <div class="alert alert-warning rounded-0 border-0 border-bottom border-warning mb-0 py-2 sticky-top d-flex flex-wrap align-items-center justify-content-center gap-2"
         role="alert" style="z-index: 1080;">
        <span>⚠️ Você está navegando como o tenant <strong>@MasterAccess.ImpersonatedTenant(_user)</strong>.</span>
        <a href="/master/emular/sair" data-enhance-nav="false" class="btn btn-sm btn-dark">Voltar ao Painel Master</a>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            _user = (await AuthenticationStateTask).User;
        }
    }
}
