@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ISystemCommunicationApiService MenuApi
@implements IDisposable
@using System.Security.Claims
@using System.Text.Json

<nav class="portal-sidebar-nav" aria-label="Menu principal">
    <AuthorizeView>
        <Authorized>
            @if (MasterAccess.IsMasterView(context.User))
            {
                <a href="@MasterRoutes.Dashboard" class="portal-nav-link portal-nav-parent" @onclick="NotifyNavigate">
                    <i class="bi bi-shield-shaded portal-nav-icon" aria-hidden="true"></i>
                    <span class="portal-nav-link-label">Painel Master</span>
                </a>
            }

            @FavoritesBlock

            @{ var afterCategory = false; }
            @foreach (var node in _menu)
            {
                if (IsCategory(node))
                {
                    @CategoryBlock(node)
                    afterCategory = true;
                    continue;
                }

                if (afterCategory)
                {
                    <hr class="portal-nav-divider" />
                    afterCategory = false;
                }

                @ParentItem(node)
            }
        </Authorized>
        <NotAuthorized>
            <a href="/" class="portal-nav-link @GetActiveClass("/")" @onclick="NotifyNavigate">
                <i class="bi bi-box-arrow-in-right portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">Entrar</span>
            </a>
            <a href="/recuperar-senha" class="portal-nav-link @GetActiveClass("/recuperar-senha")" @onclick="NotifyNavigate">
                <i class="bi bi-key portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">Recuperar senha</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>
    <a href="/" class="portal-nav-link @GetActiveClass("/")" @onclick="NotifyNavigate">
        <i class="bi bi-house portal-nav-icon" aria-hidden="true"></i>
        <span class="portal-nav-link-label">Início</span>
    </a>
</nav>

@code {
    private const int MaxFavorites = 8;
    private const string FavoritesStoragePrefix = "ofertio.menu.favorites.";

    private static IReadOnlyDictionary<string, string[]> RouteAliases => DefaultMenuCatalog.RouteAliases;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ClientMenuNodeDto> _menu = [];
    private readonly HashSet<string> _openGroups = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _favorites = [];
    private string? _storageKey;
    private string? _favoritesNotice;
    private bool _authenticated;
    private bool _clientView;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var user = AuthenticationStateTask is null ? null : (await AuthenticationStateTask).User;
        _authenticated = user?.Identity?.IsAuthenticated == true;
        _clientView = MasterAccess.IsMaster(user) && !MasterAccess.IsMasterView(user);
        var userId = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user?.Identity?.Name;
        _storageKey = string.IsNullOrWhiteSpace(userId) ? null : FavoritesStoragePrefix + userId;
        await LoadMenuAsync();
        OpenGroupsForCurrentPath();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_authenticated || _storageKey is null)
        {
            return;
        }

        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", _storageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                _favorites = JsonSerializer.Deserialize<List<string>>(json) ?? [];
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JsonException or InvalidOperationException or JSException)
        {
            // Sem armazenamento local (aba privada ou circuito caído): o menu segue sem favoritos.
        }
    }

    private async Task TogglePinAsync(string key)
    {
        _favoritesNotice = null;
        if (!_favorites.Remove(key))
        {
            if (_favorites.Count >= MaxFavorites)
            {
                _favoritesNotice = $"Limite de {MaxFavorites} favoritos. Desafixe um para fixar outro.";
                return;
            }

            _favorites.Add(key);
        }

        if (_storageKey is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", _storageKey, JsonSerializer.Serialize(_favorites));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // Favoritos continuam valendo nesta sessão mesmo sem gravar no navegador.
        }
    }

    private List<ClientMenuNodeDto> FavoriteNodes()
    {
        var leaves = AllNodes(_menu)
            .Where(node => !IsFolder(node) && !string.IsNullOrWhiteSpace(node.Route))
            .GroupBy(node => node.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
        return _favorites.Where(leaves.ContainsKey).Select(key => leaves[key]).ToList();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <summary>Árvore vem de MenuItems + PlanMenuPermissions; o catálogo local só cobre falha da API.</summary>
    private async Task LoadMenuAsync()
    {
        if (!_authenticated)
        {
            return;
        }

        var result = await MenuApi.ClientMenuAsync(_clientView);
        if (result.Success && result.Data is { Count: > 0 })
        {
            _menu = result.Data;
        }
        else if (_menu.Count == 0)
        {
            _menu = DefaultMenuCatalog.BuildDefaultTree();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            await LoadMenuAsync();
            OpenGroupsForCurrentPath();
            StateHasChanged();
        });

    private string? _lastActiveCategory;

    private void OpenGroupsForCurrentPath()
    {
        // Ao entrar em outra categoria (por link, favorito ou botão voltar), ela abre e as demais fecham.
        var activeCategory = _menu.Where(IsCategory).FirstOrDefault(IsGroupActive)?.Key;
        if (activeCategory is not null && !activeCategory.Equals(_lastActiveCategory, StringComparison.OrdinalIgnoreCase))
        {
            CloseOtherCategories(activeCategory);
        }

        _lastActiveCategory = activeCategory;

        foreach (var group in AllNodes(_menu).Where(node => IsFolder(node) && IsGroupActive(node)))
        {
            _openGroups.Add(group.Key);
        }
    }

    private static IEnumerable<ClientMenuNodeDto> AllNodes(IEnumerable<ClientMenuNodeDto> nodes) =>
        nodes.SelectMany(node => AllNodes(node.Children).Prepend(node));

    /// <summary>Pasta na raiz = categoria (cabeçalho); os filhos dela são os menus pai.</summary>
    private bool IsCategory(ClientMenuNodeDto node) =>
        IsFolder(node) && _menu.Contains(node);

    private static bool IsFolder(ClientMenuNodeDto node) =>
        node.IsFolder || (string.IsNullOrWhiteSpace(node.Route) && node.Children.Count > 0);

    private RenderFragment Badge(ClientMenuNodeDto node) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(node.Badge))
        {
            <span class="portal-nav-soon">@node.Badge</span>
        }
    };

    /// <summary>Categoria recolhível: começa fechada e abre sozinha quando a página atual está dentro dela.</summary>
    private RenderFragment CategoryBlock(ClientMenuNodeDto node) => __builder =>
    {
        var open = _openGroups.Contains(node.Key);
        <div class="portal-nav-section">
            <button type="button"
                    class="portal-nav-category portal-nav-category-toggle @(IsGroupActive(node) ? "has-active" : string.Empty)"
                    aria-expanded="@open"
                    @onclick="() => ToggleGroup(node.Key)">
                <span>@node.Title</span>
                <i class="bi bi-chevron-down portal-nav-caret transform transition-transform @(open ? "rotate-180" : string.Empty)" aria-hidden="true"></i>
            </button>
            @if (open)
            {
                <div class="portal-nav-section-body">
                    @foreach (var child in node.Children)
                    {
                        @ParentItem(child)
                    }
                </div>
            }
        </div>
    };

    private RenderFragment FavoritesBlock => __builder =>
    {
        var favorites = FavoriteNodes();
        if (favorites.Count == 0 && _favoritesNotice is null)
        {
            return;
        }

        <div class="portal-nav-section portal-nav-favorites">
            <div class="portal-nav-category portal-nav-category-static">
                <span><i class="bi bi-pin-angle-fill me-1" aria-hidden="true"></i>Favoritos</span>
            </div>
            <div class="portal-nav-section-body">
                @foreach (var favorite in favorites)
                {
                    @LeafLink(favorite, "portal-nav-sublink")
                }
                @if (_favoritesNotice is not null)
                {
                    <p class="portal-nav-notice" role="status">@_favoritesNotice</p>
                }
            </div>
        </div>
        <hr class="portal-nav-divider" />
    };

    /// <summary>Item de menu com o alfinete de favorito ao lado (fora do link, para não aninhar controles).</summary>
    private RenderFragment LeafLink(ClientMenuNodeDto node, string levelClass) => __builder =>
    {
        var pinned = _favorites.Contains(node.Key, StringComparer.OrdinalIgnoreCase);
        <div class="portal-nav-item">
            <a href="@node.Route" class="portal-nav-link @levelClass @GetActiveClass(node.Route)" @onclick="NotifyNavigate">
                <i class="bi @node.Icon portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">@node.Title</span>
                @Badge(node)
            </a>
            <button type="button"
                    class="portal-nav-pin @(pinned ? "is-pinned" : string.Empty)"
                    aria-pressed="@pinned"
                    aria-label="@(pinned ? "Desafixar" : "Fixar nos favoritos"): @node.Title"
                    title="@(pinned ? "Desafixar dos favoritos" : "Fixar nos favoritos")"
                    @onclick="() => TogglePinAsync(node.Key)">
                <i class="bi @(pinned ? "bi-pin-angle-fill" : "bi-pin-angle")" aria-hidden="true"></i>
            </button>
        </div>
    };

    private RenderFragment ParentItem(ClientMenuNodeDto node) => __builder =>
    {
        if (!IsFolder(node))
        {
            @LeafLink(node, "portal-nav-parent")
            return;
        }

        @GroupItem(node, "portal-nav-parent")
    };

    private RenderFragment GroupItem(ClientMenuNodeDto node, string levelClass) => __builder =>
    {
        var open = _openGroups.Contains(node.Key);
        <div class="portal-nav-group">
            <button type="button"
                    class="portal-nav-link @levelClass portal-nav-group-toggle @(IsGroupActive(node) ? "active" : string.Empty)"
                    aria-expanded="@open"
                    @onclick="() => ToggleGroup(node.Key)">
                <i class="bi @(node.Icon ?? "bi-folder2") portal-nav-icon" aria-hidden="true"></i>
                <span class="portal-nav-link-label">@node.Title</span>
                @Badge(node)
                <i class="bi bi-chevron-down portal-nav-caret transform transition-transform @(open ? "rotate-180" : string.Empty)" aria-hidden="true"></i>
            </button>
            @if (open)
            {
                <div class="portal-nav-submenu">
                    @foreach (var child in node.Children)
                    {
                        if (IsFolder(child))
                        {
                            @GroupItem(child, "portal-nav-sublink")
                            continue;
                        }

                        @LeafLink(child, "portal-nav-sublink")
                    }
                </div>
            }
        </div>
    };

    /// <summary>Abrir uma categoria fecha as outras (o menu cabe na tela); submenus dentro dela são independentes.</summary>
    private void ToggleGroup(string key)
    {
        if (_openGroups.Remove(key))
        {
            return;
        }

        if (_menu.Any(node => IsCategory(node) && node.Key.Equals(key, StringComparison.OrdinalIgnoreCase)))
        {
            CloseOtherCategories(key);
        }

        _openGroups.Add(key);
    }

    private void CloseOtherCategories(string keepKey)
    {
        foreach (var category in _menu.Where(IsCategory).Where(node => !node.Key.Equals(keepKey, StringComparison.OrdinalIgnoreCase)))
        {
            _openGroups.Remove(category.Key);
        }
    }

    private async Task NotifyNavigate()
    {
        try
        {
            await Js.InvokeVoidAsync("ofertioAppInterop.closeSidebar");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private bool IsGroupActive(ClientMenuNodeDto group) =>
        group.Children.Any(child => IsRouteActive(child.Route) || IsGroupActive(child));

    private string CurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return string.IsNullOrEmpty(relative) ? "/" : "/" + relative.Split('?', '#')[0];
    }

    private bool IsRouteActive(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return false;
        }

        var current = CurrentPath();
        return current.Equals(route, StringComparison.OrdinalIgnoreCase)
            || (RouteAliases.TryGetValue(route, out var aliases)
                && aliases.Any(alias => current.Equals(alias, StringComparison.OrdinalIgnoreCase)));
    }

    private string GetActiveClass(string? route) => IsRouteActive(route) ? "active" : string.Empty;
}
