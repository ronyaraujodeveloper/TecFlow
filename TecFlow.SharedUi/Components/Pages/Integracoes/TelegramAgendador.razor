@page "/integracoes/telegram/agendador"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TecFlow.Business.Dto
@using TecFlow.Core.Entities
@using TecFlow.SharedUi.Components.Integrations
@using TecFlow.SharedUi.Services.Integrations
@inject ITelegramIntegrationApiService TelegramApi
@inject IJSRuntime Js
@inject ILogger<TelegramAgendador> Logger

<PageTitle>Agendador Telegram — TecFlow</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <h1 class="h3 m-0 fw-bold">Disparo para grupos</h1>
                <span class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 text-white" style="background-color: #0088cc;">
                    <i class="bi bi-telegram" aria-hidden="true"></i>
                    <span>Telegram</span>
                </span>
            </div>
            <p class="text-muted small mb-0">
                Sincronize os canais, escolha os destinos e agende a oferta com intervalo anti-bloqueio.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/integracoes/conexoes?telegram=1" class="btn btn-outline-secondary btn-touch">Conexão</a>
            <button type="button" class="btn btn-primary btn-touch" disabled="@_isBusy" @onclick="SincronizarCanaisTelegramAsync">
                @(_isBusy ? "Sincronizando..." : "Sincronizar Meus Canais do Telegram")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small" role="alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_info))
    {
        <div class="alert alert-success py-2 small" role="status">@_info</div>
    }

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">Nova campanha</h2>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="tg-title">Título</label>
                <input id="tg-title" class="form-control" value="@_title" @oninput="e => _title = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mb-3">
                <CommissionLinkPicker @ref="_linkPicker" OnLinkSelected="InsertCommissionLinkAsync" />
                <label class="form-label fw-semibold" for="tg-message">Mensagem</label>
                <textarea id="tg-message"
                          class="form-control"
                          rows="4"
                          placeholder="Escreva a oferta e insira um link de comissão pela busca acima."
                          @oninput="e => _message = e.Value?.ToString() ?? string.Empty">@_message</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="tg-image">URL da imagem (opcional)</label>
                <input id="tg-image" class="form-control" value="@_imageUrl" @oninput="e => _imageUrl = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="tg-when">Data e hora</label>
                    <input id="tg-when" type="datetime-local" class="form-control" value="@_scheduledLocal" @oninput="e => _scheduledLocal = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="tg-interval">Intervalo entre canais</label>
                    <select id="tg-interval" class="form-select" value="@_intervalSeconds" @onchange="OnIntervalChanged">
                        <option value="15">15 segundos</option>
                        <option value="30">30 segundos</option>
                        <option value="45">45 segundos</option>
                        <option value="60">60 segundos</option>
                    </select>
                </div>
            </div>

            @if (_pickerGroups.Count == 0)
            {
                <p class="text-muted small">Nenhum canal sincronizado. Conecte o Telegram e clique em sincronizar.</p>
            }
            else
            {
                <WhatsAppGroupPicker @key="_pickerEpoch"
                                     Title="Canais e grupos"
                                     SearchPlaceholder="Busque e selecione os canais..."
                                     CountLabel="canal(is) selecionado(s)"
                                     AdminOnlyLabel="Exibir apenas canais em que o bot é Admin"
                                     Groups="_pickerGroups"
                                     Campaigns="_pickerCampaigns"
                                     SelectedJids="_selectedChatIds" />
            }

            <button type="button" class="btn btn-success" disabled="@_isBusy" @onclick="ScheduleAsync">
                Agendar publicação
            </button>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Status</th>
                            <th>Agendado</th>
                            <th>Canais</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_campaigns.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted small px-3 py-3">Nenhuma campanha ainda.</td>
                            </tr>
                        }
                        @foreach (var item in _campaigns)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td><span class="badge @StatusClass(item.Status)">@item.UiStatusLabel</span></td>
                                <td class="small">@item.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small">
                                    @item.TargetChatIds.Count @(item.TargetChatIds.Count == 1 ? "canal" : "canais")
                                    @if (item.TargetChatNames.Count > 0)
                                    {
                                        <span class="text-muted">— @string.Join(", ", item.TargetChatNames.Take(3))</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly List<TelegramBroadcastCampaignDto> _campaigns = [];
    private readonly List<WhatsAppGroupDto> _pickerGroups = [];
    private readonly List<WhatsAppBroadcastCampaignDto> _pickerCampaigns = [];
    private readonly HashSet<string> _selectedChatIds = new(StringComparer.OrdinalIgnoreCase);
    private CommissionLinkPicker? _linkPicker;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private string _imageUrl = string.Empty;
    private string _scheduledLocal = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
    private int _intervalSeconds = TelegramBroadcastStatuses.DefaultIntervalSeconds;
    private int _pickerEpoch;
    private bool _isBusy;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void ApplyPayload(TelegramBroadcastResponseDto? data)
    {
        _campaigns.Clear();
        _campaigns.AddRange(data?.Campaigns ?? []);
        _pickerGroups.Clear();
        _pickerGroups.AddRange((data?.Groups ?? []).Select(item => new WhatsAppGroupDto
        {
            Id = item.Id,
            Jid = item.ChatId,
            Name = item.Name,
            ParticipantCount = item.ParticipantCount,
            IsAdmin = item.IsAdmin,
            IsActive = item.IsActive
        }));
        _pickerCampaigns.Clear();
        _pickerCampaigns.AddRange(_campaigns.Select(item => new WhatsAppBroadcastCampaignDto
        {
            Id = item.Id,
            Title = item.Title,
            TargetGroupJids = item.TargetChatIds
        }));
        _pickerEpoch++;
    }

    private async Task LoadAsync()
    {
        var response = await TelegramApi.ListCampaignsAsync();
        ApplyPayload(response.Data);
        if (!string.IsNullOrWhiteSpace(response.Data?.DefaultChatId)
            && _selectedChatIds.Count == 0)
        {
            _selectedChatIds.Add(response.Data.DefaultChatId);
        }
    }

    private async Task SincronizarCanaisTelegramAsync()
    {
        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            var response = await TelegramApi.SyncChannelsAsync();
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível sincronizar os canais.";
                return;
            }

            ApplyPayload(response.Data);
            _info = response.Data.Descricao;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao sincronizar canais do Telegram.");
            _error = "Não foi possível sincronizar os canais do Telegram.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            _intervalSeconds = seconds;
        }
    }

    private async Task ScheduleAsync()
    {
        _error = null;
        _info = null;
        _isBusy = true;
        try
        {
            DateTime? when = null;
            if (DateTime.TryParse(_scheduledLocal, out var parsed))
            {
                when = DateTime.SpecifyKind(parsed, DateTimeKind.Local);
            }

            var response = await TelegramApi.ScheduleCampaignAsync(new TelegramScheduleCampaignDto
            {
                Title = _title,
                MessageText = _message,
                ImageUrl = _imageUrl,
                TargetChatIds = _selectedChatIds.ToList(),
                ScheduledAt = when,
                IntervalSeconds = _intervalSeconds
            });
            if (!response.Success || response.Data is null || !response.Data.Status)
            {
                _error = response.Data?.Descricao ?? response.ErrorMessage ?? "Não foi possível agendar.";
                return;
            }

            _info = response.Data.Descricao ?? "Publicação agendada com sucesso.";
            ApplyPayload(response.Data);
            await ResetFormAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task InsertCommissionLinkAsync(string url)
    {
        try
        {
            var next = await Js.InvokeAsync<string>("tecFlowAppInterop.insertAtCursor", "tg-message", url);
            _message = string.IsNullOrWhiteSpace(next) ? AppendLink(_message, url) : next;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Falha ao inserir link na posição do cursor; anexando ao final.");
            _message = AppendLink(_message, url);
        }
    }

    private async Task ResetFormAsync()
    {
        _title = string.Empty;
        _message = string.Empty;
        _imageUrl = string.Empty;
        _scheduledLocal = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
        _intervalSeconds = TelegramBroadcastStatuses.DefaultIntervalSeconds;
        if (_linkPicker is not null)
        {
            await _linkPicker.ResetAsync();
        }
    }

    private static string AppendLink(string message, string url)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return url;
        }

        return message.TrimEnd() + " " + url;
    }

    private static string StatusClass(string status) =>
        status switch
        {
            TelegramBroadcastStatuses.Completed => "text-bg-success",
            TelegramBroadcastStatuses.Failed => "text-bg-danger",
            TelegramBroadcastStatuses.Processing => "text-bg-warning",
            _ => "text-bg-secondary"
        };
}
