@page "/p/{Slug}"
@layout Layout.PublicLayout
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ofertio.Business.Dto
@using Ofertio.Business.Service.PublicPages
@using Ofertio.Core.Enums
@using Ofertio.SharedUi.Helpers
@using Ofertio.SharedUi.Services.LinkGenerator
@using Ofertio.Util.Text
@inject IPublicConverterApiService PublicPages
@inject IJSRuntime Js
@inject NavigationManager NavigationManager
@inject ILogger<PublicConverter> Logger

<PageTitle>@(_page?.DisplayName is { Length: > 0 } name ? $"{name} — Conversor de links" : "Conversor de links")</PageTitle>

@if (_notFound)
{
    <div class="alert alert-warning pc-card" role="alert">
        Página pública não encontrada.
    </div>
}
else if (_page is null)
{
    <p class="text-muted text-center">Carregando…</p>
}
else
{
    <section class="pc-card" aria-labelledby="pc-title">
        <header class="pc-header">
            <span class="affiliate-avatar" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(_page.AvatarUrl))
                {
                    <img src="@_page.AvatarUrl" alt="" loading="lazy" />
                }
                else
                {
                    <span class="affiliate-avatar-initial">@Initial</span>
                }
            </span>
            <div class="min-w-0">
                <h1 id="pc-title" class="pc-title">@AffiliateName</h1>
                <p class="pc-lead">Cole o link do produto e receba o link direto da loja.</p>
            </div>
        </header>

        <label class="pc-label" for="public-product-url">Link do produto</label>
        <input id="public-product-url"
               class="form-control form-control-lg pc-input @(_storeWarning is null ? string.Empty : "is-invalid")"
               placeholder="@InputPlaceholder"
               inputmode="url"
               autocomplete="off"
               value="@_productUrl"
               disabled="@_isConverting"
               aria-describedby="pc-stores"
               aria-invalid="@(_storeWarning is null ? "false" : "true")"
               @oninput="OnUrlInput"
               @onkeydown="OnKeyDownAsync" />

        @if (_storeWarning is not null)
        {
            <div class="pc-store-warning" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@_storeWarning</span>
            </div>
        }
        @if (Stores.Count > 0)
        {
            <div id="pc-stores" class="pc-stores">
                @if (_storeWarning is null)
                {
                    <span class="pc-stores-label"><i class="bi bi-check-circle text-success" aria-hidden="true"></i>Aceita links de:</span>
                }
                else
                {
                    <span class="visually-hidden">Lojas aceitas:</span>
                }
                @foreach (var store in Stores)
                {
                    <span class="pc-store pc-store--@store.CssKey">
                        <span class="pc-store-dot" aria-hidden="true">@store.Initial</span>@store.Name
                    </span>
                }
            </div>
        }

        <div class="pc-actions">
            <button type="button"
                    class="btn btn-primary btn-lg pc-convert"
                    disabled="@(_isConverting || string.IsNullOrWhiteSpace(_productUrl) || _storeWarning is not null)"
                    @onclick="ConvertAsync">
                @(_isConverting ? "Convertendo..." : "Converter link")
            </button>
            @if (!string.IsNullOrWhiteSpace(_productUrl) || _result is not null)
            {
                <button type="button" class="btn btn-link pc-clear" disabled="@_isConverting" @onclick="ClearForm">Limpar</button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger py-2 small mt-3 mb-0" role="alert">@_error</div>
        }

        @if (_result is { HasConvertedLink: true })
        {
            <div class="pc-result" role="region" aria-label="Link convertido" aria-live="polite">
                <p class="pc-result-title"><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Link pronto</p>
                @if (!string.IsNullOrWhiteSpace(_result.ProductName))
                {
                    <p class="pc-result-product">@_result.ProductName</p>
                }
                <div class="pc-result-buttons">
                    <a class="btn btn-primary btn-lg"
                       href="@OfertioTrackingUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Abrir na loja
                    </a>
                    <button type="button"
                            class="btn btn-lg @(_copiedTrack ? "btn-success" : "btn-outline-secondary")"
                            disabled="@(_isCopying || string.IsNullOrWhiteSpace(OfertioTrackingUrl))"
                            @onclick="() => CopyAsync(OfertioTrackingUrl)">
                        <i class="bi @(_copiedTrack ? "bi-clipboard-check" : "bi-clipboard") me-1" aria-hidden="true"></i>@(_copiedTrack ? "Copiado" : "Copiar link")
                    </button>
                </div>
            </div>

            @if (_page.JoinButtons.Count > 0)
            {
                <div class="pc-join" role="region" aria-label="Entrar nos grupos">
                    <p class="pc-join-title">Quer receber ofertas assim todo dia?</p>
                    <p class="pc-join-lead">Entre no grupo: o convite abre direto no aplicativo.</p>
                    <div class="pc-join-list">
                        @foreach (var button in _page.JoinButtons)
                        {
                            var channel = JoinLinkRules.FindChannel(button.Channel);
                            <a class="pc-join-button"
                               href="/j/@button.Id"
                               target="_blank"
                               rel="noopener noreferrer">
                                <span class="pc-join-icon @(channel?.CssClass)" aria-hidden="true"><i class="bi @(channel?.Icon ?? "bi-people-fill")"></i></span>
                                <span class="pc-join-text">
                                    <span class="pc-join-name">@button.Label</span>
                                    <span class="pc-join-meta">@channel?.Label@(string.IsNullOrWhiteSpace(button.MemberText) ? string.Empty : " · " + button.MemberText)</span>
                                </span>
                                <span class="pc-join-cta">Entrar</span>
                            </a>
                        }
                    </div>
                </div>
            }
        }

        <p class="pc-disclosure">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Este é um link de afiliado: o preço para você é o mesmo e uma pequena comissão vai para @AffiliateName.
        </p>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private PublicConverterPageDto? _page;
    private bool _notFound;
    private bool _isConverting;
    private bool _isCopying;
    private bool _copiedTrack;
    private string _productUrl = string.Empty;
    private string? _error;
    private string? _storeWarning;
    private GerarLinkAfiliadoResponseDto? _result;

    private sealed record StoreChip(MarketplaceType Platform, string Name, string Initial, string CssKey);

    private string AffiliateName => PublicConverterStoreMessages.AffiliateName(_page?.DisplayName);

    private string Initial => string.IsNullOrWhiteSpace(_page?.DisplayName) ? "?" : char.ToUpperInvariant(_page!.DisplayName!.Trim()[0]).ToString();

    private IReadOnlyList<MarketplaceType> AcceptedPlatforms =>
        (_page?.ConnectedPlatforms ?? []).Distinct().ToList();

    private IReadOnlyList<StoreChip> Stores =>
        AcceptedPlatforms.Select(ToChip).ToList();

    private string InputPlaceholder
    {
        get
        {
            var platforms = AcceptedPlatforms;
            return platforms.Count switch
            {
                0 => "Cole aqui o link do produto",
                1 => $"Cole aqui o link {PublicConverterStoreMessages.StoreReference(platforms[0])}",
                2 => $"Cole aqui o link {PublicConverterStoreMessages.StoreReference(platforms[0])} ou {PublicConverterStoreMessages.StoreReference(platforms[1])}",
                _ => $"Cole aqui o link {PublicConverterStoreMessages.StoreReference(platforms[0])}, {platforms[1].GetDisplayName()}…"
            };
        }
    }

    private static StoreChip ToChip(MarketplaceType platform)
    {
        var name = platform.GetDisplayName();
        var cssClass = MarketplaceUrlDetector.All.FirstOrDefault(item => item.IntegrationType == platform)?.CssClass;
        var cssKey = cssClass is null ? "default" : cssClass.Replace("marketplace-chip--", string.Empty, StringComparison.Ordinal);
        var initial = platform == MarketplaceType.Amazon ? "a" : char.ToUpperInvariant(name[0]).ToString();
        return new StoreChip(platform, name, initial, cssKey);
    }

    private string? CheckStore(bool whileTyping) =>
        PublicConverterInputCheck.NotServedMessage(_productUrl, AcceptedPlatforms, _page?.DisplayName, whileTyping);

    private void OnUrlInput(ChangeEventArgs args)
    {
        _productUrl = args.Value?.ToString() ?? string.Empty;
        _storeWarning = CheckStore(whileTyping: true);
    }

    private string OfertioTrackingUrl => ShortLinkPublicUrl.RebaseToCurrentHost(_result?.ResolvedShortUrl, GetBaseUrl());

    private string GetBaseUrl()
    {
        return NavigationManager.BaseUri.TrimEnd('/');
    }

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        ClearResults();
        var response = await PublicPages.GetBySlugAsync(Slug);
        if (!response.Success || response.Data?.Data is null)
        {
            _notFound = true;
            _page = null;
            return;
        }

        _page = response.Data.Data;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_isConverting && !string.IsNullOrWhiteSpace(_productUrl))
        {
            await ConvertAsync();
        }
    }

    private void ClearForm()
    {
        _productUrl = string.Empty;
        _storeWarning = null;
        ClearResults();
    }

    private void ClearResults()
    {
        _error = null;
        _result = null;
        _copiedTrack = false;
    }

    private async Task ConvertAsync()
    {
        _error = null;
        _result = null;
        _copiedTrack = false;
        _storeWarning = CheckStore(whileTyping: false);
        if (_storeWarning is not null)
        {
            return;
        }

        _isConverting = true;
        try
        {
            var response = await PublicPages.ConvertAsync(Slug, _productUrl);
            if (!response.Success || response.Data is null || !response.Data.Success)
            {
                _error = response.Data?.Message
                    ?? response.ErrorMessage
                    ?? "Não foi possível converter o link.";
                return;
            }

            _result = response.Data;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha na conversão pública. Slug={Slug}", Slug);
            _error = "Não foi possível converter o link.";
        }
        finally
        {
            _isConverting = false;
        }
    }

    private async Task CopyAsync(string url)
    {
        if (string.IsNullOrWhiteSpace(url) || _isCopying)
        {
            return;
        }

        _isCopying = true;
        try
        {
            var copied = await Js.InvokeAsync<bool>("ofertioAppInterop.copyToClipboard", url);
            if (copied)
            {
                _copiedTrack = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao copiar URL pública.");
        }
        finally
        {
            _isCopying = false;
        }
    }
}
