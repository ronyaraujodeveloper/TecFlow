@using Ofertio.Business.Service.Common
@inject NavigationManager Navigation

@code {
    /// <summary>Manda para o login levando a tela atual, para voltar a ela depois de entrar.</summary>
    protected override void OnInitialized()
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(LoginReturnUrlRules.BuildLoginPath(current), replace: true);
    }
}