@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IDisposable

@code {
    private string _lastPath = string.Empty;

    protected override void OnInitialized()
    {
        _lastPath = CurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var path = CurrentPath();
        var samePage = string.Equals(path, _lastPath, StringComparison.OrdinalIgnoreCase);
        _lastPath = path;
        if (samePage || args.Location.Contains('#'))
        {
            return;
        }

        _ = InvokeAsync(ResetScrollAsync);
    }

    private async Task ResetScrollAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("tecFlowAppInterop.resetScroll");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private string CurrentPath() => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
}
